<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Hotel El Colibrí</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
        string Activo(string nombre) => string.Equals(controlador, nombre, StringComparison.OrdinalIgnoreCase) ? "active" : "";
        bool TieneRol(string roles) => roles.Split(',').Any(User.IsInRole);
        var nombreUsuario = User.FindFirst(Reclamos.NombreCompleto)?.Value ?? User.Identity?.Name ?? "Usuario";
        var rolUsuario = Roles.Todos.FirstOrDefault(User.IsInRole);

        var iniciales = string.Concat(nombreUsuario
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(parte => char.ToUpper(parte[0])));
    }

    <div class="app">
        <aside class="offcanvas-lg offcanvas-start sidebar" tabindex="-1" id="menuLateral" aria-labelledby="menuLateralTitulo">
            <div class="sidebar-marca">
                <a asp-controller="Home" asp-action="Index" class="sidebar-logo" id="menuLateralTitulo">
                    <span class="sidebar-logo-imagen">
                        <img src="~/img/logo-colibri.png" alt="Cabinas El Colibrí" />
                    </span>
                    <small>Gestión hotelera</small>
                </a>
                <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#menuLateral" aria-label="Cerrar"></button>
            </div>

            <nav class="sidebar-nav">
                <a class="sidebar-link @Activo("Home")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i> Inicio
                </a>

                @if (TieneRol(Roles.AccesoHospedaje))
                {
                    <div class="sidebar-seccion">Hospedaje</div>
                    <a class="sidebar-link @Activo("Habitacion")" asp-controller="Habitacion" asp-action="Index">
                        <i class="bi bi-door-closed"></i> Habitaciones
                    </a>

                    <a class="sidebar-link @Activo("Reserva")" asp-controller="Reserva" asp-action="Index">
                        <i class="bi bi-calendar-check"></i> Reservas
                    </a>

                    <a class="sidebar-link @Activo("Evento")" asp-controller="Evento" asp-action="Index">
                        <i class="bi bi-calendar-event"></i> Eventos
                    </a>

                    <div class="sidebar-seccion">Clientes</div>
                    <a class="sidebar-link @Activo("Cliente")" asp-controller="Cliente" asp-action="Index">
                        <i class="bi bi-people"></i> Clientes
                    </a>
                }

                @if (TieneRol(Roles.AccesoMenu) || TieneRol(Roles.AccesoInventario))
                {
                    <div class="sidebar-seccion">Restaurante</div>
                }

                @if (TieneRol(Roles.AccesoMesas))
                {
                    <a class="sidebar-link @Activo("Mesa")" asp-controller="Mesa" asp-action="Index">
                        <i class="bi bi-grid-3x3-gap"></i> Mesas
                    </a>
                }

                @if (TieneRol(Roles.AccesoMenu))
                {
                    <a class="sidebar-link @Activo("Menu")" asp-controller="Menu" asp-action="Index">
                        <i class="bi bi-journal-richtext"></i> Menú
                    </a>

                    <a class="sidebar-link @(Activo("Pedido") + Activo("Salon"))" asp-controller="Salon" asp-action="Index">
                        <i class="bi bi-receipt"></i> Pedidos
                    </a>
                }

                @if (TieneRol(Roles.AccesoInventario))
                {
                    <a class="sidebar-link @Activo("Inventario")" asp-controller="Inventario" asp-action="Index">
                        <i class="bi bi-box-seam"></i> Inventario
                    </a>
                }

                @if (TieneRol(Roles.AccesoHousekeeping))
                {
                    <div class="sidebar-seccion">Housekeeping</div>
                    <a class="sidebar-link @Activo("Housekeeping")" asp-controller="Housekeeping" asp-action="Index">
                        <i class="bi bi-stars"></i> Tareas de limpieza
                    </a>
                }

                @if (TieneRol(Roles.AccesoFacturacion))
                {
                    <div class="sidebar-seccion">Facturación</div>
                    <a class="sidebar-link @Activo("Factura")" asp-controller="Factura" asp-action="Index">
                        <i class="bi bi-receipt"></i> Facturas y pagos
                    </a>
                }

                @if (User.IsInRole(Roles.Administrador))
                {
                    <div class="sidebar-seccion">Administración</div>
                    <a class="sidebar-link @Activo("Usuario")" asp-controller="Usuario" asp-action="Index">
                        <i class="bi bi-person-gear"></i> Usuarios
                    </a>
                }
            </nav>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="sidebar-usuario">
                    <div class="sidebar-usuario-acciones">
                        <a class="sidebar-link" asp-controller="Cuenta" asp-action="CambiarContrasena">
                            <i class="bi bi-key"></i> Cambiar contraseña
                        </a>
                        <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                            <button type="submit" class="sidebar-link w-100 border-0 bg-transparent text-start">
                                <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                            </button>
                        </form>
                    </div>
                </div>
            }
        </aside>

        <div class="contenido">
            <header class="barra-superior">
                <button class="btn btn-icono d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuLateral" aria-controls="menuLateral" aria-label="Abrir menú">
                    <i class="bi bi-list"></i>
                </button>

                <nav aria-label="Ruta" class="migas">
                    <a asp-controller="Home" asp-action="Index">Inicio</a>
                    @if (ViewData["Title"] as string != "Inicio")
                    {
                        <i class="bi bi-chevron-right"></i>
                        <span>@ViewData["Title"]</span>
                    }
                </nav>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown ms-auto">
                        <button class="barra-usuario" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar">@iniciales</span>
                            <span class="d-none d-sm-block text-start">
                                <span class="barra-usuario-nombre">@nombreUsuario</span>
                                <span class="barra-usuario-rol">@rolUsuario</span>
                            </span>
                            <i class="bi bi-chevron-down small text-secondary"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" asp-controller="Cuenta" asp-action="CambiarContrasena">
                                    <i class="bi bi-key me-2"></i> Cambiar contraseña
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i> Cerrar sesión
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
            </header>

            <main class="pagina" role="main">
                <partial name="_Mensajes" />
                @RenderBody()
            </main>

            <footer class="pie">
                &copy; @DateTime.Now.Year Hotel El Colibrí · SC-603
            </footer>
        </div>
    </div>

    <partial name="_ModalConfirmacion" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
