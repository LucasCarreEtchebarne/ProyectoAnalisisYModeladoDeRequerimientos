<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Hotel El Colibrí</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
        string Activo(string nombre) => string.Equals(controlador, nombre, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    <div class="app">
        <aside class="offcanvas-lg offcanvas-start sidebar" tabindex="-1" id="menuLateral" aria-labelledby="menuLateralTitulo">
            <div class="sidebar-marca">
                <a asp-controller="Home" asp-action="Index" class="sidebar-logo" id="menuLateralTitulo">
                    <i class="bi bi-feather"></i>
                    <span>El Colibrí<small>Gestión hotelera</small></span>
                </a>
                <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#menuLateral" aria-label="Cerrar"></button>
            </div>

            <nav class="sidebar-nav">
                <a class="sidebar-link @Activo("Home")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i> Inicio
                </a>

                <div class="sidebar-seccion">Hospedaje</div>
                <span class="sidebar-link disabled">
                    <i class="bi bi-door-closed"></i> Habitaciones
                    <span class="badge-pendiente">Pendiente</span>
                </span>

                <div class="sidebar-seccion">Clientes</div>
                <span class="sidebar-link disabled">
                    <i class="bi bi-people"></i> Clientes
                    <span class="badge-pendiente">Pendiente</span>
                </span>

                <div class="sidebar-seccion">Restaurante</div>
                <span class="sidebar-link disabled">
                    <i class="bi bi-box-seam"></i> Inventario
                    <span class="badge-pendiente">Pendiente</span>
                </span>
            </nav>
        </aside>

        <div class="contenido">
            <header class="barra-superior">
                <button class="btn btn-icono d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuLateral" aria-controls="menuLateral" aria-label="Abrir menú">
                    <i class="bi bi-list"></i>
                </button>
                <span class="barra-titulo">@ViewData["Title"]</span>
            </header>

            <main class="pagina" role="main">
                <partial name="_Mensajes" />
                @RenderBody()
            </main>

            <footer class="pie">
                &copy; @DateTime.Now.Year Hotel El Colibrí · SC-603
            </footer>
        </div>
    </div>

    <partial name="_ModalConfirmacion" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
