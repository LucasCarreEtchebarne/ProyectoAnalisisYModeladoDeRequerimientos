<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Hotel El Colibrí</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
        string Activo(string nombre) => string.Equals(controlador, nombre, StringComparison.OrdinalIgnoreCase) ? "active" : "";
        bool TieneRol(string roles) => roles.Split(',').Any(User.IsInRole);
        var nombreUsuario = User.FindFirst(Reclamos.NombreCompleto)?.Value ?? User.Identity?.Name;
        var rolUsuario = Roles.Todos.FirstOrDefault(User.IsInRole);
    }

    <div class="app">
        <aside class="offcanvas-lg offcanvas-start sidebar" tabindex="-1" id="menuLateral" aria-labelledby="menuLateralTitulo">
            <div class="sidebar-marca">
                <a asp-controller="Home" asp-action="Index" class="sidebar-logo" id="menuLateralTitulo">
                    <i class="bi bi-feather"></i>
                    <span>El Colibrí<small>Gestión hotelera</small></span>
                </a>
                <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#menuLateral" aria-label="Cerrar"></button>
            </div>

            <nav class="sidebar-nav">
                <a class="sidebar-link @Activo("Home")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i> Inicio
                </a>

                @if (TieneRol(Roles.AccesoHospedaje))
                {
                    <div class="sidebar-seccion">Hospedaje</div>
                    <a class="sidebar-link @Activo("Habitacion")" asp-controller="Habitacion" asp-action="Index">
                        <i class="bi bi-door-closed"></i> Habitaciones
                    </a>

                    <a class="sidebar-link @Activo("Reserva")" asp-controller="Reserva" asp-action="Index">
                        <i class="bi bi-calendar-check"></i> Reservas
                    </a>

                    <a class="sidebar-link @Activo("Evento")" asp-controller="Evento" asp-action="Index">
                        <i class="bi bi-calendar-event"></i> Eventos
                    </a>

                    <div class="sidebar-seccion">Clientes</div>
                    <a class="sidebar-link @Activo("Cliente")" asp-controller="Cliente" asp-action="Index">
                        <i class="bi bi-people"></i> Clientes
                    </a>
                }

                @if (TieneRol(Roles.AccesoInventario))
                {
                    <div class="sidebar-seccion">Restaurante</div>
                    <a class="sidebar-link @Activo("Inventario")" asp-controller="Inventario" asp-action="Index">
                        <i class="bi bi-box-seam"></i> Inventario
                    </a>
                }

                @if (User.IsInRole(Roles.Administrador))
                {
                    <div class="sidebar-seccion">Administración</div>
                    <a class="sidebar-link @Activo("Usuario")" asp-controller="Usuario" asp-action="Index">
                        <i class="bi bi-person-gear"></i> Usuarios
                    </a>
                }
            </nav>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="sidebar-usuario">
                    <div class="sidebar-usuario-datos">
                        <i class="bi bi-person-circle"></i>
                        <div>
                            <div class="sidebar-usuario-nombre">@nombreUsuario</div>
                            <div class="sidebar-usuario-rol">@rolUsuario</div>
                        </div>
                    </div>
                    <div class="sidebar-usuario-acciones">
                        <a class="sidebar-link" asp-controller="Cuenta" asp-action="CambiarContrasena">
                            <i class="bi bi-key"></i> Cambiar contraseña
                        </a>
                        <form asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                            <button type="submit" class="sidebar-link w-100 border-0 bg-transparent text-start">
                                <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                            </button>
                        </form>
                    </div>
                </div>
            }
        </aside>

        <div class="contenido">
            <header class="barra-superior d-lg-none">
                <button class="btn btn-icono" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuLateral" aria-controls="menuLateral" aria-label="Abrir menú">
                    <i class="bi bi-list"></i>
                </button>
                <span class="barra-titulo">El Colibrí</span>
            </header>

            <main class="pagina" role="main">
                <partial name="_Mensajes" />
                @RenderBody()
            </main>

            <footer class="pie">
                &copy; @DateTime.Now.Year Hotel El Colibrí · SC-603
            </footer>
        </div>
    </div>

    <partial name="_ModalConfirmacion" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>