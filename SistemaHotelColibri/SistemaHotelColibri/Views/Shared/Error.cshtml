@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="tarjeta tarjeta-cuerpo text-center py-5">
    <i class="bi bi-exclamation-octagon text-danger" style="font-size: 2.2rem;"></i>
    <h1 class="h4 mt-3">Ocurrió un error al procesar la solicitud.</h1>
    <p class="text-secondary mb-0">Intente de nuevo. Si el problema continúa, contacte al administrador del sistema.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-secondary mt-3 mb-0">Código de la solicitud: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-outline-primary mt-4" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>
