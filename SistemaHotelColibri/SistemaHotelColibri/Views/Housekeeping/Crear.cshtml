@using SistemaHotelColibri.ViewModels.TareasHousekeeping
@model TareaFormViewModel
@{
    ViewData["Title"] = "Nueva tarea de housekeeping";
}

<div class="encabezado-pagina">
    <div>
        <h1>Nueva tarea de housekeeping</h1>
        <p>El identificador de la tarea se genera automáticamente al guardar. La tarea inicia en estado Pendiente.</p>
    </div>
</div>

<form asp-action="Crear" method="post" class="tarjeta tarjeta-cuerpo">
    <partial name="_Formulario" model="Model" />
    <div class="d-flex gap-2 justify-content-end mt-4">
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}