@using SistemaHotelColibri.ViewModels.TareasHousekeeping
@model TareaFormViewModel
@{
    ViewData["Title"] = "Editar tarea de housekeeping";
}

<div class="encabezado-pagina">
    <div>
        <h1>Editar tarea #@Model.IdTarea</h1>
        <p>Modifique los datos necesarios. El estado se cambia desde el detalle de la tarea.</p>
    </div>
</div>

<form asp-action="Editar" asp-route-id="@Model.IdTarea" method="post" class="tarjeta tarjeta-cuerpo">
    <partial name="_Formulario" model="Model" />
    <div class="d-flex gap-2 justify-content-end mt-4">
        <a class="btn btn-outline-secondary" asp-action="Detalle" asp-route-id="@Model.IdTarea">Cancelar</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar cambios</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}