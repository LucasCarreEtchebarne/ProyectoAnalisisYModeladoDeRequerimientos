@using SistemaHotelColibri.Abstract.Modelos.Reservas
@using SistemaHotelColibri.ViewModels.Reservas
@model ReservaFormViewModel
@{
    var opciones = (OpcionesReservaDto)ViewBag.Opciones;
    var estados = (string[])ViewBag.EstadosReserva;
    var hoy = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
}

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

@if (Model.IdReserva == 0)
{
    <input type="hidden" asp-for="GuardarCliente" id="GuardarCliente" />
    <div class="selector-cliente mb-3" role="radiogroup" aria-label="Cliente de la reserva">
        <label class="metodo-pago">
            <input type="radio" name="ClienteNuevo" value="false" checked="@(!Model.ClienteNuevo)" />
            <span><i class="bi bi-person-check"></i> Cliente registrado</span>
        </label>
        <label class="metodo-pago">
            <input type="radio" name="ClienteNuevo" value="true" checked="@Model.ClienteNuevo" />
            <span><i class="bi bi-person-plus"></i> Cliente nuevo</span>
        </label>
    </div>

    <div class="tarjeta tarjeta-cuerpo bloque-cliente-nuevo mb-3" id="BloqueClienteNuevo">
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <label asp-for="ClienteIdentificacion" class="form-label">Identificación *</label>
                <input asp-for="ClienteIdentificacion" class="form-control" maxlength="30" placeholder="Cédula o pasaporte" />
                <span asp-validation-for="ClienteIdentificacion" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-4">
                <label asp-for="ClienteNombre" class="form-label">Nombre *</label>
                <input asp-for="ClienteNombre" class="form-control" maxlength="100" />
                <span asp-validation-for="ClienteNombre" class="text-danger"></span>
            </div>
            <div class="col-6 col-md-2">
                <label asp-for="ClientePrimerApellido" class="form-label">Primer apellido *</label>
                <input asp-for="ClientePrimerApellido" class="form-control" maxlength="50" />
                <span asp-validation-for="ClientePrimerApellido" class="text-danger"></span>
            </div>
            <div class="col-6 col-md-2">
                <label asp-for="ClienteSegundoApellido" class="form-label">Segundo apellido</label>
                <input asp-for="ClienteSegundoApellido" class="form-control" maxlength="50" />
                <span asp-validation-for="ClienteSegundoApellido" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="ClienteTelefono" class="form-label">Teléfono</label>
                <input asp-for="ClienteTelefono" class="form-control" maxlength="20" placeholder="8888-8888" />
                <span asp-validation-for="ClienteTelefono" class="text-danger"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="ClienteCorreo" class="form-label">Correo electrónico</label>
                <input asp-for="ClienteCorreo" class="form-control" type="email" maxlength="150" />
                <span asp-validation-for="ClienteCorreo" class="text-danger"></span>
            </div>
        </div>
    </div>
}

<div class="row g-3">
    <div class="col-12 col-md-6" id="BloqueClienteRegistrado">
        <label asp-for="IdCliente" class="form-label">Cliente *</label>
        <select asp-for="IdCliente" class="form-select">
            <option value="">Seleccione un cliente</option>
            @foreach (var c in opciones.Clientes)
            {
                <option value="@c.IdCliente" selected="@(Model.IdCliente == c.IdCliente)">@c.Texto</option>
            }
        </select>
        <span asp-validation-for="IdCliente" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="IdHabitacion" class="form-label">Habitación *</label>
        <select asp-for="IdHabitacion" class="form-select" id="IdHabitacion">
            <option value="">Seleccione una habitación</option>
            @foreach (var h in opciones.Habitaciones)
            {
                var ocupado = System.Text.Json.JsonSerializer.Serialize(h.Ocupado
                    .Where(r => r.IdReserva != Model.IdReserva)
                    .Select(r => new { e = r.FechaEntrada.ToString("yyyy-MM-dd"), s = r.FechaSalida.ToString("yyyy-MM-dd"), c = r.Cliente }));
                <option value="@h.IdHabitacion" data-precio="@h.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-capacidad="@h.Capacidad" data-ocupado="@ocupado" selected="@(Model.IdHabitacion == h.IdHabitacion)">@h.Texto</option>
            }
        </select>
        <span asp-validation-for="IdHabitacion" class="text-danger"></span>
        <div id="FechasOcupadas" class="fechas-ocupadas d-none"></div>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="FechaEntrada" class="form-label">Fecha de entrada *</label>
        <input asp-for="FechaEntrada" class="form-control" type="date" id="FechaEntrada" />
        <span asp-validation-for="FechaEntrada" class="text-danger"></span>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="FechaSalida" class="form-label">Fecha de salida *</label>
        <input asp-for="FechaSalida" class="form-control" type="date" id="FechaSalida" />
        <span asp-validation-for="FechaSalida" class="text-danger"></span>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="CantidadHuespedes" class="form-label">Huéspedes *</label>
        <input asp-for="CantidadHuespedes" class="form-control" type="number" min="1" step="1" id="CantidadHuespedes" />
        <span asp-validation-for="CantidadHuespedes" class="text-danger"></span>
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="PrecioNoche" class="form-label">Precio por noche *</label>
        <input asp-for="PrecioNoche" class="form-control" type="number" min="0" step="0.01" id="PrecioNoche" />
        <span asp-validation-for="PrecioNoche" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-4">
        <label asp-for="EstadoReserva" class="form-label">Estado de reserva *</label>
        <select asp-for="EstadoReserva" class="form-select" asp-items="@(new SelectList(estados))"></select>
        <span asp-validation-for="EstadoReserva" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-4">
        <label asp-for="PlacaVehiculo" class="form-label">Placa del vehículo</label>
        <input asp-for="PlacaVehiculo" class="form-control" maxlength="10" />
        <span asp-validation-for="PlacaVehiculo" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-4">
        <div class="dato-etiqueta">Resumen</div>
        <div class="dato-valor" id="ResumenReserva">—</div>
    </div>
    <div class="col-12">
        <label asp-for="Observaciones" class="form-label">Observaciones</label>
        <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="250"></textarea>
        <span asp-validation-for="Observaciones" class="text-danger"></span>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var entrada = document.getElementById('FechaEntrada');
        var salida = document.getElementById('FechaSalida');
        var hab = document.getElementById('IdHabitacion');
        var precio = document.getElementById('PrecioNoche');
        var huespedes = document.getElementById('CantidadHuespedes');
        var resumen = document.getElementById('ResumenReserva');
        var esNueva = @(Model.IdReserva == 0 ? "true" : "false");
        var hoy = '@hoy';

        function sumarDia(valor) {
            var d = new Date(valor + 'T00:00:00');
            d.setDate(d.getDate() + 1);
            var m = ('0' + (d.getMonth() + 1)).slice(-2), dd = ('0' + d.getDate()).slice(-2);
            return d.getFullYear() + '-' + m + '-' + dd;
        }

        function actualizar() {
            if (esNueva) { entrada.min = hoy; }
            if (entrada.value) {
                var minSalida = sumarDia(entrada.value);
                salida.min = minSalida;
                if (salida.value && salida.value < minSalida) { salida.value = minSalida; }
            }
            var opcion = hab.options[hab.selectedIndex];
            if (opcion && opcion.dataset.capacidad) { huespedes.max = opcion.dataset.capacidad; }
            if (entrada.value && salida.value) {
                var noches = Math.round((new Date(salida.value) - new Date(entrada.value)) / 86400000);
                var total = noches * (parseFloat(precio.value) || 0);
                resumen.textContent = noches + ' noche(s) · ₡ ' + total.toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
            mostrarOcupadas(opcion);
        }

        // Muestra las fechas que ya tiene reservadas la habitación y avisa si las elegidas se cruzan.
        var cajaOcupadas = document.getElementById('FechasOcupadas');
        function formato(valor) { var p = valor.split('-'); return p[2] + '/' + p[1]; }
        function mostrarOcupadas(opcion) {
            var rangos = opcion && opcion.dataset.ocupado ? JSON.parse(opcion.dataset.ocupado) : [];
            if (rangos.length === 0) { cajaOcupadas.classList.add('d-none'); return; }

            var choque = rangos.find(function (r) {
                return entrada.value && salida.value && entrada.value < r.s && salida.value > r.e;
            });
            cajaOcupadas.classList.remove('d-none');
            cajaOcupadas.classList.toggle('choque', !!choque);
            cajaOcupadas.innerHTML =
                (choque
                    ? '<strong><i class="bi bi-exclamation-triangle"></i> Esas fechas chocan con la reserva de ' + choque.c + '.</strong>'
                    : '<strong><i class="bi bi-calendar-x"></i> Fechas ya reservadas:</strong>') +
                '<ul>' + rangos.map(function (r) {
                    return '<li>' + formato(r.e) + ' al ' + formato(r.s) + ' · ' + r.c + '</li>';
                }).join('') + '</ul>' +
                '<small>El día de salida de una reserva puede ser el día de entrada de otra.</small>';
        }

        hab.addEventListener('change', function () {
            var opcion = hab.options[hab.selectedIndex];
            if (opcion && opcion.dataset.precio) { precio.value = opcion.dataset.precio; }
            actualizar();
        });
        [entrada, salida, precio, huespedes].forEach(function (e) { e.addEventListener('change', actualizar); e.addEventListener('input', actualizar); });
        actualizar();
    });
</script>
