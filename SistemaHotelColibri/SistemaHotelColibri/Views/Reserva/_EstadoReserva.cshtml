@using SistemaHotelColibri.Abstract.Modelos.Reservas
@model ReservaDto
@if (Model.EstadoReserva == Estados.Reserva.Cancelada)
{
    <span class="estado estado-cancelado"><i class="bi bi-x-circle"></i> Cancelada</span>
}
else if (Model.EstadoReserva == Estados.Reserva.CheckIn)
{
    <span class="estado estado-activo"><i class="bi bi-box-arrow-in-right"></i> En check-in</span>
}
else if (Model.EstadoReserva == Estados.Reserva.CheckOut)
{
    <span class="estado estado-inactivo"><i class="bi bi-box-arrow-right"></i> Check-out</span>
}
else if (Model.EstadoReserva == Estados.Reserva.Confirmada)
{
    <span class="estado estado-proceso"><i class="bi bi-calendar-check"></i> Confirmada</span>
}
else
{
    <span class="estado estado-alerta"><i class="bi bi-hourglass-split"></i> Pendiente</span>
}
