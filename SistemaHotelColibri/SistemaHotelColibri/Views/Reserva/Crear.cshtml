@using SistemaHotelColibri.ViewModels.Reservas
@model ReservaFormViewModel
@{
    ViewData["Title"] = "Nueva reserva";
}

<div class="encabezado-pagina">
    <div>
        <h1>Nueva reserva</h1>
        <p>Complete los datos para registrar una reserva de hospedaje.</p>
    </div>
</div>

<form asp-action="Crear" method="post" class="tarjeta tarjeta-cuerpo">
    <partial name="_Formulario" model="Model" />
    <div class="d-flex gap-2 justify-content-end mt-4">
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar reserva</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
