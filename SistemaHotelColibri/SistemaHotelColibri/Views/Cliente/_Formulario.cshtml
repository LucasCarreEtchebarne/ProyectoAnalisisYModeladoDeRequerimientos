@using SistemaHotelColibri.ViewModels.Clientes
@model ClienteFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-3">
    <div class="col-12 col-md-4">
        <label asp-for="Identificacion" class="form-label">Identificación *</label>
        <input asp-for="Identificacion" class="form-control" maxlength="30" placeholder="Ej.: 1-1234-0567" autofocus />
        <div class="form-text">Cédula, DIMEX o pasaporte. Solo letras, números y guiones.</div>
        <span asp-validation-for="Identificacion" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-8">
        <label asp-for="Nombre" class="form-label">Nombre *</label>
        <input asp-for="Nombre" class="form-control" maxlength="100" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="PrimerApellido" class="form-label">Primer apellido *</label>
        <input asp-for="PrimerApellido" class="form-control" maxlength="50" />
        <span asp-validation-for="PrimerApellido" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="SegundoApellido" class="form-label">Segundo apellido</label>
        <input asp-for="SegundoApellido" class="form-control" maxlength="50" />
        <span asp-validation-for="SegundoApellido" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="Telefono" class="form-label">Teléfono</label>
        <input asp-for="Telefono" class="form-control" maxlength="20" type="tel" placeholder="Ej.: 8888-1111" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="CorreoElectronico" class="form-label">Correo electrónico</label>
        <input asp-for="CorreoElectronico" class="form-control" maxlength="150" type="email" placeholder="Ej.: nombre@correo.com" />
        <span asp-validation-for="CorreoElectronico" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Direccion" class="form-label">Dirección</label>
        <textarea asp-for="Direccion" class="form-control" rows="2" maxlength="250"></textarea>
        <span asp-validation-for="Direccion" class="text-danger"></span>
    </div>
    @if (Model.EsEdicion)
    {
        var estados = (string[])ViewBag.EstadosCliente;
        <div class="col-12 col-md-4">
            <label asp-for="EstadoCliente" class="form-label">Estado *</label>
            <select asp-for="EstadoCliente" class="form-select" asp-items="@(new SelectList(estados))"></select>
            <div class="form-text">Permite reactivar un cliente eliminado.</div>
            <span asp-validation-for="EstadoCliente" class="text-danger"></span>
        </div>
    }
    else
    {
        <input type="hidden" asp-for="EstadoCliente" />
    }
</div>