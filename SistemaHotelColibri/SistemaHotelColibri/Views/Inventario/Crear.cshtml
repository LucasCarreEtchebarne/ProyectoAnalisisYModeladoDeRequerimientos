@using SistemaHotelColibri.ViewModels.Inventarios
@model InventarioFormViewModel
@{
    ViewData["Title"] = "Nuevo producto";
}

<div class="encabezado-pagina">
    <div>
        <h1>Nuevo producto</h1>
        <p>El código del producto se genera automáticamente al guardar.</p>
    </div>
</div>

<form asp-action="Crear" method="post" class="tarjeta tarjeta-cuerpo">
    <partial name="_Formulario" model="Model" />
    <div class="d-flex gap-2 justify-content-end mt-4">
        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
