@using SistemaHotelColibri.Abstract.Modelos.Inventarios
@model InventarioDto
@if (Model.EstadoProducto == Estados.ProductoInventario.Inactivo)
{
    <span class="estado estado-inactivo">Inactivo</span>
}
else if (Model.RequiereAlerta)
{
    <span class="estado estado-alerta"><i class="bi bi-exclamation-triangle"></i> Stock mínimo</span>
}
else
{
    <span class="estado estado-activo">Activo</span>
}
