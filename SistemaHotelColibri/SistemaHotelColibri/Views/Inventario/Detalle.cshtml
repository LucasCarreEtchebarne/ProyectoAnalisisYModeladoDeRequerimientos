@using SistemaHotelColibri.Abstract.Modelos.Inventarios
@model InventarioDto
@{
    ViewData["Title"] = "Detalle de producto";
}

<div class="encabezado-pagina">
    <div>
        <h1>@Model.NombreProducto</h1>
        <p>Código #@Model.IdProducto · <partial name="_EstadoProducto" model="Model" /></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Volver</a>
        <a class="btn btn-primary" asp-action="Editar" asp-route-id="@Model.IdProducto"><i class="bi bi-pencil"></i> Editar</a>
        @if (Model.EstadoProducto == Estados.ProductoInventario.Activo)
        {
            <form asp-action="Eliminar" asp-route-id="@Model.IdProducto" method="post"
                  data-confirmar="¿Desea eliminar el producto «@Model.NombreProducto»? Dejará de aparecer en el inventario activo."
                  data-confirmar-boton="Eliminar">
                <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash"></i> Eliminar</button>
            </form>
        }
    </div>
</div>

@if (Model.RequiereAlerta)
{
    <div class="alert alert-warning d-flex align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i>
        El stock actual (@Formato.Cantidad(Model.Stock) @Model.UnidadMedida) está en o por debajo del mínimo (@Formato.Cantidad(Model.StockMinimo)).
    </div>
}

<div class="tarjeta tarjeta-cuerpo">
    <div class="row">
        <div class="col-6 col-md-3">
            <div class="dato-etiqueta">Categoría</div>
            <div class="dato-valor">@Model.CategoriaProducto</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="dato-etiqueta">Unidad de medida</div>
            <div class="dato-valor">@Model.UnidadMedida</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="dato-etiqueta">Stock actual</div>
            <div class="dato-valor">@Formato.Cantidad(Model.Stock)</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="dato-etiqueta">Stock mínimo</div>
            <div class="dato-valor">@Formato.Cantidad(Model.StockMinimo)</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="dato-etiqueta">Fecha de ingreso</div>
            <div class="dato-valor">@Formato.Fecha(Model.FechaIngreso)</div>
        </div>
        <div class="col-12 col-md-9">
            <div class="dato-etiqueta">Descripción</div>
            <div class="dato-valor">@(Model.Descripcion ?? "—")</div>
        </div>
    </div>
</div>
