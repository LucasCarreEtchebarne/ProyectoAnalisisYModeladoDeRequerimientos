@using SistemaHotelColibri.Abstract.Modelos.Inventarios
@model List<InventarioDto>
@{
    ViewData["Title"] = "Alertas de inventario";
}

<div class="encabezado-pagina">
    <div>
        <h1>Alertas de inventario</h1>
        <p>Productos activos cuyo stock está en o por debajo del mínimo definido.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Volver al inventario</a>
</div>

@if (Model.Count == 0)
{
    <div class="tarjeta tarjeta-cuerpo text-center py-5">
        <i class="bi bi-check2-circle text-success" style="font-size: 2.2rem;"></i>
        <p class="mt-2 mb-0">No hay productos con stock bajo.</p>
    </div>
}
else
{
    <div class="tarjeta">
        <div class="table-responsive">
            <table class="table table-hover tabla-datos">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th class="text-end">Stock</th>
                        <th class="text-end">Mínimo</th>
                        <th class="text-end">Faltante</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="text-secondary">#@p.IdProducto</td>
                            <td><a class="fw-semibold text-decoration-none" asp-action="Detalle" asp-route-id="@p.IdProducto">@p.NombreProducto</a></td>
                            <td>@p.CategoriaProducto</td>
                            <td class="text-end text-nowrap">@Formato.Cantidad(p.Stock) <span class="text-secondary small">@p.UnidadMedida</span></td>
                            <td class="text-end">@Formato.Cantidad(p.StockMinimo)</td>
                            <td class="text-end">@Formato.Cantidad(p.StockMinimo - p.Stock)</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@p.IdProducto">Actualizar stock</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
