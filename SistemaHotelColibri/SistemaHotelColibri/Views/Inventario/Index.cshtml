@using SistemaHotelColibri.Abstract.Modelos.Inventarios
@model List<InventarioDto>
@{
    ViewData["Title"] = "Inventario";
    var estadoSeleccionado = (string)ViewBag.EstadoSeleccionado;
    var opcionesEstado = (string[])ViewBag.OpcionesEstado;
    var totalAlertas = (int)ViewBag.TotalAlertas;
}

<div class="encabezado-pagina">
    <div>
        <h1>Inventario</h1>
        <p>Productos e insumos del restaurante.</p>
    </div>
    <a class="btn btn-primary" asp-action="Crear"><i class="bi bi-plus-lg"></i> Nuevo producto</a>
</div>

@if (totalAlertas > 0)
{
    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span><strong>@totalAlertas</strong> producto(s) están en o por debajo del stock mínimo.</span>
        <a class="alert-link ms-auto" asp-action="Alertas">Ver alertas</a>
    </div>
}

<form method="get" class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <label class="small text-secondary" for="estado">Mostrar</label>
    <select class="form-select form-select-sm w-auto" id="estado" name="estado" onchange="this.form.submit()">
        @foreach (var opcion in opcionesEstado)
        {
            <option value="@opcion" selected="@(opcion == estadoSeleccionado)">@opcion</option>
        }
    </select>
</form>

<div class="tarjeta">
    <div class="table-responsive">
        <table class="table table-hover tabla-datos">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th class="text-end">Stock</th>
                    <th class="text-end">Mínimo</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-5">
                            <i class="bi bi-inbox d-block fs-3 mb-2"></i>
                            No hay productos para mostrar.
                        </td>
                    </tr>
                }
                @foreach (var p in Model)
                {
                    <tr class="@(p.EstadoProducto == Estados.ProductoInventario.Inactivo ? "fila-inactiva" : "")">
                        <td class="text-secondary">#@p.IdProducto</td>
                        <td>
                            <a class="fw-semibold text-decoration-none" asp-action="Detalle" asp-route-id="@p.IdProducto">@p.NombreProducto</a>
                        </td>
                        <td>@p.CategoriaProducto</td>
                        <td class="text-end text-nowrap">@Formato.Cantidad(p.Stock) <span class="text-secondary small">@p.UnidadMedida</span></td>
                        <td class="text-end">@Formato.Cantidad(p.StockMinimo)</td>
                        <td><partial name="_EstadoProducto" model="p" /></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Detalle" asp-route-id="@p.IdProducto" title="Ver detalle" aria-label="Ver detalle"><i class="bi bi-eye"></i></a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@p.IdProducto" title="Editar" aria-label="Editar"><i class="bi bi-pencil"></i></a>
                            @if (p.EstadoProducto == Estados.ProductoInventario.Activo)
                            {
                                <form asp-action="Eliminar" asp-route-id="@p.IdProducto" method="post" class="d-inline"
                                      data-confirmar="¿Desea eliminar el producto «@p.NombreProducto»? Dejará de aparecer en el inventario activo."
                                      data-confirmar-boton="Eliminar">
                                    <button class="btn btn-sm btn-outline-danger" type="submit" title="Eliminar" aria-label="Eliminar"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<p class="small text-secondary mt-2">@Model.Count producto(s)</p>
