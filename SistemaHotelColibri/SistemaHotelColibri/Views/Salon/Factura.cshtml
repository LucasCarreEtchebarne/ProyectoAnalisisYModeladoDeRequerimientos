@using SistemaHotelColibri.Abstract.Modelos.Facturas
@model FacturaDto
@{
    ViewData["Title"] = $"Factura {Model.NumeroFactura}";
    var puedeVerFacturacion = Roles.AccesoFacturacion.Split(',').Any(User.IsInRole);
}

<div class="encabezado-pagina no-imprimir">
    <div>
        <h1>Factura @Model.NumeroFactura</h1>
        <p>La cuenta quedó cobrada y ya se puede usar de nuevo.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-secondary" onclick="window.print()"><i class="bi bi-printer"></i> Imprimir</button>
        @if (puedeVerFacturacion)
        {
            <a class="btn btn-outline-secondary" asp-controller="Factura" asp-action="Detalle" asp-route-id="@Model.IdFactura"><i class="bi bi-cash-coin"></i> Ver en Facturación</a>
        }
        <a class="btn btn-primary" asp-action="Index"><i class="bi bi-arrow-left"></i> Volver a pedidos</a>
    </div>
</div>

<article class="tarjeta factura">
    <header class="factura-encabezado">
        <img src="~/img/logo-colibri.png" alt="Cabinas El Colibrí" />
        <div class="text-end">
            <div class="factura-numero">@Model.NumeroFactura</div>
            <div class="texto-suave">@Formato.FechaHora(Model.FechaEmision)</div>
            <partial name="~/Views/Factura/_EstadoFactura.cshtml" model="Model" />
        </div>
    </header>

    <div class="factura-datos">
        <div>
            <div class="dato-etiqueta">Cliente</div>
            <div class="dato-valor">@Model.ClienteMostrado</div>
            @if (!string.IsNullOrEmpty(Model.IdentificacionCliente))
            {
                <div class="texto-suave">Identificación: @Model.IdentificacionCliente</div>
            }
        </div>
        <div>
            <div class="dato-etiqueta">Servicio</div>
            <div class="dato-valor">@Model.TipoFactura</div>
        </div>
        <div>
            <div class="dato-etiqueta">Atendido por</div>
            <div class="dato-valor">@(Model.NombreUsuario ?? "—")</div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table tabla-datos">
            <thead>
                <tr>
                    <th>Descripción</th>
                    <th class="text-end">Cantidad</th>
                    <th class="text-end">Precio</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var linea in Model.Detalles)
                {
                    <tr>
                        <td>@linea.Descripcion</td>
                        <td class="text-end">@Formato.Cantidad(linea.Cantidad)</td>
                        <td class="text-end text-nowrap">@Formato.Colones(linea.PrecioUnitario)</td>
                        <td class="text-end text-nowrap">@Formato.Colones(linea.Subtotal)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="factura-pie">
        <div class="factura-pagos">
            @foreach (var pago in Model.Pagos.Where(p => p.EstadoPago == Estados.Pago.Aprobado))
            {
                <div class="dato-etiqueta">Pago</div>
                <div class="fw-semibold">
                    @pago.MetodoPago
                    @if (pago.TipoTarjeta != null)
                    {
                        <span>· @pago.TipoTarjeta terminada en @pago.UltimosCuatroDigitos</span>
                    }
                    @if (pago.NumeroReferencia != null)
                    {
                        <span>· Comprobante @pago.NumeroReferencia</span>
                    }
                </div>
                @if (pago.MontoRecibido != null)
                {
                    <div class="texto-suave">Recibido @Formato.Colones(pago.MontoRecibido.Value) · Vuelto @Formato.Colones(pago.CambioDevuelto ?? 0)</div>
                }
            }
            @if (Model.Saldo > 0)
            {
                <div class="estado estado-alerta mt-2"><i class="bi bi-exclamation-triangle"></i> Saldo pendiente @Formato.Colones(Model.Saldo)</div>
            }
        </div>
        <div class="factura-total">
            <dl class="totales-factura mb-2">
                <dt>Subtotal</dt>
                <dd>@Formato.Colones(Model.Subtotal)</dd>
                <dt>Servicio (10 %)</dt>
                <dd>@Formato.Colones(Model.MontoServicio)</dd>
                <dt>IVA (13 %)</dt>
                <dd>@Formato.Colones(Model.MontoIva)</dd>
            </dl>
            <span>Total</span>
            <strong>@Formato.Colones(Model.MontoTotal)</strong>
        </div>
    </div>

    <p class="factura-gracias">¡Gracias por su visita! Pura Vida.</p>
</article>
