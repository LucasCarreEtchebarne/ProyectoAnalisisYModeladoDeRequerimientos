@model SistemaHotelColibri.ViewModels.Usuarios.UsuarioFormViewModel
@{
    ViewData["Title"] = "Editar usuario";
}

<div class="encabezado-pagina">
    <div>
        <h1>Editar usuario</h1>
        <p>La contraseña se gestiona desde el detalle del usuario.</p>
    </div>
</div>

<form asp-action="Editar" asp-route-id="@Model.IdUsuario" method="post" class="tarjeta tarjeta-cuerpo">
    <partial name="_Formulario" model="Model" />
    <div class="d-flex gap-2 justify-content-end mt-4">
        <a class="btn btn-outline-secondary" asp-action="Detalle" asp-route-id="@Model.IdUsuario">Cancelar</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar cambios</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
