@model SistemaHotelColibri.Abstract.Modelos.Usuarios.UsuarioDto
@switch (Model.EstadoMostrado)
{
    case Estados.Usuario.Activo:
        <span class="estado estado-activo"><i class="bi bi-person-check"></i> Activo</span>
        break;
    case Estados.Usuario.Bloqueado:
        <span class="estado estado-cancelado"><i class="bi bi-lock-fill"></i> Bloqueado</span>
        break;
    default:
        <span class="estado estado-inactivo"><i class="bi bi-person-dash"></i> Inactivo</span>
        break;
}
