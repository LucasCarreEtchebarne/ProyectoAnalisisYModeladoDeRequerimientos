@using SistemaHotelColibri.Abstract.Modelos.Usuarios
@model ResultadoPaginado<UsuarioDto>
@{
    ViewData["Title"] = "Usuarios";
    var barraBusqueda = (BarraBusquedaViewModel)ViewBag.Busqueda;
    var idUsuarioActual = (int)ViewBag.IdUsuarioActual;
}

<div class="encabezado-pagina">
    <div>
        <h1>Usuarios</h1>
        <p>Usuarios del sistema y sus roles.</p>
    </div>
    <a class="btn btn-primary" asp-action="Crear"><i class="bi bi-person-plus"></i> Nuevo usuario</a>
</div>

<partial name="_BarraBusqueda" model="barraBusqueda" />

<div class="tarjeta">
    <div class="table-responsive">
        <table class="table table-hover tabla-datos">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Usuario</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Último acceso</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Elementos.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-5">
                            <i class="bi bi-inbox d-block fs-3 mb-2"></i>
                            No hay usuarios para mostrar.
                        </td>
                    </tr>
                }
                @foreach (var u in Model.Elementos)
                {
                    <tr class="@(u.Estado == Estados.Usuario.Inactivo ? "fila-inactiva" : "")">
                        <td>
                            <a class="fw-semibold text-decoration-none" asp-action="Detalle" asp-route-id="@u.IdUsuario">@u.NombreCompleto</a>
                            @if (u.IdUsuario == idUsuarioActual)
                            {
                                <span class="badge text-bg-light border ms-1">Usted</span>
                            }
                        </td>
                        <td>@u.NombreUsuario</td>
                        <td>@u.CorreoElectronico</td>
                        <td>@u.Rol</td>
                        <td class="text-nowrap">@(u.FechaUltimoAcceso.HasValue ? Formato.Fecha(u.FechaUltimoAcceso.Value) : "—")</td>
                        <td><partial name="_EstadoUsuario" model="u" /></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Detalle" asp-route-id="@u.IdUsuario" title="Ver detalle" aria-label="Ver detalle"><i class="bi bi-eye"></i></a>
                            @if (u.Estado == Estados.Usuario.Activo)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@u.IdUsuario" title="Editar" aria-label="Editar"><i class="bi bi-pencil"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Paginacion" model="Model" />
