@using SistemaHotelColibri.Abstract.Modelos.Pedidos
@model PedidoDto

@{
    ViewData["Title"] = "Detalle de pedido";
}

<div class="encabezado-pagina">
    <div>
        <h1>Pedido · @Model.Origen</h1>
        <p>@Model.EstadoPedido · @Model.FechaHoraPedido.ToString("dd/MM/yyyy HH:mm")</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
        @if (Model.EstadoPedido == Estados.Pedido.Pendiente)
        {
            <a asp-action="Editar" asp-route-id="@Model.IdPedido" class="btn btn-primary">
                <i class="bi bi-pencil"></i> Editar
            </a>
            <form asp-action="Inactivar" asp-route-id="@Model.IdPedido" method="post"
                  data-confirmar="¿Desea cancelar el pedido de @Model.Origen del @Model.FechaHoraPedido.ToString("dd/MM/yyyy HH:mm")? Quedará en estado Inactivo."
                  data-confirmar-boton="Inactivar">
                <button class="btn btn-outline-danger" type="submit"><i class="bi bi-slash-circle"></i> Inactivar</button>
            </form>
        }
    </div>
</div>

<div class="tarjeta tarjeta-cuerpo mb-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Tipo</dt>
        <dd class="col-sm-9">@Model.TipoPedido</dd>

        <dt class="col-sm-3">Cliente</dt>
        <dd class="col-sm-9">@(Model.NombreCliente ?? "Sin cliente asociado")</dd>

        @if (Model.NumeroMesa.HasValue)
        {
            <dt class="col-sm-3">Mesa</dt>
            <dd class="col-sm-9">@Model.NumeroMesa</dd>
        }

        @if (!string.IsNullOrEmpty(Model.NumeroHabitacion))
        {
            <dt class="col-sm-3">Habitación</dt>
            <dd class="col-sm-9">
                @Model.NumeroHabitacion
                @if (Model.IdReserva.HasValue && Roles.AccesoHospedaje.Split(',').Any(User.IsInRole))
                {
                    <a class="ms-2 small" asp-controller="Reserva" asp-action="Detalle" asp-route-id="@Model.IdReserva">Ver reserva</a>
                }
            </dd>
        }

        <dt class="col-sm-3">Observaciones</dt>
        <dd class="col-sm-9">@(Model.Observaciones ?? "—")</dd>
    </dl>
</div>

<div class="tarjeta">
    <div class="table-responsive">
        <table class="table tabla-datos">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th class="text-end">Cantidad</th>
                    <th class="text-end">Precio unitario</th>
                    <th class="text-end">Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Model.Detalles)
                {
                    <tr>
                        <td>@detalle.NombreProducto</td>
                        <td class="text-end">@detalle.Cantidad</td>
                        <td class="text-end">@Formato.Colones(detalle.PrecioUnitario)</td>
                        <td class="text-end">@Formato.Colones(detalle.Subtotal)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th class="text-end">@Formato.Colones(Model.Total)</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>