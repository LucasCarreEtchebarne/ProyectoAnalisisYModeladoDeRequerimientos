@using SistemaHotelColibri.Abstract.Modelos.Pedidos
@model ResultadoPaginado<PedidoDto>

@{
    ViewData["Title"] = "Pedidos";
    var barraBusqueda = (BarraBusquedaViewModel)ViewBag.Busqueda;
}

<div class="encabezado-pagina">
    <div>
        <h1>Pedidos</h1>
        <p>Consultá los pedidos registrados del restaurante.</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Nuevo pedido
    </a>
</div>

<partial name="_BarraBusqueda" model="barraBusqueda" />

<div class="tarjeta">
    <div class="table-responsive">
        <table class="table table-hover tabla-datos">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Fecha</th>
                    <th>Tipo</th>
                    <th>Cliente</th>
                    <th>Estado</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Elementos.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-4">
                            No se encontraron pedidos.
                        </td>
                    </tr>
                }

                @foreach (var pedido in Model.Elementos)
                {
                    <tr class="@(pedido.EstadoPedido == Estados.Pedido.Inactivo ? "fila-inactiva" : "")">
                        <td>#@pedido.IdPedido</td>
                        <td>@pedido.FechaHoraPedido.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@pedido.TipoPedido</td>
                        <td>@(pedido.NombreCliente ?? "Sin cliente asociado")</td>
                        <td>@pedido.EstadoPedido</td>
                        <td class="text-end">@Formato.Colones(pedido.Total)</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Detalle" asp-route-id="@pedido.IdPedido" class="btn btn-sm btn-outline-secondary" title="Ver detalle" aria-label="Ver detalle"><i class="bi bi-eye"></i></a>
                            @if (pedido.EstadoPedido == Estados.Pedido.Pendiente)
                            {
                                <a asp-action="Editar" asp-route-id="@pedido.IdPedido" class="btn btn-sm btn-outline-secondary" title="Editar" aria-label="Editar"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Inactivar" asp-route-id="@pedido.IdPedido" method="post" class="d-inline"
                                      data-confirmar="¿Desea cancelar el pedido #@pedido.IdPedido?"
                                      data-confirmar-boton="Inactivar">
                                    <button class="btn btn-sm btn-outline-danger" type="submit" title="Inactivar" aria-label="Inactivar"><i class="bi bi-slash-circle"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Paginacion" model="Model" />