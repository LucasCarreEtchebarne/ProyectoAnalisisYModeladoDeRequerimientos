@using SistemaHotelColibri.Abstract.Modelos.Facturas
@model ResultadoPaginado<FacturaDto>
@{
    ViewData["Title"] = "Facturación";
    var barraBusqueda = (BarraBusquedaViewModel)ViewBag.Busqueda;
}

<div class="encabezado-pagina">
    <div>
        <h1>Facturación</h1>
        <p>Facturas de hospedaje, restaurante y consolidadas, con sus pagos.</p>
    </div>
    <a class="btn btn-primary" asp-action="Nueva"><i class="bi bi-receipt"></i> Nueva factura</a>
</div>

<partial name="_BarraBusqueda" model="barraBusqueda" />

<div class="tarjeta">
    <div class="table-responsive">
        <table class="table table-hover tabla-datos">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Tipo</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Saldo</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Elementos.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-secondary py-5">
                            <i class="bi bi-inbox d-block fs-3 mb-2"></i>
                            @Mensajes.NoExistenFacturas
                        </td>
                    </tr>
                }
                @foreach (var f in Model.Elementos)
                {
                    <tr class="@(f.EstadoFactura == Estados.Factura.Anulada ? "fila-inactiva" : "")">
                        <td class="text-nowrap"><a class="fw-semibold text-decoration-none" asp-action="Detalle" asp-route-id="@f.IdFactura">@f.NumeroFactura</a></td>
                        <td class="text-nowrap">@Formato.Fecha(f.FechaEmision)</td>
                        <td>@f.ClienteMostrado</td>
                        <td>@f.TipoFactura</td>
                        <td class="text-end text-nowrap">@Formato.Colones(f.MontoTotal)</td>
                        <td class="text-end text-nowrap">@(f.EstadoFactura == Estados.Factura.Anulada ? "—" : Formato.Colones(f.Saldo))</td>
                        <td><partial name="_EstadoFactura" model="f" /></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Detalle" asp-route-id="@f.IdFactura" title="Ver detalle" aria-label="Ver detalle"><i class="bi bi-eye"></i></a>
                            @if (f.EstadoFactura == Estados.Factura.Pendiente)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-action="RegistrarPago" asp-route-id="@f.IdFactura" title="Registrar pago" aria-label="Registrar pago"><i class="bi bi-cash-coin"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Paginacion" model="Model" />
