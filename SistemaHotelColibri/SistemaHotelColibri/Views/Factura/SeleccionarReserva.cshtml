@using SistemaHotelColibri.Abstract.Modelos.Facturas
@model List<ReservaFacturableDto>
@{
    ViewData["Title"] = "Factura consolidada";
    ViewData["Accion"] = "Seleccionar";
}

<div class="encabezado-pagina">
    <div>
        <h1>Factura consolidada</h1>
        <p>Paso 1 de 2: seleccione la reserva del huésped.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Nueva"><i class="bi bi-arrow-left"></i> Volver</a>
</div>

<partial name="_BarraBusqueda" model="@(new BarraBusquedaViewModel { Busqueda = (string?)ViewBag.Busqueda, Placeholder = "Cliente, identificación o habitación" })" />

<partial name="_TablaReservas" model="Model" />
