@using SistemaHotelColibri.Abstract.Modelos.Menus
@model MenuDto
@{
    ViewData["Title"] = "Detalle de producto del menú";
    var esAdministrador = (bool)ViewBag.EsAdministrador;
}

<div class="encabezado-pagina">
    <div>
        <h1>@Model.NombreProducto</h1>
        <p><partial name="_EstadoProducto" model="Model" /></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Volver</a>
        @if (esAdministrador)
        {
            <a class="btn btn-primary" asp-action="Editar" asp-route-id="@Model.IdProductoMenu"><i class="bi bi-pencil"></i> Editar</a>
            @if (Model.EstadoProductoMenu != Estados.ProductoMenu.Inactivo)
            {
                <form asp-action="Eliminar" asp-route-id="@Model.IdProductoMenu" method="post"
                      data-confirmar="¿Desea inactivar el producto «@Model.NombreProducto»? Dejará de estar disponible en el menú."
                      data-confirmar-boton="Inactivar">
                    <button class="btn btn-outline-danger" type="submit"><i class="bi bi-slash-circle"></i> Inactivar</button>
                </form>
            }
        }
    </div>
</div>

<div class="tarjeta tarjeta-cuerpo">
    <div class="row">
        <div class="col-6 col-md-3">
            <div class="dato-etiqueta">Categoría</div>
            <div class="dato-valor">@Model.CategoriaMenu</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="dato-etiqueta">Precio</div>
            <div class="dato-valor">@Formato.Colones(Model.Precio)</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="dato-etiqueta">Estado</div>
            <div class="dato-valor">@Model.EstadoProductoMenu</div>
        </div>
        <div class="col-12">
            <div class="dato-etiqueta">Descripción</div>
            <div class="dato-valor">@(Model.Descripcion ?? "—")</div>
        </div>
    </div>
</div>
