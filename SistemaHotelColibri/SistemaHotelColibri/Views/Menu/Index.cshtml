@using SistemaHotelColibri.Abstract.Modelos.Menus
@model ResultadoPaginado<MenuDto>
@{
    ViewData["Title"] = "Menú";
    var barraBusqueda = (BarraBusquedaViewModel)ViewBag.Busqueda;
    var esAdministrador = (bool)ViewBag.EsAdministrador;
}

<div class="encabezado-pagina">
    <div>
        <h1>Menú</h1>
        <p>Platillos y bebidas disponibles en el restaurante.</p>
    </div>
    @if (esAdministrador)
    {
        <a class="btn btn-primary" asp-action="Crear"><i class="bi bi-plus-lg"></i> Nuevo producto</a>
    }
</div>

<partial name="_BarraBusqueda" model="barraBusqueda" />

<div class="tarjeta">
    <div class="table-responsive">
        <table class="table table-hover tabla-datos">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th class="text-end">Precio</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Elementos.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-secondary py-5">
                            <i class="bi bi-inbox d-block fs-3 mb-2"></i>
                            @Mensajes.NoExistenProductosMenu
                        </td>
                    </tr>
                }
                @foreach (var p in Model.Elementos)
                {
                    <tr class="@(p.EstadoProductoMenu == Estados.ProductoMenu.Inactivo ? "fila-inactiva" : "")">
                        <td>
                            <a class="fw-semibold text-decoration-none" asp-action="Detalle" asp-route-id="@p.IdProductoMenu">@p.NombreProducto</a>
                        </td>
                        <td>@p.CategoriaMenu</td>
                        <td class="text-end text-nowrap">@Formato.Colones(p.Precio)</td>
                        <td><partial name="_EstadoProducto" model="p" /></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Detalle" asp-route-id="@p.IdProductoMenu" title="Ver detalle" aria-label="Ver detalle"><i class="bi bi-eye"></i></a>
                            @if (esAdministrador)
                            {
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@p.IdProductoMenu" title="Editar" aria-label="Editar"><i class="bi bi-pencil"></i></a>
                                @if (p.EstadoProductoMenu != Estados.ProductoMenu.Inactivo)
                                {
                                    <form asp-action="Eliminar" asp-route-id="@p.IdProductoMenu" method="post" class="d-inline"
                                          data-confirmar="¿Desea inactivar el producto «@p.NombreProducto»? Dejará de estar disponible en el menú."
                                          data-confirmar-boton="Inactivar">
                                        <button class="btn btn-sm btn-outline-danger" type="submit" title="Inactivar" aria-label="Inactivar"><i class="bi bi-slash-circle"></i></button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Paginacion" model="Model" />
