@using SistemaHotelColibri.ViewModels.Eventos
@model EventoFormViewModel
@{
    ViewData["Title"] = "Editar evento";
}

<div class="encabezado-pagina">
    <div>
        <h1>Editar evento #@Model.IdEvento</h1>
        <p>Modifique los atributos necesarios. Cambie el estado a Cancelado para inactivarlo o a Programado para activarlo de nuevo.</p>
    </div>
</div>

<form asp-action="Editar" asp-route-id="@Model.IdEvento" method="post" class="tarjeta tarjeta-cuerpo">
    <partial name="_Formulario" model="Model" />
    <div class="d-flex gap-2 justify-content-end mt-4">
        <a class="btn btn-outline-secondary" asp-action="Detalle" asp-route-id="@Model.IdEvento">Cancelar</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar cambios</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
