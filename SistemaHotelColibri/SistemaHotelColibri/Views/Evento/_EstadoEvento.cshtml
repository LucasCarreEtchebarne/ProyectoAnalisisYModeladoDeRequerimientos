@using SistemaHotelColibri.Abstract.Modelos.Eventos
@model EventoDto
@if (Model.EstadoEvento == Estados.Evento.Cancelado)
{
    <span class="estado estado-cancelado"><i class="bi bi-x-circle"></i> Cancelado</span>
}
else if (Model.EstadoEvento == Estados.Evento.Realizado)
{
    <span class="estado estado-activo"><i class="bi bi-check2-circle"></i> Realizado</span>
}
else
{
    <span class="estado estado-proceso"><i class="bi bi-calendar-event"></i> Programado</span>
}
