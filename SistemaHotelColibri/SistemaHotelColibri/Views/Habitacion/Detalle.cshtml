@using SistemaHotelColibri.Abstract.Modelos.Habitaciones
@model HabitacionDto
@{
    ViewData["Title"] = "Detalle de habitación";
}

<div class="encabezado-pagina">
    <div>
        <h1>Habitación @Model.NumeroHabitacion</h1>
        <p>Código #@Model.IdHabitacion · <partial name="_EstadoHabitacion" model="Model" /></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index"><i class="bi bi-arrow-left"></i> Volver</a>
        <a class="btn btn-primary" asp-action="Editar" asp-route-id="@Model.IdHabitacion"><i class="bi bi-pencil"></i> Editar</a>
        <form asp-action="Eliminar" asp-route-id="@Model.IdHabitacion" method="post"
              data-confirmar="¿Desea eliminar la habitación «@Model.NumeroHabitacion»? Esta acción no se puede deshacer."
              data-confirmar-boton="Eliminar">
            <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash"></i> Eliminar</button>
        </form>
    </div>
</div>

<div class="tarjeta tarjeta-cuerpo">
    <div class="row">
        <div class="col-6 col-md-3">
            <div class="dato-etiqueta">Tipo de habitación</div>
            <div class="dato-valor">@Model.TipoHabitacion</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="dato-etiqueta">Capacidad</div>
            <div class="dato-valor">@Model.Capacidad</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="dato-etiqueta">Precio</div>
            <div class="dato-valor">@Formato.Colones(Model.Precio)</div>
        </div>
        <div class="col-6 col-md-3">
            <div class="dato-etiqueta">Piso</div>
            <div class="dato-valor">@Model.Piso</div>
        </div>
        <div class="col-12 col-md-9">
            <div class="dato-etiqueta">Descripción</div>
            <div class="dato-valor">@(Model.Descripcion ?? "—")</div>
        </div>
    </div>
</div>
