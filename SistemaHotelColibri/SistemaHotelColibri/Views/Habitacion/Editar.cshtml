@using SistemaHotelColibri.ViewModels.Habitaciones
@model HabitacionFormViewModel
@{
    ViewData["Title"] = "Editar habitación";
}

<div class="encabezado-pagina">
    <div>
        <h1>Editar habitación #@Model.IdHabitacion</h1>
        <p>Modifique los atributos necesarios y guarde los cambios.</p>
    </div>
</div>

<form asp-action="Editar" asp-route-id="@Model.IdHabitacion" method="post" class="tarjeta tarjeta-cuerpo">
    <partial name="_Formulario" model="Model" />
    <div class="d-flex gap-2 justify-content-end mt-4">
        <a class="btn btn-outline-secondary" asp-action="Detalle" asp-route-id="@Model.IdHabitacion">Cancelar</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Guardar cambios</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
