@using SistemaHotelColibri.Abstract.Modelos.Habitaciones
@using SistemaHotelColibri.Abstract.Modelos.Reservas
@model ResultadoPaginado<HabitacionDto>
@{
    ViewData["Title"] = "Habitaciones";
    var barraBusqueda = (BarraBusquedaViewModel)ViewBag.Busqueda;
    var ocupacion = (Dictionary<int, OcupacionHabitacionDto>)ViewBag.Ocupacion;
}

<div class="encabezado-pagina">
    <div>
        <h1>Habitaciones</h1>
        <p>Consulta de habitaciones registradas y su estado actual.</p>
    </div>
    <a class="btn btn-primary" asp-action="Crear"><i class="bi bi-plus-lg"></i> Nueva habitación</a>
</div>

<partial name="_TarjetasResumen" model="(List<TarjetaResumenViewModel>)ViewBag.Resumen" />

<partial name="_BarraBusqueda" model="barraBusqueda" />

<div class="tarjeta">
    <div class="table-responsive">
        <table class="table table-hover tabla-datos">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Tipo</th>
                    <th class="text-end">Capacidad</th>
                    <th class="text-end">Precio</th>
                    <th>Estado</th>
                    <th>Reserva</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Elementos.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-5">
                            <i class="bi bi-inbox d-block fs-3 mb-2"></i>
                            @Mensajes.NoExistenHabitaciones
                        </td>
                    </tr>
                }
                @foreach (var h in Model.Elementos)
                {
                    <tr class="@(h.EstadoHabitacion == Estados.Habitacion.Inactiva ? "fila-inactiva" : "")">
                        <td>
                            <a class="fw-semibold text-decoration-none" asp-action="Detalle" asp-route-id="@h.IdHabitacion">@h.NumeroHabitacion</a>
                        </td>
                        <td>@h.TipoHabitacion</td>
                        <td class="text-end">@h.Capacidad</td>
                        <td class="text-end text-nowrap">@Formato.Colones(h.Precio)</td>
                        @{
                            var oc = ocupacion.GetValueOrDefault(h.IdHabitacion);
                            var actual = oc?.ReservaActual;
                            var proxima = oc?.ProximaReserva;
                        }
                        <td>
                            @if (oc?.Estado == OcupacionHabitacionDto.Reservada && h.EstadoHabitacion == Estados.Habitacion.Disponible)
                            {
                                <span class="estado estado-proceso"><i class="bi bi-calendar-check"></i> Reservada</span>
                            }
                            else
                            {
                                <partial name="_EstadoHabitacion" model="h" />
                            }
                        </td>
                        <td>
                            @if (actual != null)
                            {
                                <a class="text-decoration-none" asp-controller="Reserva" asp-action="Detalle" asp-route-id="@actual.IdReserva">
                                    <div class="fw-semibold">@actual.NombreCliente</div>
                                    <div class="texto-suave">
                                        @(actual.EstadoReserva == Estados.Reserva.CheckIn ? "Hospedado" : "Llega") · @Formato.Fecha(actual.FechaEntrada) al @Formato.Fecha(actual.FechaSalida)
                                    </div>
                                </a>
                            }
                            @if (proxima != null)
                            {
                                <a class="texto-suave d-block text-decoration-none" asp-controller="Reserva" asp-action="Detalle" asp-route-id="@proxima.IdReserva">
                                    <i class="bi bi-calendar-event"></i> Próxima: @Formato.Fecha(proxima.FechaEntrada) · @proxima.NombreCliente
                                </a>
                            }
                            @if (actual == null && proxima == null)
                            {
                                <span class="texto-suave">Sin reservas</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Detalle" asp-route-id="@h.IdHabitacion" title="Ver detalle" aria-label="Ver detalle"><i class="bi bi-eye"></i> Ver</a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@h.IdHabitacion" title="Editar" aria-label="Editar"><i class="bi bi-pencil"></i> Editar</a>
                            @if (h.EstadoHabitacion != Estados.Habitacion.Inactiva)
                            {
                                <form asp-action="Eliminar" asp-route-id="@h.IdHabitacion" method="post" class="d-inline"
                                      data-confirmar="¿Desea inactivar la habitación «@h.NumeroHabitacion»? Dejará de estar disponible para reservas."
                                      data-confirmar-boton="Inactivar">
                                    <button class="btn btn-sm btn-outline-danger" type="submit" title="Inactivar" aria-label="Inactivar"><i class="bi bi-slash-circle"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Paginacion" model="Model" />
