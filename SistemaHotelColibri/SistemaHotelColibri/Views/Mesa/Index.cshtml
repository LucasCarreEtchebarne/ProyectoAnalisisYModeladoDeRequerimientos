@using SistemaHotelColibri.Abstract.Modelos.Mesas
@model ResultadoPaginado<MesaDto>
@{
    ViewData["Title"] = "Mesas";
    var barraBusqueda = (BarraBusquedaViewModel)ViewBag.Busqueda;
}

<div class="encabezado-pagina">
    <div>
        <h1>Mesas</h1>
        <p>Consulta de mesas registradas y su disponibilidad.</p>
    </div>
    <a class="btn btn-primary" asp-action="Crear"><i class="bi bi-plus-lg"></i> Nueva mesa</a>
</div>

<partial name="_BarraBusqueda" model="barraBusqueda" />

<div class="tarjeta">
    <div class="table-responsive">
        <table class="table table-hover tabla-datos">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Capacidad</th>
                    <th>Estado</th>
                    <th>Descripción</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Elementos.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-secondary py-5">
                            <i class="bi bi-inbox d-block fs-3 mb-2"></i>
                            @Mensajes.NoExistenMesas
                        </td>
                    </tr>
                }
                @foreach (var m in Model.Elementos)
                {
                    <tr class="@(m.EstadoMesa == Estados.Mesa.Inactiva ? "fila-inactiva" : "")">
                        <td>
                            <a class="fw-semibold text-decoration-none" asp-action="Detalle" asp-route-id="@m.IdMesa">@m.NumeroMesa</a>
                        </td>
                        <td>@m.Capacidad</td>
                        <td><partial name="_EstadoMesa" model="m" /></td>
                        <td>@(m.Descripcion ?? "—")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Detalle" asp-route-id="@m.IdMesa" title="Ver detalle" aria-label="Ver detalle"><i class="bi bi-eye"></i></a>
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@m.IdMesa" title="Editar" aria-label="Editar"><i class="bi bi-pencil"></i></a>
                            @if (m.EstadoMesa != Estados.Mesa.Inactiva)
                            {
                                <form asp-action="Eliminar" asp-route-id="@m.IdMesa" method="post" class="d-inline"
                                      data-confirmar="¿Desea inactivar la mesa «@m.NumeroMesa»?"
                                      data-confirmar-boton="Inactivar">
                                    <button class="btn btn-sm btn-outline-danger" type="submit" title="Inactivar" aria-label="Inactivar"><i class="bi bi-slash-circle"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Paginacion" model="Model" />
