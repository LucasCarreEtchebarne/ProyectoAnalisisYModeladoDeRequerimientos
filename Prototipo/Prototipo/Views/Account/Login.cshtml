@model Prototipo.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Iniciar Sesion";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El Colibri Hotel &amp; Steak House</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/Content/Site.css?v=3" rel="stylesheet" type="text/css" />
</head>
<body>
    <nav class="navbar">
        <a href="@Url.Action("Index", "Home")" class="navbar-brand">
            <span>El Colibri Hotel &amp; Steak House</span>
        </a>
        <div class="navbar-buttons">
            <a href="@Url.Action("Login", "Account")" class="btn-nav-outline">Iniciar Sesion</a>
        </div>
    </nav>

    <div class="login-container">
        <div class="login-left">
            <div class="login-brand">
                <h2>Inicio de Sesion</h2>
                <div class="brand-underline"></div>
            </div>

            <div class="login-hero">
                <p class="login-subtitle">ACCESO AL SISTEMA</p>
                <h1 class="login-title">
                    Gestiona<br />
                    los procesos<br />
                    desde un solo<br />
                    lugar
                </h1>
                <p class="login-description">
                    Accede al sistema administrativo y operativo.
                </p>
            </div>
        </div>

        <div class="login-right">
            <div class="login-form-container">
                <p class="form-welcome">BIENVENIDO</p>
                <h2 class="form-title">Iniciar sesion</h2>
                <p class="form-subtitle">Ingresa tus credenciales para continuar.</p>

                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "login-form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ReturnUrl)

                    @Html.ValidationSummary(false, null, new { @class = "alert-box alert-warning" })

                    <div class="form-group">
                        @Html.LabelFor(m => m.NombreUsuario)
                        @Html.TextBoxFor(m => m.NombreUsuario, new { placeholder = "Nombre de Usuario", autofocus = "autofocus" })
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Contrasena)
                        @Html.PasswordFor(m => m.Contrasena, new { placeholder = "Contrasena" })
                    </div>

                    <button type="submit" class="btn-login">Iniciar sesion</button>

                    <div class="form-links">
                        <span class="link-secondary">Si olvido su contrasena, solicite al administrador que la restablezca.</span>
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>
