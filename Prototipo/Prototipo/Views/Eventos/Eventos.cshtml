@using Prototipo.Common
@model List<Prototipo.Models.Evento>
@{
    ViewBag.Title = "Eventos";
    ViewBag.Modulo = "Eventos";
}

<div class="module-header">
    <h1>Gestion de Eventos</h1>
    <a href="@Url.Action("Crear", "Eventos")" class="btn-primary">Nuevo Evento</a>
</div>

<div class="filter-container">
    @using (Html.BeginForm("Eventos", "Eventos", FormMethod.Get))
    {
        <label for="estado">Estado:</label>
        <select id="estado" name="estado" class="filter-select">
            <option value="">Todos</option>
            @foreach (var estado in Estados.Evento.Todos)
            {
                <option value="@estado" selected="@(((string)ViewBag.Estado) == estado)">@estado</option>
            }
        </select>

        <label for="desde">Desde:</label>
        <input type="date" id="desde" name="desde" class="filter-select"
               value="@(ViewBag.Desde != null ? ((DateTime)ViewBag.Desde).ToString("yyyy-MM-dd") : "")" />

        <label for="hasta">Hasta:</label>
        <input type="date" id="hasta" name="hasta" class="filter-select"
               value="@(ViewBag.Hasta != null ? ((DateTime)ViewBag.Hasta).ToString("yyyy-MM-dd") : "")" />

        <label for="busqueda">Buscar:</label>
        <input type="text" id="busqueda" name="busqueda" class="filter-select" value="@ViewBag.Busqueda" placeholder="Evento o cliente" />

        <button type="submit" class="btn-primary">Filtrar</button>
    }
</div>

<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Evento</th>
                <th>Cliente</th>
                <th>Espacio</th>
                <th>Fecha</th>
                <th>Horario</th>
                <th>Participantes</th>
                <th>Monto</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="10">No hay eventos que coincidan con el filtro.</td></tr>
            }
            @foreach (var evento in Model)
            {
                <tr>
                    <td>@evento.IdEvento</td>
                    <td>@evento.NombreEvento</td>
                    <td>@evento.Cliente.NombreMostrar</td>
                    <td>@evento.Espacio.NombreEspacio</td>
                    <td>@Formato.Fecha(evento.FechaEvento)</td>
                    <td>@Formato.Hora(evento.HoraInicio) - @Formato.Hora(evento.HoraFin)</td>
                    <td>@evento.Participantes</td>
                    <td>@Formato.Colones(evento.MontoAcordado)</td>
                    <td><span class="@Formato.BadgeEstado(evento.EstadoEvento)">@evento.EstadoEvento</span></td>
                    <td class="table-actions">
                        <a href="@Url.Action("DetalleEvento", "Eventos", new { id = evento.IdEvento })" class="btn-view">Consultar</a>
                        @if (evento.EstadoEvento != Estados.Evento.Cancelado)
                        {
                            <a href="@Url.Action("Editar", "Eventos", new { id = evento.IdEvento })" class="btn-edit">Editar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
