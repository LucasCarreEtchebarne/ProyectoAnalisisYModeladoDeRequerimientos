@{
    ViewBag.Title = "Eventos";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El Colibri Hotel & Steak House</title>

    <!-- Custom CSS -->
    <link href="~/Content/Site.css?v=2" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar-main">
        <div class="navbar-main-brand">
            <h2>El Colibri Hotel & Steak House</h2>
            <span class="navbar-subtitle">Sistema de Gestion</span>
        </div>
        <div class="navbar-main-user">
            <span>Admin</span>
            <a href="@Url.Action("Index", "Home")" class="btn-logout">Cerrar Sesion</a>
        </div>
    </nav>

    <!-- Menu de Modulos -->
    <nav class="modules-navbar">
        <a href="@Url.Action("Main", "Main")" class="module-link">Dashboard</a>
        <a href="@Url.Action("Habitaciones", "Habitaciones")" class="module-link">Habitaciones</a>
        <a href="@Url.Action("Reservas", "Reservas")" class="module-link">Reservas</a>
        <a href="@Url.Action("Eventos", "Eventos")" class="module-link active">Eventos</a>
        <a href="@Url.Action("Inventario", "Inventario")" class="module-link">Inventario</a>
        <a href="@Url.Action("Mesas", "Mesas")" class="module-link">Punto de Venta</a>
        <a href="@Url.Action("Reportes", "Reportes")" class="module-link">Reportes</a>
        <a href="@Url.Action("Housekeeping", "Housekeeping")" class="module-link">Housekeeping</a>
        <a href="@Url.Action("Facturacion", "Facturacion")" class="module-link">Facturacion</a>
        <a href="@Url.Action("Pagos", "Pagos")" class="module-link">Pagos</a>
        <a href="@Url.Action("Bitacora", "Bitacora")" class="module-link">Bitacora</a>
        <a href="@Url.Action("Clientes", "Clientes")" class="module-link">Clientes</a>
        <a href="@Url.Action("Usuarios", "Usuarios")" class="module-link">Usuarios</a>
        <a href="@Url.Action("IA", "IA")" class="module-link">IA</a>
    </nav>

    <!-- Contenido Principal -->
    <div class="main-content-area">
        <div class="module-header">
            <h1>Gestion de Eventos</h1>
            <a href="@Url.Action("Crear", "Eventos")" class="btn-primary">Nuevo Evento</a>
        </div>

        <!-- Filtro de Estado -->
        <div class="filter-container">
            <label for="filtroEstado">Filtrar por Estado:</label>
            <select id="filtroEstado" class="filter-select">
                <option value="">Todos</option>
                <option value="Programado">Programado</option>
                <option value="EnCurso">En Curso</option>
                <option value="Completado">Completado</option>
                <option value="Cancelado">Cancelado</option>
            </select>
        </div>

        <!-- Tabla de Eventos -->
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nombre del Evento</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Horario</th>
                        <th>Participantes</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Boda Martinez-Lopez</td>
                        <td>Luis Gonzalez</td>
                        <td>2024-02-14</td>
                        <td>18:00 - 23:00</td>
                        <td>150</td>
                        <td><span class="badge badge-programado">Programado</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleEvento", "Eventos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Eventos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de eliminar este evento?')) { alert('Evento eliminado (Prototipo)'); window.location.reload(); }">Eliminar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>Conferencia Empresarial Tech 2024</td>
                        <td>Carlos Lopez</td>
                        <td>2024-01-20</td>
                        <td>09:00 - 17:00</td>
                        <td>80</td>
                        <td><span class="badge badge-encurso">En Curso</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleEvento", "Eventos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Eventos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de eliminar este evento?')) { alert('Evento eliminado (Prototipo)'); window.location.reload(); }">Eliminar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>Cumpleanos Ana Garcia</td>
                        <td>Ana Martinez</td>
                        <td>2024-01-10</td>
                        <td>19:00 - 23:00</td>
                        <td>50</td>
                        <td><span class="badge badge-completado">Completado</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleEvento", "Eventos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Eventos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de eliminar este evento?')) { alert('Evento eliminado (Prototipo)'); window.location.reload(); }">Eliminar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>Reunion Anual Accionistas</td>
                        <td>Juan Perez</td>
                        <td>2024-03-05</td>
                        <td>14:00 - 18:00</td>
                        <td>30</td>
                        <td><span class="badge badge-programado">Programado</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleEvento", "Eventos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Eventos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de eliminar este evento?')) { alert('Evento eliminado (Prototipo)'); window.location.reload(); }">Eliminar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>Graduacion Universidad Nacional</td>
                        <td>Maria Garcia</td>
                        <td>2024-01-25</td>
                        <td>10:00 - 14:00</td>
                        <td>200</td>
                        <td><span class="badge badge-cancelado">Cancelado</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleEvento", "Eventos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Eventos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de eliminar este evento?')) { alert('Evento eliminado (Prototipo)'); window.location.reload(); }">Eliminar</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
