@using Prototipo.Common
@model Prototipo.Models.Evento
@{
    ViewBag.Title = "Detalle del Evento";
    ViewBag.Modulo = "Eventos";
}

<div class="module-header">
    <h1>@Model.NombreEvento</h1>
    <a href="@Url.Action("Eventos", "Eventos")" class="btn-secondary">Volver</a>
</div>

<div class="detail-container">
    <div class="detail-section">
        <h3>Datos del evento</h3>
        <div class="detail-grid">
            <div class="detail-item"><label>ID</label><span>@Model.IdEvento</span></div>
            <div class="detail-item"><label>Cliente</label><span>@Model.Cliente.NombreMostrar</span></div>
            <div class="detail-item"><label>Espacio</label><span>@Model.Espacio.NombreEspacio (capacidad @Model.Espacio.CapacidadMaxima)</span></div>
            <div class="detail-item"><label>Fecha</label><span>@Formato.Fecha(Model.FechaEvento)</span></div>
            <div class="detail-item"><label>Horario</label><span>@Formato.Hora(Model.HoraInicio) - @Formato.Hora(Model.HoraFin)</span></div>
            <div class="detail-item"><label>Participantes</label><span>@Model.Participantes</span></div>
            <div class="detail-item"><label>Monto acordado</label><span>@Formato.Colones(Model.MontoAcordado)</span></div>
            <div class="detail-item"><label>Estado</label><span class="@Formato.BadgeEstado(Model.EstadoEvento)">@Model.EstadoEvento</span></div>
            <div class="detail-item-full"><label>Descripcion</label><span>@(string.IsNullOrEmpty(Model.Descripcion) ? "-" : Model.Descripcion)</span></div>
        </div>
    </div>

    <div class="form-actions">
        @if (Model.EstadoEvento != Estados.Evento.Cancelado)
        {
            <a href="@Url.Action("Editar", "Eventos", new { id = Model.IdEvento })" class="btn-primary">Editar</a>
            <a href="@Url.Action("Crear", "Facturacion")" class="btn-secondary">Facturar</a>

            using (Html.BeginForm("Cancelar", "Eventos", new { id = Model.IdEvento }, FormMethod.Post, new { style = "display:inline" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-delete" onclick="return confirm('Cancelar este evento?');">Cancelar evento</button>
            }
        }
    </div>
</div>
