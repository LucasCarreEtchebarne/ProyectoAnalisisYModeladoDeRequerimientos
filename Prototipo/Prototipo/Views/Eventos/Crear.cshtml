@using Prototipo.Common
@model Prototipo.Models.Evento
@{
    ViewBag.Title = "Crear Evento";
    ViewBag.Modulo = "Eventos";
}

<div class="module-header">
    <h1>Crear Nuevo Evento</h1>
    <a href="@Url.Action("Eventos", "Eventos")" class="btn-secondary">Volver</a>
</div>

<div class="form-container">
    @using (Html.BeginForm("Crear", "Eventos", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, null, new { @class = "alert-box alert-warning" })

        <div class="form-group">
            @Html.LabelFor(m => m.NombreEvento)
            @Html.TextBoxFor(m => m.NombreEvento, new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.IdCliente)
            @Html.DropDownListFor(m => m.IdCliente, (SelectList)ViewBag.Clientes,
                "Seleccione un cliente", new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.IdEspacio)
            @Html.DropDownListFor(m => m.IdEspacio, (SelectList)ViewBag.Espacios,
                "Seleccione un espacio", new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.FechaEvento)
            <input type="date" name="FechaEvento" class="form-control" value="@Model.FechaEvento.ToString("yyyy-MM-dd")" required />
        </div>

        <div class="form-row">
            <div class="form-group">
                @Html.LabelFor(m => m.HoraInicio)
                <input type="time" name="HoraInicio" class="form-control" value="@Model.HoraInicio.ToString(@"hh\:mm")" required />
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.HoraFin)
                <input type="time" name="HoraFin" class="form-control" value="@Model.HoraFin.ToString(@"hh\:mm")" required />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                @Html.LabelFor(m => m.Participantes)
                @Html.TextBoxFor(m => m.Participantes, new { @class = "form-control", type = "number", min = "1", required = "required" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.MontoAcordado)
                @Html.TextBoxFor(m => m.MontoAcordado, new { @class = "form-control", type = "number", step = "0.01", min = "0", required = "required" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.EstadoEvento)
            @Html.DropDownListFor(m => m.EstadoEvento,
                new SelectList(Estados.Evento.Todos, Model.EstadoEvento), new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Descripcion)
            @Html.TextBoxFor(m => m.Descripcion, new { @class = "form-control" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Guardar Evento</button>
            <a href="@Url.Action("Eventos", "Eventos")" class="btn-secondary">Cancelar</a>
        </div>
    }
</div>

<div class="info-box">
    <h3>Validaciones que aplica el sistema</h3>
    <ul>
        <li>La hora de fin debe ser posterior a la de inicio</li>
        <li>No se permiten dos eventos traslapados en el mismo espacio y fecha</li>
        <li>Los participantes no pueden superar la capacidad del espacio</li>
        <li>El monto acordado queda congelado para la facturacion</li>
    </ul>
</div>
