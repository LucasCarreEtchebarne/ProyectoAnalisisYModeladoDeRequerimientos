@using Prototipo.Common
@model Prototipo.Models.Usuario
@{
    ViewBag.Title = "Detalle del Usuario";
    ViewBag.Modulo = "Usuarios";
}

<div class="module-header">
    <h1>@Model.NombreCompleto</h1>
    <a href="@Url.Action("Usuarios", "Usuarios")" class="btn-secondary">Volver</a>
</div>

<div class="detail-container">
    <div class="detail-section">
        <h3>Datos del usuario</h3>
        <div class="detail-grid">
            <div class="detail-item"><label>ID</label><span>@Model.IdUsuario</span></div>
            <div class="detail-item"><label>Nombre de usuario</label><span>@Model.NombreUsuario</span></div>
            <div class="detail-item"><label>Correo electronico</label><span>@Model.CorreoElectronico</span></div>
            <div class="detail-item"><label>Rol</label><span>@Model.Rol</span></div>
            <div class="detail-item"><label>Estado</label><span class="@Formato.BadgeEstado(Model.Estado)">@Model.Estado</span></div>
            <div class="detail-item"><label>Intentos fallidos</label><span>@Model.IntentosFallidos</span></div>
            <div class="detail-item"><label>Fecha de bloqueo</label><span>@Formato.FechaHora(Model.FechaBloqueo)</span></div>
            <div class="detail-item"><label>Ultimo acceso</label><span>@Formato.FechaHora(Model.FechaUltimoAcceso)</span></div>
            <div class="detail-item"><label>Creado</label><span>@Formato.FechaHora(Model.FechaCreacion)</span></div>
        </div>
        <p><small>La contrasena no se muestra: la base solo guarda el hash bcrypt.</small></p>
    </div>

    <div class="form-actions">
        <a href="@Url.Action("Editar", "Usuarios", new { id = Model.IdUsuario })" class="btn-primary">Editar</a>
        <a href="@Url.Action("Bitacora", "Bitacora", new { idUsuario = Model.IdUsuario })" class="btn-secondary">Ver bitacora</a>
    </div>
</div>
