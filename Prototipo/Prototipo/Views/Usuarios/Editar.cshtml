@using Prototipo.Common
@model Prototipo.Models.Usuario
@{
    ViewBag.Title = "Editar Usuario";
    ViewBag.Modulo = "Usuarios";
}

<div class="module-header">
    <h1>Editar Usuario</h1>
    <a href="@Url.Action("Usuarios", "Usuarios")" class="btn-secondary">Volver</a>
</div>

<div class="form-container">
    @using (Html.BeginForm("Editar", "Usuarios", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.IdUsuario)
        @Html.ValidationSummary(false, null, new { @class = "alert-box alert-warning" })

        <div class="form-group">
            @Html.LabelFor(m => m.NombreCompleto)
            @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.NombreUsuario)
            @Html.TextBoxFor(m => m.NombreUsuario, new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.CorreoElectronico)
            @Html.TextBoxFor(m => m.CorreoElectronico, new { @class = "form-control", type = "email", required = "required" })
        </div>

        <div class="form-group">
            <label for="contrasenaNueva">Nueva contrasena</label>
            <input type="password" id="contrasenaNueva" name="contrasenaNueva" class="form-control" minlength="8" />
            <small>Dejar en blanco para conservar la contrasena actual.</small>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Rol)
            @Html.DropDownListFor(m => m.Rol, new SelectList(Estados.Roles.Todos, Model.Rol), new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Estado)
            @Html.DropDownListFor(m => m.Estado, new SelectList(Estados.Usuario.Todos, Model.Estado), new { @class = "form-control" })
            @if (Model.Estado == Estados.Usuario.Bloqueado)
            {
                <small>Cambiar el estado a Activo desbloquea la cuenta y reinicia el contador de intentos.</small>
            }
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Guardar Cambios</button>
            <a href="@Url.Action("DetalleUsuario", "Usuarios", new { id = Model.IdUsuario })" class="btn-secondary">Cancelar</a>
        </div>
    }
</div>
