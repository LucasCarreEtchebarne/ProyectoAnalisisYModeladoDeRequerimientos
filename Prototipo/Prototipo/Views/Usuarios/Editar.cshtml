@{
    ViewBag.Title = "Editar Usuario";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El Colibri Hotel & Steak House</title>

    <!-- Custom CSS -->
    <link href="~/Content/Site.css?v=2" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar-main">
        <div class="navbar-main-brand">
            <h2>El Colibri Hotel & Steak House</h2>
            <span class="navbar-subtitle">Sistema de Gestion</span>
        </div>
        <div class="navbar-main-user">
            <span>Admin</span>
            <a href="@Url.Action("Index", "Home")" class="btn-logout">Cerrar Sesion</a>
        </div>
    </nav>

    <!-- Menu de Modulos -->
    <nav class="modules-navbar">
        <a href="@Url.Action("Main", "Main")" class="module-link">Dashboard</a>
        <a href="@Url.Action("Habitaciones", "Habitaciones")" class="module-link">Habitaciones</a>
        <a href="@Url.Action("Reservas", "Reservas")" class="module-link">Reservas</a>
        <a href="@Url.Action("Eventos", "Eventos")" class="module-link">Eventos</a>
        <a href="@Url.Action("Inventario", "Inventario")" class="module-link">Inventario</a>
        <a href="@Url.Action("Mesas", "Mesas")" class="module-link">Punto de Venta</a>
        <a href="@Url.Action("Reportes", "Reportes")" class="module-link">Reportes</a>
        <a href="@Url.Action("Housekeeping", "Housekeeping")" class="module-link">Housekeeping</a>
        <a href="@Url.Action("Facturacion", "Facturacion")" class="module-link">Facturacion</a>
        <a href="@Url.Action("Pagos", "Pagos")" class="module-link">Pagos</a>
        <a href="@Url.Action("Bitacora", "Bitacora")" class="module-link">Bitacora</a>
        <a href="@Url.Action("Clientes", "Clientes")" class="module-link">Clientes</a>
        <a href="@Url.Action("Usuarios", "Usuarios")" class="module-link active">Usuarios</a>
        <a href="@Url.Action("IA", "IA")" class="module-link">IA</a>
    </nav>

    <!-- Contenido Principal -->
    <div class="main-content-area">
        <div class="module-header">
            <h1>Editar Usuario</h1>
            <a href="@Url.Action("Usuarios", "Usuarios")" class="btn-secondary">Volver</a>
        </div>

        <!-- Formulario -->
        <div class="form-container">
            <form>
                <div class="form-group">
                    <label for="idUsuario">ID Usuario</label>
                    <input type="text" id="idUsuario" name="idUsuario" class="form-control" value="1" readonly />
                </div>

                <div class="form-group">
                    <label for="nombreCompleto">Nombre Completo</label>
                    <input type="text" id="nombreCompleto" name="nombreCompleto" class="form-control" value="Juan Perez Gomez" placeholder="Ingrese nombre completo" required />
                </div>

                <div class="form-group">
                    <label for="nombreUsuario">Nombre de Usuario</label>
                    <input type="text" id="nombreUsuario" name="nombreUsuario" class="form-control" value="jperez" placeholder="Ingrese nombre de usuario" required />
                </div>

                <div class="form-group">
                    <label for="correoElectronico">Correo Electronico</label>
                    <input type="email" id="correoElectronico" name="correoElectronico" class="form-control" value="jperez@colibri.com" placeholder="usuario@colibri.com" required />
                </div>

                <div class="form-group">
                    <label for="contrasena">Contrasena (dejar en blanco para mantener actual)</label>
                    <input type="password" id="contrasena" name="contrasena" class="form-control" placeholder="Ingrese nueva contrasena" />
                </div>

                <div class="form-group">
                    <label for="rol">Rol</label>
                    <select id="rol" name="rol" class="form-control" required>
                        <option value="">Seleccione un rol</option>
                        <option value="Administrador" selected>Administrador</option>
                        <option value="Recepcionista">Recepcionista</option>
                        <option value="Gerente">Gerente</option>
                        <option value="Personal">Personal</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="estado">Estado</label>
                    <select id="estado" name="estado" class="form-control" required>
                        <option value="Activo" selected>Activo</option>
                        <option value="Bloqueado">Bloqueado</option>
                        <option value="Inactivo">Inactivo</option>
                    </select>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-primary" onclick="alert('Usuario actualizado exitosamente (Prototipo)'); window.location.href='@Url.Action("Usuarios", "Usuarios")';">Actualizar Usuario</button>
                    <a href="@Url.Action("Usuarios", "Usuarios")" class="btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>

        <!-- Nota informativa -->
        <div class="info-box">
            <h3>Informacion Importante</h3>
            <ul>
                <li>El <strong>ID Usuario</strong> no puede ser modificado</li>
                <li>Si no desea cambiar la contrasena, deje el campo vacio</li>
                <li>Cambiar el <strong>Estado</strong> a "Bloqueado" impedira el acceso del usuario al sistema</li>
                <li>Los cambios se aplicaran inmediatamente al guardar</li>
            </ul>
        </div>
    </div>
</body>
</html>
