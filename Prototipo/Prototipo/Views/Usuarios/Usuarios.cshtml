@using Prototipo.Common
@model List<Prototipo.Models.Usuario>
@{
    ViewBag.Title = "Usuarios";
    ViewBag.Modulo = "Usuarios";
}

<div class="module-header">
    <h1>Gestion de Usuarios</h1>
    <div>
        <a href="@Url.Action("Roles", "Role")" class="btn-secondary">Ver roles</a>
        <a href="@Url.Action("Crear", "Usuarios")" class="btn-primary">Nuevo Usuario</a>
    </div>
</div>

<div class="filter-container">
    @using (Html.BeginForm("Usuarios", "Usuarios", FormMethod.Get))
    {
        <label for="estado">Estado:</label>
        <select id="estado" name="estado" class="filter-select">
            <option value="">Todos</option>
            @foreach (var estado in Estados.Usuario.Todos)
            {
                <option value="@estado" selected="@(((string)ViewBag.Estado) == estado)">@estado</option>
            }
        </select>

        <label for="rol">Rol:</label>
        <select id="rol" name="rol" class="filter-select">
            <option value="">Todos</option>
            @foreach (var rol in Estados.Roles.Todos)
            {
                <option value="@rol" selected="@(((string)ViewBag.Rol) == rol)">@rol</option>
            }
        </select>

        <label for="busqueda">Buscar:</label>
        <input type="text" id="busqueda" name="busqueda" class="filter-select" value="@ViewBag.Busqueda" placeholder="Nombre, usuario o correo" />

        <button type="submit" class="btn-primary">Filtrar</button>
    }
</div>

<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre completo</th>
                <th>Usuario</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Ultimo acceso</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="8">No hay usuarios que coincidan con el filtro.</td></tr>
            }
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.IdUsuario</td>
                    <td>@usuario.NombreCompleto</td>
                    <td>@usuario.NombreUsuario</td>
                    <td>@usuario.CorreoElectronico</td>
                    <td>@usuario.Rol</td>
                    <td>@Formato.FechaHora(usuario.FechaUltimoAcceso)</td>
                    <td>
                        <span class="@Formato.BadgeEstado(usuario.Estado)">@usuario.Estado</span>
                        @if (usuario.IntentosFallidos > 0)
                        {
                            <text>(@usuario.IntentosFallidos intento(s) fallido(s))</text>
                        }
                    </td>
                    <td class="table-actions">
                        <a href="@Url.Action("DetalleUsuario", "Usuarios", new { id = usuario.IdUsuario })" class="btn-view">Consultar</a>
                        <a href="@Url.Action("Editar", "Usuarios", new { id = usuario.IdUsuario })" class="btn-edit">Editar</a>
                        @if (usuario.Estado != Estados.Usuario.Inactivo)
                        {
                            using (Html.BeginForm("Inactivar", "Usuarios", new { id = usuario.IdUsuario }, FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-delete"
                                        onclick="return confirm('El usuario se inactiva, no se elimina. Continuar?');">Inactivar</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
