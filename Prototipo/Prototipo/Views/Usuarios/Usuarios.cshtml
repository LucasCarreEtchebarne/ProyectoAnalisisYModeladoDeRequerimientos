@{
    ViewBag.Title = "Gestion de Usuarios";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El Colibri Hotel & Steak House</title>

    <!-- Custom CSS -->
    <link href="~/Content/Site.css?v=2" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar-main">
        <div class="navbar-main-brand">
            <h2>El Colibri Hotel & Steak House</h2>
            <span class="navbar-subtitle">Sistema de Gestion</span>
        </div>
        <div class="navbar-main-user">
            <span>Admin</span>
            <a href="@Url.Action("Index", "Home")" class="btn-logout">Cerrar Sesion</a>
        </div>
    </nav>

    <!-- Menu de Modulos -->
    <nav class="modules-navbar">
        <a href="@Url.Action("Main", "Main")" class="module-link">Dashboard</a>
        <a href="@Url.Action("Habitaciones", "Habitaciones")" class="module-link">Habitaciones</a>
        <a href="@Url.Action("Reservas", "Reservas")" class="module-link">Reservas</a>
        <a href="@Url.Action("Eventos", "Eventos")" class="module-link">Eventos</a>
        <a href="@Url.Action("Inventario", "Inventario")" class="module-link">Inventario</a>
        <a href="@Url.Action("Mesas", "Mesas")" class="module-link">Punto de Venta</a>
        <a href="@Url.Action("Reportes", "Reportes")" class="module-link">Reportes</a>
        <a href="@Url.Action("Housekeeping", "Housekeeping")" class="module-link">Housekeeping</a>
        <a href="@Url.Action("Facturacion", "Facturacion")" class="module-link">Facturacion</a>
        <a href="@Url.Action("Pagos", "Pagos")" class="module-link">Pagos</a>
        <a href="@Url.Action("Bitacora", "Bitacora")" class="module-link">Bitacora</a>
        <a href="@Url.Action("Clientes", "Clientes")" class="module-link">Clientes</a>
        <a href="@Url.Action("Usuarios", "Usuarios")" class="module-link active">Usuarios</a>
        <a href="@Url.Action("IA", "IA")" class="module-link">IA</a>
    </nav>

    <!-- Contenido Principal -->
    <div class="main-content-area">
        <div class="module-header">
            <h1>Gestion de Usuarios</h1>
            <div style="display: flex; gap: 0.8rem;">
                <a href="@Url.Action("Roles", "Role")" class="btn-secondary">Roles y Permisos</a>
                <a href="@Url.Action("Crear", "Usuarios")" class="btn-primary">Nuevo Usuario</a>
            </div>
        </div>

        <!-- Filtros -->
        <div class="filter-container">
            <label for="filtroRol">Filtrar por Rol:</label>
            <select id="filtroRol" class="filter-select">
                <option value="">Todos</option>
                <option value="Administrador">Administrador</option>
                <option value="Recepcionista">Recepcionista</option>
                <option value="Gerente">Gerente</option>
                <option value="Personal">Personal</option>
            </select>

            <label for="filtroEstado">Filtrar por Estado:</label>
            <select id="filtroEstado" class="filter-select">
                <option value="">Todos</option>
                <option value="Activo">Activo</option>
                <option value="Bloqueado">Bloqueado</option>
                <option value="Inactivo">Inactivo</option>
            </select>
        </div>

        <!-- Tabla de usuarios -->
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre Completo</th>
                        <th>Nombre Usuario</th>
                        <th>Correo Electronico</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>Juan Perez Gomez</td>
                        <td>jperez</td>
                        <td>jperez@colibri.com</td>
                        <td>Administrador</td>
                        <td><span class="badge badge-activo">Activo</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleUsuario", "Usuarios")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Usuarios")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de bloquear este usuario?')) alert('Usuario bloqueado exitosamente (Prototipo)');">Bloquear</button>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Maria Rodriguez Lopez</td>
                        <td>mrodriguez</td>
                        <td>mrodriguez@colibri.com</td>
                        <td>Recepcionista</td>
                        <td><span class="badge badge-activo">Activo</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleUsuario", "Usuarios")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Usuarios")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de bloquear este usuario?')) alert('Usuario bloqueado exitosamente (Prototipo)');">Bloquear</button>
                        </td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>Carlos Sanchez Mora</td>
                        <td>csanchez</td>
                        <td>csanchez@colibri.com</td>
                        <td>Gerente</td>
                        <td><span class="badge badge-bloqueado">Bloqueado</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleUsuario", "Usuarios")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Usuarios")" class="btn-edit">Editar</a>
                            <button class="btn-secondary" onclick="if(confirm('Esta seguro de desbloquear este usuario?')) alert('Usuario desbloqueado exitosamente (Prototipo)');">Desbloquear</button>
                        </td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td>Ana Martinez Cruz</td>
                        <td>amartinez</td>
                        <td>amartinez@colibri.com</td>
                        <td>Personal</td>
                        <td><span class="badge badge-activo">Activo</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleUsuario", "Usuarios")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Usuarios")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de bloquear este usuario?')) alert('Usuario bloqueado exitosamente (Prototipo)');">Bloquear</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
