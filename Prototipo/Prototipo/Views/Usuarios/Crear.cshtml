@using Prototipo.Common
@model Prototipo.Models.Usuario
@{
    ViewBag.Title = "Crear Usuario";
    ViewBag.Modulo = "Usuarios";
}

<div class="module-header">
    <h1>Crear Nuevo Usuario</h1>
    <a href="@Url.Action("Usuarios", "Usuarios")" class="btn-secondary">Volver</a>
</div>

<div class="form-container">
    @using (Html.BeginForm("Crear", "Usuarios", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, null, new { @class = "alert-box alert-warning" })

        <div class="form-group">
            @Html.LabelFor(m => m.NombreCompleto)
            @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.NombreUsuario)
            @Html.TextBoxFor(m => m.NombreUsuario, new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.CorreoElectronico)
            @Html.TextBoxFor(m => m.CorreoElectronico, new { @class = "form-control", type = "email", required = "required" })
        </div>

        <div class="form-group">
            <label for="contrasena">Contrasena</label>
            <input type="password" id="contrasena" name="contrasena" class="form-control" minlength="8" required />
            <small>Minimo 8 caracteres. Se almacena con bcrypt, nunca en texto plano.</small>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Rol)
            @Html.DropDownListFor(m => m.Rol, new SelectList(Estados.Roles.Todos, Model.Rol), new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Estado)
            @Html.DropDownListFor(m => m.Estado, new SelectList(Estados.Usuario.Todos, Model.Estado), new { @class = "form-control" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Guardar Usuario</button>
            <a href="@Url.Action("Usuarios", "Usuarios")" class="btn-secondary">Cancelar</a>
        </div>
    }
</div>

<div class="info-box">
    <h3>Seguridad</h3>
    <ul>
        <li>La contrasena se guarda con <strong>bcrypt</strong>; el sistema nunca la almacena en texto plano</li>
        <li>El nombre de usuario y el correo son unicos</li>
        <li>Tras @Prototipo.Services.UsuarioService.MaximoIntentosFallidos intentos fallidos la cuenta pasa a <strong>Bloqueado</strong></li>
        <li>Los usuarios no se eliminan: se inactivan</li>
    </ul>
</div>
