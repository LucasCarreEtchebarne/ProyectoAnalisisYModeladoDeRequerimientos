@using Prototipo.Common
@model List<Prototipo.Models.Inventario>
@{
    ViewBag.Title = "Alertas de Inventario";
    ViewBag.Modulo = "Inventario";
}

<div class="module-header">
    <h1>Alertas de Inventario</h1>
    <a href="@Url.Action("Inventario", "Inventario")" class="btn-secondary">Volver</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert-box">Ningun producto activo esta en o bajo su stock minimo.</div>
}
else
{
    <div class="alert-box alert-warning">
        @Model.Count producto(s) estan en o bajo el stock minimo. Registre una entrada para reponerlos.
    </div>

    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Categoria</th>
                    <th>Stock actual</th>
                    <th>Stock minimo</th>
                    <th>Faltante</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model)
                {
                    <tr>
                        <td>@producto.NombreProducto</td>
                        <td>@producto.CategoriaProducto</td>
                        <td>@producto.Stock @producto.UnidadMedida</td>
                        <td>@producto.StockMinimo</td>
                        <td>@((producto.StockMinimo - producto.Stock) < 0 ? 0 : producto.StockMinimo - producto.Stock)</td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleProducto", "Inventario", new { id = producto.IdProducto })" class="btn-view">Registrar entrada</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
