@{
    ViewBag.Title = "Alertas de Inventario";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El Colibri Hotel & Steak House</title>

    <!-- Custom CSS -->
    <link href="~/Content/Site.css?v=2" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar-main">
        <div class="navbar-main-brand">
            <h2>El Colibri Hotel & Steak House</h2>
            <span class="navbar-subtitle">Sistema de Gestion</span>
        </div>
        <div class="navbar-main-user">
            <span>Admin</span>
            <a href="@Url.Action("Index", "Home")" class="btn-logout">Cerrar Sesion</a>
        </div>
    </nav>

    <!-- Menu de Modulos -->
    <nav class="modules-navbar">
        <a href="@Url.Action("Main", "Main")" class="module-link">Dashboard</a>
        <a href="@Url.Action("Habitaciones", "Habitaciones")" class="module-link">Habitaciones</a>
        <a href="@Url.Action("Reservas", "Reservas")" class="module-link">Reservas</a>
        <a href="@Url.Action("Eventos", "Eventos")" class="module-link">Eventos</a>
        <a href="@Url.Action("Inventario", "Inventario")" class="module-link active">Inventario</a>
        <a href="@Url.Action("Mesas", "Mesas")" class="module-link">Punto de Venta</a>
        <a href="@Url.Action("Reportes", "Reportes")" class="module-link">Reportes</a>
        <a href="@Url.Action("Housekeeping", "Housekeeping")" class="module-link">Housekeeping</a>
        <a href="@Url.Action("Facturacion", "Facturacion")" class="module-link">Facturacion</a>
        <a href="@Url.Action("Pagos", "Pagos")" class="module-link">Pagos</a>
        <a href="@Url.Action("Bitacora", "Bitacora")" class="module-link">Bitacora</a>
        <a href="@Url.Action("Clientes", "Clientes")" class="module-link">Clientes</a>
        <a href="@Url.Action("Usuarios", "Usuarios")" class="module-link">Usuarios</a>
        <a href="@Url.Action("IA", "IA")" class="module-link">IA</a>
    </nav>

    <!-- Contenido Principal -->
    <div class="main-content-area">
        <div class="module-header">
            <h1>Alertas de Inventario</h1>
            <a href="@Url.Action("Inventario", "Inventario")" class="btn-secondary">Volver al Inventario</a>
        </div>

        <!-- Tabla de Alertas -->
        <div class="table-container">
            <h3>Productos que Requieren Reposicion</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Nombre Producto</th>
                        <th>Categoria</th>
                        <th>Stock Actual</th>
                        <th>Stock Minimo</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>2</td>
                        <td>Shampoo</td>
                        <td>Amenidades</td>
                        <td>30</td>
                        <td>40</td>
                        <td><span class="badge badge-bajostock">Bajo Stock</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleProducto", "Inventario")" class="btn-view">Ver Detalle</a>
                        </td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td>Detergente Industrial</td>
                        <td>Limpieza</td>
                        <td>0</td>
                        <td>15</td>
                        <td><span class="badge badge-agotado">Agotado</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleProducto", "Inventario")" class="btn-view">Ver Detalle</a>
                        </td>
                    </tr>
                    <tr>
                        <td>6</td>
                        <td>Cerveza Artesanal</td>
                        <td>Bebidas</td>
                        <td>25</td>
                        <td>50</td>
                        <td><span class="badge badge-bajostock">Bajo Stock</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleProducto", "Inventario")" class="btn-view">Ver Detalle</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Mensaje informativo -->
        <div class="info-box">
            <h3>Informacion sobre las Alertas</h3>
            <ul>
                <li><strong>Bajo Stock:</strong> Productos cuyo stock actual es menor al stock minimo configurado</li>
                <li><strong>Agotado:</strong> Productos con stock en 0 (cero)</li>
                <li><strong>Recomendacion:</strong> Realizar pedido de reposicion lo antes posible</li>
                <li><strong>Actualizacion:</strong> Las alertas se generan automaticamente al consultar el inventario</li>
            </ul>
        </div>
    </div>
</body>
</html>
