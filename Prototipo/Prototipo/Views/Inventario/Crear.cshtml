@{
    ViewBag.Title = "Agregar Producto";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El Colibri Hotel & Steak House</title>

    <!-- Custom CSS -->
    <link href="~/Content/Site.css?v=2" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar-main">
        <div class="navbar-main-brand">
            <h2>El Colibri Hotel & Steak House</h2>
            <span class="navbar-subtitle">Sistema de Gestion</span>
        </div>
        <div class="navbar-main-user">
            <span>Admin</span>
            <a href="@Url.Action("Index", "Home")" class="btn-logout">Cerrar Sesion</a>
        </div>
    </nav>

    <!-- Menu de Modulos -->
    <nav class="modules-navbar">
        <a href="@Url.Action("Main", "Main")" class="module-link">Dashboard</a>
        <a href="@Url.Action("Habitaciones", "Habitaciones")" class="module-link">Habitaciones</a>
        <a href="@Url.Action("Reservas", "Reservas")" class="module-link">Reservas</a>
        <a href="@Url.Action("Eventos", "Eventos")" class="module-link">Eventos</a>
        <a href="@Url.Action("Inventario", "Inventario")" class="module-link active">Inventario</a>
        <a href="@Url.Action("Mesas", "Mesas")" class="module-link">Punto de Venta</a>
        <a href="@Url.Action("Reportes", "Reportes")" class="module-link">Reportes</a>
        <a href="@Url.Action("Housekeeping", "Housekeeping")" class="module-link">Housekeeping</a>
        <a href="@Url.Action("Facturacion", "Facturacion")" class="module-link">Facturacion</a>
        <a href="@Url.Action("Pagos", "Pagos")" class="module-link">Pagos</a>
        <a href="@Url.Action("Bitacora", "Bitacora")" class="module-link">Bitacora</a>
        <a href="@Url.Action("Clientes", "Clientes")" class="module-link">Clientes</a>
        <a href="@Url.Action("Usuarios", "Usuarios")" class="module-link">Usuarios</a>
        <a href="@Url.Action("IA", "IA")" class="module-link">IA</a>
    </nav>

    <!-- Contenido Principal -->
    <div class="main-content-area">
        <div class="module-header">
            <h1>Agregar Nuevo Producto</h1>
        </div>

        <!-- Formulario de Creacion -->
        <div class="form-container">
            <form class="module-form" method="post" action="@Url.Action("Inventario", "Inventario")">
                <div class="form-row">
                    <div class="form-group">
                        <label for="nombreProducto">Nombre del Producto</label>
                        <input type="text" id="nombreProducto" name="nombreProducto" placeholder="Ej: Toallas de Bano" required />
                    </div>

                    <div class="form-group">
                        <label for="categoria">Categoria</label>
                        <select id="categoria" name="categoria" required>
                            <option value="">Seleccione una categoria...</option>
                            <option value="Alimentos">Alimentos</option>
                            <option value="Bebidas">Bebidas</option>
                            <option value="Limpieza">Limpieza</option>
                            <option value="Amenidades">Amenidades</option>
                            <option value="Cocina">Cocina</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="stock">Stock Inicial</label>
                        <input type="number" id="stock" name="stock" placeholder="Ej: 100" required />
                    </div>

                    <div class="form-group">
                        <label for="stockMinimo">Stock Minimo</label>
                        <input type="number" id="stockMinimo" name="stockMinimo" placeholder="Ej: 20" required />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="fechaIngreso">Fecha de Ingreso</label>
                        <input type="date" id="fechaIngreso" name="fechaIngreso" required />
                    </div>

                    <div class="form-group">
                        <label for="estadoProducto">Estado del Producto</label>
                        <select id="estadoProducto" name="estadoProducto" required>
                            <option value="">Seleccione un estado...</option>
                            <option value="Disponible">Disponible</option>
                            <option value="BajoStock">Bajo Stock</option>
                            <option value="Agotado">Agotado</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label for="descripcion">Descripcion</label>
                    <textarea id="descripcion" name="descripcion" rows="4" placeholder="Descripcion detallada del producto..."></textarea>
                </div>

                <div class="form-actions">
                    <a href="@Url.Action("Inventario", "Inventario")" class="btn-secondary">Cancelar</a>
                    <button type="button" class="btn-primary" onclick="alert('Producto agregado exitosamente (Prototipo)'); window.location.href='@Url.Action("Inventario", "Inventario")';">Guardar Producto</button>
                </div>
            </form>
        </div>

        <!-- Info adicional -->
        <div class="info-box">
            <h3>Informacion</h3>
            <ul>
                <li><strong>Nombre del Producto:</strong> Identificador unico y descriptivo</li>
                <li><strong>Categoria:</strong> Clasificacion del producto para facilitar su gestion</li>
                <li><strong>Stock:</strong> Cantidad inicial disponible en inventario</li>
                <li><strong>Stock Minimo:</strong> Nivel minimo que activa alertas de reposicion</li>
                <li><strong>Estado:</strong> Condicion actual del producto en el sistema</li>
            </ul>
        </div>
    </div>
</body>
</html>
