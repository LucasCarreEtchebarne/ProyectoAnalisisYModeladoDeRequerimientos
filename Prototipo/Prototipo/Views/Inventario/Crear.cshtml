@using Prototipo.Common
@model Prototipo.Models.Inventario
@{
    ViewBag.Title = "Crear Producto";
    ViewBag.Modulo = "Inventario";
}

<div class="module-header">
    <h1>Crear Producto de Inventario</h1>
    <a href="@Url.Action("Inventario", "Inventario")" class="btn-secondary">Volver</a>
</div>

<div class="form-container">
    @using (Html.BeginForm("Crear", "Inventario", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, null, new { @class = "alert-box alert-warning" })

        <div class="form-group">
            @Html.LabelFor(m => m.NombreProducto)
            @Html.TextBoxFor(m => m.NombreProducto, new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.CategoriaProducto)
            @Html.TextBoxFor(m => m.CategoriaProducto, new { @class = "form-control", placeholder = "Granos, Bebidas, Carnes", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.UnidadMedida)
            @Html.TextBoxFor(m => m.UnidadMedida, new { @class = "form-control", placeholder = "Kilogramo, Litro, Unidad", required = "required" })
        </div>

        <div class="form-row">
            <div class="form-group">
                @Html.LabelFor(m => m.Stock)
                @Html.TextBoxFor(m => m.Stock, new { @class = "form-control", type = "number", step = "0.001", min = "0", required = "required" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.StockMinimo)
                @Html.TextBoxFor(m => m.StockMinimo, new { @class = "form-control", type = "number", step = "0.001", min = "0", required = "required" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.EstadoProducto)
            @Html.DropDownListFor(m => m.EstadoProducto,
                new SelectList(Estados.Producto.Todos, Model.EstadoProducto), new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Descripcion)
            @Html.TextBoxFor(m => m.Descripcion, new { @class = "form-control" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Guardar Producto</button>
            <a href="@Url.Action("Inventario", "Inventario")" class="btn-secondary">Cancelar</a>
        </div>
    }
</div>

<div class="info-box">
    <h3>Sobre el stock</h3>
    <ul>
        <li>El stock inicial se guarda como un movimiento de <strong>Entrada</strong> para dejar traza</li>
        <li>Despues, el stock solo cambia por entradas, ajustes o el consumo de recetas al confirmar pedidos</li>
        <li>Cuando el stock llega al minimo el producto aparece en <strong>Alertas</strong></li>
    </ul>
</div>
