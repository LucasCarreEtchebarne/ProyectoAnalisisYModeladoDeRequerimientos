@using Prototipo.Common
@model List<Prototipo.Models.Inventario>
@{
    ViewBag.Title = "Inventario";
    ViewBag.Modulo = "Inventario";
    var categorias = ViewBag.Categorias as List<string> ?? new List<string>();
    var alertas = Model.Count(p => p.StockBajo);
}

<div class="module-header">
    <h1>Gestion de Inventario</h1>
    <div>
        <a href="@Url.Action("Alertas", "Inventario")" class="btn-secondary">Alertas (@alertas)</a>
        <a href="@Url.Action("Crear", "Inventario")" class="btn-primary">Nuevo Producto</a>
    </div>
</div>

<div class="filter-container">
    @using (Html.BeginForm("Inventario", "Inventario", FormMethod.Get))
    {
        <label for="estado">Estado:</label>
        <select id="estado" name="estado" class="filter-select">
            <option value="">Todos</option>
            @foreach (var estado in Estados.Producto.Todos)
            {
                <option value="@estado" selected="@(((string)ViewBag.Estado) == estado)">@estado</option>
            }
        </select>

        <label for="categoria">Categoria:</label>
        <select id="categoria" name="categoria" class="filter-select">
            <option value="">Todas</option>
            @foreach (var categoria in categorias)
            {
                <option value="@categoria" selected="@(((string)ViewBag.Categoria) == categoria)">@categoria</option>
            }
        </select>

        <label for="busqueda">Buscar:</label>
        <input type="text" id="busqueda" name="busqueda" class="filter-select" value="@ViewBag.Busqueda" placeholder="Nombre del producto" />

        <button type="submit" class="btn-primary">Filtrar</button>
    }
</div>

<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Producto</th>
                <th>Categoria</th>
                <th>Stock</th>
                <th>Minimo</th>
                <th>Ingreso</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="8">No hay productos que coincidan con el filtro.</td></tr>
            }
            @foreach (var producto in Model)
            {
                <tr>
                    <td>@producto.IdProducto</td>
                    <td>@producto.NombreProducto</td>
                    <td>@producto.CategoriaProducto</td>
                    <td>
                        @producto.Stock @producto.UnidadMedida
                        @if (producto.StockBajo)
                        {
                            <span class="badge badge-bajostock">Bajo minimo</span>
                        }
                    </td>
                    <td>@producto.StockMinimo</td>
                    <td>@Formato.Fecha(producto.FechaIngreso)</td>
                    <td><span class="@Formato.BadgeEstado(producto.EstadoProducto)">@producto.EstadoProducto</span></td>
                    <td class="table-actions">
                        <a href="@Url.Action("DetalleProducto", "Inventario", new { id = producto.IdProducto })" class="btn-view">Consultar</a>
                        <a href="@Url.Action("Editar", "Inventario", new { id = producto.IdProducto })" class="btn-edit">Editar</a>
                        @if (producto.EstadoProducto == Estados.Producto.Activo)
                        {
                            using (Html.BeginForm("Inactivar", "Inventario", new { id = producto.IdProducto }, FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-delete"
                                        onclick="return confirm('El producto se inactiva, no se elimina. Continuar?');">Inactivar</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
