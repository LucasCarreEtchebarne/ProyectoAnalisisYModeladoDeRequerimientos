@using Prototipo.Common
@model Prototipo.Models.Inventario
@{
    ViewBag.Title = "Detalle del Producto";
    ViewBag.Modulo = "Inventario";
    var movimientos = ViewBag.Movimientos as List<Prototipo.Models.MovimientoInventario>
        ?? new List<Prototipo.Models.MovimientoInventario>();
}

<div class="module-header">
    <h1>@Model.NombreProducto</h1>
    <a href="@Url.Action("Inventario", "Inventario")" class="btn-secondary">Volver</a>
</div>

<div class="detail-container">
    <div class="detail-section">
        <h3>Datos del producto</h3>
        <div class="detail-grid">
            <div class="detail-item"><label>ID</label><span>@Model.IdProducto</span></div>
            <div class="detail-item"><label>Categoria</label><span>@Model.CategoriaProducto</span></div>
            <div class="detail-item"><label>Stock actual</label><span>@Model.Stock @Model.UnidadMedida</span></div>
            <div class="detail-item"><label>Stock minimo</label><span>@Model.StockMinimo @Model.UnidadMedida</span></div>
            <div class="detail-item"><label>Fecha de ingreso</label><span>@Formato.Fecha(Model.FechaIngreso)</span></div>
            <div class="detail-item"><label>Estado</label><span class="@Formato.BadgeEstado(Model.EstadoProducto)">@Model.EstadoProducto</span></div>
            <div class="detail-item-full"><label>Descripcion</label><span>@(string.IsNullOrEmpty(Model.Descripcion) ? "-" : Model.Descripcion)</span></div>
        </div>

        @if (Model.StockBajo)
        {
            <div class="alert-box alert-warning">Este producto esta en o bajo el stock minimo.</div>
        }
    </div>

    <div class="detail-section">
        <h3>Registrar entrada</h3>
        @using (Html.BeginForm("RegistrarEntrada", "Inventario", new { id = Model.IdProducto }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="form-row">
                <div class="form-group">
                    <label for="cantidad">Cantidad (@Model.UnidadMedida)</label>
                    <input type="number" id="cantidad" name="cantidad" class="form-control" step="0.001" min="0.001" required />
                </div>
                <div class="form-group">
                    <label for="motivo">Motivo</label>
                    <input type="text" id="motivo" name="motivo" class="form-control" placeholder="Compra a proveedor" />
                </div>
            </div>
            <button type="submit" class="btn-primary">Registrar entrada</button>
        }
    </div>

    <div class="detail-section">
        <h3>Movimientos</h3>
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Cantidad</th>
                        <th>Stock resultante</th>
                        <th>Pedido</th>
                        <th>Motivo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (movimientos.Count == 0)
                    {
                        <tr><td colspan="6">El producto no tiene movimientos registrados.</td></tr>
                    }
                    @foreach (var movimiento in movimientos)
                    {
                        <tr>
                            <td>@Formato.FechaHora(movimiento.FechaHora)</td>
                            <td>@movimiento.TipoMovimiento</td>
                            <td>@movimiento.Cantidad</td>
                            <td>@movimiento.StockResultante</td>
                            <td>@(movimiento.IdPedido.HasValue ? movimiento.IdPedido.Value.ToString() : "-")</td>
                            <td>@movimiento.Motivo</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="form-actions">
        <a href="@Url.Action("Editar", "Inventario", new { id = Model.IdProducto })" class="btn-primary">Editar</a>
    </div>
</div>
