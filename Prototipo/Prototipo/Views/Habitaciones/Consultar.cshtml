@{
    ViewBag.Title = "Consultar Habitaciones";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El Colibri Hotel & Steak House</title>

    <!-- Custom CSS -->
    <link href="~/Content/Site.css?v=2" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar-main">
        <div class="navbar-main-brand">
            <h2>El Colibri Hotel & Steak House</h2>
            <span class="navbar-subtitle">Sistema de Gestion</span>
        </div>
        <div class="navbar-main-user">
            <span>Admin</span>
            <a href="@Url.Action("Index", "Home")" class="btn-logout">Cerrar Sesion</a>
        </div>
    </nav>

    <!-- Menu de Modulos -->
    <nav class="modules-navbar">
        <a href="@Url.Action("Main", "Main")" class="module-link">Dashboard</a>
        <a href="@Url.Action("Habitaciones", "Habitaciones")" class="module-link active">Habitaciones</a>
        <a href="@Url.Action("Reservas", "Reservas")" class="module-link">Reservas</a>
        <a href="@Url.Action("Eventos", "Eventos")" class="module-link">Eventos</a>
        <a href="@Url.Action("Inventario", "Inventario")" class="module-link">Inventario</a>
        <a href="@Url.Action("Mesas", "Mesas")" class="module-link">Punto de Venta</a>
        <a href="@Url.Action("Reportes", "Reportes")" class="module-link">Reportes</a>
        <a href="@Url.Action("Housekeeping", "Housekeeping")" class="module-link">Housekeeping</a>
        <a href="@Url.Action("Facturacion", "Facturacion")" class="module-link">Facturacion</a>
        <a href="@Url.Action("Pagos", "Pagos")" class="module-link">Pagos</a>
        <a href="@Url.Action("Bitacora", "Bitacora")" class="module-link">Bitacora</a>
        <a href="@Url.Action("Clientes", "Clientes")" class="module-link">Clientes</a>
        <a href="@Url.Action("Usuarios", "Usuarios")" class="module-link">Usuarios</a>
        <a href="@Url.Action("IA", "IA")" class="module-link">IA</a>
    </nav>

    <!-- Contenido Principal -->
    <div class="main-content-area">
        <div class="module-header">
            <h1>Consultar Habitaciones</h1>
            <a href="@Url.Action("Habitaciones", "Habitaciones")" class="btn-secondary">Volver al Listado</a>
        </div>

        <!-- Filtros de Busqueda -->
        <div class="form-container">
            <h3>Filtros de Busqueda</h3>
            <form class="module-form">
                <div class="form-row">
                    <div class="form-group">
                        <label for="filtroNumero">Numero de Habitacion</label>
                        <input type="number" id="filtroNumero" placeholder="Ej: 101" />
                    </div>

                    <div class="form-group">
                        <label for="filtroTipo">Tipo de Habitacion</label>
                        <select id="filtroTipo">
                            <option value="">Todos</option>
                            <option value="Individual">Individual</option>
                            <option value="Doble">Doble</option>
                            <option value="Suite">Suite</option>
                            <option value="Familiar">Familiar</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="filtroEstado">Estado</label>
                        <select id="filtroEstado">
                            <option value="">Todos</option>
                            <option value="Disponible">Disponible</option>
                            <option value="Ocupada">Ocupada</option>
                            <option value="Mantenimiento">Mantenimiento</option>
                            <option value="Limpieza">Limpieza</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="filtroPiso">Piso</label>
                        <input type="text" id="filtroPiso" placeholder="Ej: Primer Piso" />
                    </div>
                </div>
            </form>
        </div>

        <!-- Resultados de la Busqueda -->
        <div class="table-container">
            <h3>Resultados de la Busqueda</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Numero</th>
                        <th>Tipo</th>
                        <th>Capacidad</th>
                        <th>Precio</th>
                        <th>Estado</th>
                        <th>Piso</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>101</td>
                        <td>Individual</td>
                        <td>1</td>
                        <td>$75.00</td>
                        <td><span class="badge badge-disponible">Disponible</span></td>
                        <td>Primer Piso</td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleHabitacion", "Habitaciones")" class="btn-view">Ver Detalle</a>
                        </td>
                    </tr>
                    <tr>
                        <td>201</td>
                        <td>Doble</td>
                        <td>2</td>
                        <td>$120.00</td>
                        <td><span class="badge badge-ocupada">Ocupada</span></td>
                        <td>Segundo Piso</td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleHabitacion", "Habitaciones")" class="btn-view">Ver Detalle</a>
                        </td>
                    </tr>
                    <tr>
                        <td>301</td>
                        <td>Suite</td>
                        <td>4</td>
                        <td>$250.00</td>
                        <td><span class="badge badge-disponible">Disponible</span></td>
                        <td>Tercer Piso</td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleHabitacion", "Habitaciones")" class="btn-view">Ver Detalle</a>
                        </td>
                    </tr>
                    <tr>
                        <td>102</td>
                        <td>Familiar</td>
                        <td>6</td>
                        <td>$180.00</td>
                        <td><span class="badge badge-mantenimiento">Mantenimiento</span></td>
                        <td>Primer Piso</td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleHabitacion", "Habitaciones")" class="btn-view">Ver Detalle</a>
                        </td>
                    </tr>
                    <tr>
                        <td>202</td>
                        <td>Doble</td>
                        <td>2</td>
                        <td>$130.00</td>
                        <td><span class="badge badge-disponible">Disponible</span></td>
                        <td>Segundo Piso</td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleHabitacion", "Habitaciones")" class="btn-view">Ver Detalle</a>
                        </td>
                    </tr>
                    <tr>
                        <td>103</td>
                        <td>Individual</td>
                        <td>1</td>
                        <td>$80.00</td>
                        <td><span class="badge badge-limpieza">Limpieza</span></td>
                        <td>Primer Piso</td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleHabitacion", "Habitaciones")" class="btn-view">Ver Detalle</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
