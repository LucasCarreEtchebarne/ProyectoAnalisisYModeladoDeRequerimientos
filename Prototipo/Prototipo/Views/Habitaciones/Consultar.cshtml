@using Prototipo.Common
@model List<Prototipo.Models.Habitacion>
@{
    ViewBag.Title = "Consultar Disponibilidad";
    ViewBag.Modulo = "Habitaciones";
    var entrada = (DateTime)ViewBag.Entrada;
    var salida = (DateTime)ViewBag.Salida;
    var consultado = ViewBag.Consultado != null && (bool)ViewBag.Consultado;
}

<div class="module-header">
    <h1>Consultar Disponibilidad</h1>
    <a href="@Url.Action("Habitaciones", "Habitaciones")" class="btn-secondary">Volver</a>
</div>

<div class="filter-container">
    @using (Html.BeginForm("Consultar", "Habitaciones", FormMethod.Get))
    {
        <label for="entrada">Entrada:</label>
        <input type="date" id="entrada" name="entrada" class="filter-select" value="@entrada.ToString("yyyy-MM-dd")" required />

        <label for="salida">Salida:</label>
        <input type="date" id="salida" name="salida" class="filter-select" value="@salida.ToString("yyyy-MM-dd")" required />

        <label for="huespedes">Huespedes:</label>
        <input type="number" id="huespedes" name="huespedes" class="filter-select" min="1" max="20" value="@ViewBag.Huespedes" required />

        <button type="submit" class="btn-primary">Consultar</button>
    }
</div>

@if (consultado)
{
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Numero</th>
                    <th>Tipo</th>
                    <th>Capacidad</th>
                    <th>Precio por noche</th>
                    <th>Total estadia</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @{ var noches = (int)(salida - entrada).TotalDays; }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7">No hay habitaciones libres para ese rango de fechas.</td></tr>
                }
                @foreach (var habitacion in Model)
                {
                    <tr>
                        <td>@habitacion.NumeroHabitacion</td>
                        <td>@habitacion.TipoHabitacion</td>
                        <td>@habitacion.Capacidad</td>
                        <td>@Formato.Colones(habitacion.Precio)</td>
                        <td>@Formato.Colones(habitacion.Precio * noches) (@noches noche(s))</td>
                        <td><span class="@Formato.BadgeEstado(habitacion.EstadoHabitacion)">@habitacion.EstadoHabitacion</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("Crear", "Reservas")" class="btn-view">Reservar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="info-box">
    <h3>Como se calcula la disponibilidad</h3>
    <ul>
        <li>Se excluyen las habitaciones con una reserva no cancelada que se traslape con el rango</li>
        <li>Se excluyen las habitaciones en <strong>Mantenimiento</strong></li>
        <li>Solo se muestran habitaciones con capacidad suficiente para los huespedes indicados</li>
    </ul>
</div>
