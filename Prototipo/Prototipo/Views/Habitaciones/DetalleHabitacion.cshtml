@using Prototipo.Common
@model Prototipo.Models.Habitacion
@{
    ViewBag.Title = "Detalle de Habitacion";
    ViewBag.Modulo = "Habitaciones";
}

<div class="module-header">
    <h1>Habitacion @Model.NumeroHabitacion</h1>
    <a href="@Url.Action("Habitaciones", "Habitaciones")" class="btn-secondary">Volver</a>
</div>

<div class="detail-container">
    <div class="detail-section">
        <h3>Datos de la habitacion</h3>
        <div class="detail-grid">
            <div class="detail-item"><label>Numero</label><span>@Model.NumeroHabitacion</span></div>
            <div class="detail-item"><label>Tipo</label><span>@Model.TipoHabitacion</span></div>
            <div class="detail-item"><label>Capacidad</label><span>@Model.Capacidad huesped(es)</span></div>
            <div class="detail-item"><label>Piso</label><span>@Model.Piso</span></div>
            <div class="detail-item"><label>Precio por noche</label><span>@Formato.Colones(Model.Precio)</span></div>
            <div class="detail-item"><label>Estado</label><span class="@Formato.BadgeEstado(Model.EstadoHabitacion)">@Model.EstadoHabitacion</span></div>
            <div class="detail-item-full"><label>Descripcion</label><span>@(string.IsNullOrEmpty(Model.Descripcion) ? "-" : Model.Descripcion)</span></div>
        </div>
    </div>

    <div class="form-actions">
        <a href="@Url.Action("Editar", "Habitaciones", new { id = Model.IdHabitacion })" class="btn-primary">Editar</a>
        <a href="@Url.Action("Crear", "Reservas")" class="btn-secondary">Reservar</a>
    </div>
</div>
