@using Prototipo.Common
@model Prototipo.Models.Habitacion
@{
    ViewBag.Title = "Crear Habitacion";
    ViewBag.Modulo = "Habitaciones";
}

<div class="module-header">
    <h1>Crear Nueva Habitacion</h1>
    <a href="@Url.Action("Habitaciones", "Habitaciones")" class="btn-secondary">Volver</a>
</div>

<div class="form-container">
    @using (Html.BeginForm("Crear", "Habitaciones", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, null, new { @class = "alert-box alert-warning" })

        <div class="form-group">
            @Html.LabelFor(m => m.NumeroHabitacion)
            @Html.TextBoxFor(m => m.NumeroHabitacion, new { @class = "form-control", placeholder = "101", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.TipoHabitacion)
            @Html.TextBoxFor(m => m.TipoHabitacion, new { @class = "form-control", placeholder = "Estandar, Doble, Suite", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Capacidad)
            @Html.TextBoxFor(m => m.Capacidad, new { @class = "form-control", type = "number", min = "1", max = "20", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Precio)
            @Html.TextBoxFor(m => m.Precio, new { @class = "form-control", type = "number", step = "0.01", min = "0", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Piso)
            @Html.TextBoxFor(m => m.Piso, new { @class = "form-control", type = "number", min = "1", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.EstadoHabitacion)
            @Html.DropDownListFor(m => m.EstadoHabitacion,
                new SelectList(Estados.Habitacion.Todos, Model.EstadoHabitacion), new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Descripcion)
            @Html.TextBoxFor(m => m.Descripcion, new { @class = "form-control" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Guardar Habitacion</button>
            <a href="@Url.Action("Habitaciones", "Habitaciones")" class="btn-secondary">Cancelar</a>
        </div>
    }
</div>

<div class="info-box">
    <h3>Informacion Importante</h3>
    <ul>
        <li>El <strong>numero de habitacion</strong> es unico en la base de datos</li>
        <li>El <strong>precio</strong> registrado aqui se congela en cada reserva nueva</li>
        <li>Las habitaciones no se eliminan: pasan a <strong>Mantenimiento</strong></li>
    </ul>
</div>
