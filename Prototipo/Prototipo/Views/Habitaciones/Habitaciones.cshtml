@using Prototipo.Common
@model List<Prototipo.Models.Habitacion>
@{
    ViewBag.Title = "Habitaciones";
    ViewBag.Modulo = "Habitaciones";
    var tipos = ViewBag.Tipos as List<string> ?? new List<string>();
}

<div class="module-header">
    <h1>Gestion de Habitaciones</h1>
    <div>
        <a href="@Url.Action("Consultar", "Habitaciones")" class="btn-secondary">Consultar disponibilidad</a>
        <a href="@Url.Action("Crear", "Habitaciones")" class="btn-primary">Nueva Habitacion</a>
    </div>
</div>

<div class="filter-container">
    @using (Html.BeginForm("Habitaciones", "Habitaciones", FormMethod.Get))
    {
        <label for="estado">Estado:</label>
        <select id="estado" name="estado" class="filter-select">
            <option value="">Todos</option>
            @foreach (var estado in Estados.Habitacion.Todos)
            {
                <option value="@estado" selected="@(((string)ViewBag.Estado) == estado)">@estado</option>
            }
        </select>

        <label for="tipo">Tipo:</label>
        <select id="tipo" name="tipo" class="filter-select">
            <option value="">Todos</option>
            @foreach (var tipo in tipos)
            {
                <option value="@tipo" selected="@(((string)ViewBag.Tipo) == tipo)">@tipo</option>
            }
        </select>

        <button type="submit" class="btn-primary">Filtrar</button>
    }
</div>

<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>Numero</th>
                <th>Tipo</th>
                <th>Capacidad</th>
                <th>Piso</th>
                <th>Precio por noche</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7">No hay habitaciones que coincidan con el filtro.</td></tr>
            }
            @foreach (var habitacion in Model)
            {
                <tr>
                    <td>@habitacion.NumeroHabitacion</td>
                    <td>@habitacion.TipoHabitacion</td>
                    <td>@habitacion.Capacidad</td>
                    <td>@habitacion.Piso</td>
                    <td>@Formato.Colones(habitacion.Precio)</td>
                    <td><span class="@Formato.BadgeEstado(habitacion.EstadoHabitacion)">@habitacion.EstadoHabitacion</span></td>
                    <td class="table-actions">
                        <a href="@Url.Action("DetalleHabitacion", "Habitaciones", new { id = habitacion.IdHabitacion })" class="btn-view">Consultar</a>
                        <a href="@Url.Action("Editar", "Habitaciones", new { id = habitacion.IdHabitacion })" class="btn-edit">Editar</a>
                        @if (habitacion.EstadoHabitacion != Estados.Habitacion.Mantenimiento)
                        {
                            using (Html.BeginForm("Mantenimiento", "Habitaciones", new { id = habitacion.IdHabitacion }, FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-delete"
                                        onclick="return confirm('La habitacion pasara a Mantenimiento. Continuar?');">Mantenimiento</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
