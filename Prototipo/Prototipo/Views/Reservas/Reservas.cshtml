@using Prototipo.Common
@model List<Prototipo.Models.Reserva>
@{
    ViewBag.Title = "Reservas";
    ViewBag.Modulo = "Reservas";
}

<div class="module-header">
    <h1>Gestion de Reservas</h1>
    <a href="@Url.Action("Crear", "Reservas")" class="btn-primary">Nueva Reserva</a>
</div>

<div class="filter-container">
    @using (Html.BeginForm("Reservas", "Reservas", FormMethod.Get))
    {
        <label for="estado">Estado:</label>
        <select id="estado" name="estado" class="filter-select">
            <option value="">Todos</option>
            @foreach (var estado in Estados.Reserva.Todos)
            {
                <option value="@estado" selected="@(((string)ViewBag.Estado) == estado)">@estado</option>
            }
        </select>

        <label for="desde">Desde:</label>
        <input type="date" id="desde" name="desde" class="filter-select"
               value="@(ViewBag.Desde != null ? ((DateTime)ViewBag.Desde).ToString("yyyy-MM-dd") : "")" />

        <label for="hasta">Hasta:</label>
        <input type="date" id="hasta" name="hasta" class="filter-select"
               value="@(ViewBag.Hasta != null ? ((DateTime)ViewBag.Hasta).ToString("yyyy-MM-dd") : "")" />

        <label for="busqueda">Buscar:</label>
        <input type="text" id="busqueda" name="busqueda" class="filter-select"
               value="@ViewBag.Busqueda" placeholder="Cliente o habitacion" />

        <button type="submit" class="btn-primary">Filtrar</button>
    }
</div>

<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Habitacion</th>
                <th>Entrada</th>
                <th>Salida</th>
                <th>Noches</th>
                <th>Huespedes</th>
                <th>Monto</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="10">No hay reservas que coincidan con el filtro.</td></tr>
            }
            @foreach (var reserva in Model)
            {
                <tr>
                    <td>@reserva.IdReserva</td>
                    <td>@reserva.Cliente.NombreMostrar</td>
                    <td>@reserva.Habitacion.NumeroHabitacion</td>
                    <td>@Formato.Fecha(reserva.FechaEntrada)</td>
                    <td>@Formato.Fecha(reserva.FechaSalida)</td>
                    <td>@reserva.CantidadNoches</td>
                    <td>@reserva.CantidadHuespedes</td>
                    <td>@Formato.Colones(reserva.MontoHospedaje)</td>
                    <td><span class="@Formato.BadgeEstado(reserva.EstadoReserva)">@reserva.EstadoReserva</span></td>
                    <td class="table-actions">
                        <a href="@Url.Action("DetalleReserva", "Reservas", new { id = reserva.IdReserva })" class="btn-view">Consultar</a>
                        @if (reserva.EstadoReserva != Estados.Reserva.Cancelada && reserva.EstadoReserva != Estados.Reserva.CheckOut)
                        {
                            <a href="@Url.Action("Editar", "Reservas", new { id = reserva.IdReserva })" class="btn-edit">Editar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
