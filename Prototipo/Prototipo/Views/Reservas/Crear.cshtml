@{
    ViewBag.Title = "Crear Reserva";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El Colibri Hotel & Steak House</title>

    <!-- Custom CSS -->
    <link href="~/Content/Site.css?v=2" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar-main">
        <div class="navbar-main-brand">
            <h2>El Colibri Hotel & Steak House</h2>
            <span class="navbar-subtitle">Sistema de Gestion</span>
        </div>
        <div class="navbar-main-user">
            <span>Admin</span>
            <a href="@Url.Action("Index", "Home")" class="btn-logout">Cerrar Sesion</a>
        </div>
    </nav>

    <!-- Menu de Modulos -->
    <nav class="modules-navbar">
        <a href="@Url.Action("Main", "Main")" class="module-link">Dashboard</a>
        <a href="@Url.Action("Habitaciones", "Habitaciones")" class="module-link">Habitaciones</a>
        <a href="@Url.Action("Reservas", "Reservas")" class="module-link active">Reservas</a>
        <a href="@Url.Action("Eventos", "Eventos")" class="module-link">Eventos</a>
        <a href="@Url.Action("Inventario", "Inventario")" class="module-link">Inventario</a>
        <a href="@Url.Action("Mesas", "Mesas")" class="module-link">Punto de Venta</a>
        <a href="@Url.Action("Reportes", "Reportes")" class="module-link">Reportes</a>
        <a href="@Url.Action("Housekeeping", "Housekeeping")" class="module-link">Housekeeping</a>
        <a href="@Url.Action("Facturacion", "Facturacion")" class="module-link">Facturacion</a>
        <a href="@Url.Action("Pagos", "Pagos")" class="module-link">Pagos</a>
        <a href="@Url.Action("Bitacora", "Bitacora")" class="module-link">Bitacora</a>
        <a href="@Url.Action("Clientes", "Clientes")" class="module-link">Clientes</a>
        <a href="@Url.Action("Usuarios", "Usuarios")" class="module-link">Usuarios</a>
        <a href="@Url.Action("IA", "IA")" class="module-link">IA</a>
    </nav>

    <!-- Contenido Principal -->
    <div class="main-content-area">
        <div class="module-header">
            <h1>Crear Nueva Reserva</h1>
        </div>

        <!-- Formulario de Creacion -->
        <div class="form-container">
            <form class="module-form" method="post" action="@Url.Action("Reservas", "Reservas")">
                <div class="form-row">
                    <div class="form-group">
                        <label for="idHabitacion">ID Habitacion</label>
                        <input type="number" id="idHabitacion" name="idHabitacion" placeholder="Ej: 101" required />
                    </div>

                    <div class="form-group">
                        <label for="idCliente">Cliente</label>
                        <select id="idCliente" name="idCliente" required>
                            <option value="">Seleccione un cliente...</option>
                            <option value="1">Juan Perez</option>
                            <option value="2">Maria Garcia</option>
                            <option value="3">Carlos Lopez</option>
                            <option value="4">Ana Martinez</option>
                            <option value="5">Luis Gonzalez</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="fechaEntrada">Fecha de Entrada</label>
                        <input type="date" id="fechaEntrada" name="fechaEntrada" required />
                    </div>

                    <div class="form-group">
                        <label for="fechaSalida">Fecha de Salida</label>
                        <input type="date" id="fechaSalida" name="fechaSalida" required />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="cantidadHuespedes">Cantidad de Huespedes</label>
                        <input type="number" id="cantidadHuespedes" name="cantidadHuespedes" placeholder="Ej: 2" required />
                    </div>

                    <div class="form-group">
                        <label for="estadoReserva">Estado de Reserva</label>
                        <select id="estadoReserva" name="estadoReserva" required>
                            <option value="">Seleccione un estado...</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Confirmada">Confirmada</option>
                            <option value="Cancelada">Cancelada</option>
                            <option value="Completada">Completada</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label for="observaciones">Observaciones</label>
                    <textarea id="observaciones" name="observaciones" rows="4" placeholder="Ingrese observaciones adicionales de la reserva..."></textarea>
                </div>

                <div class="form-actions">
                    <a href="@Url.Action("Reservas", "Reservas")" class="btn-secondary">Cancelar</a>
                    <button type="button" class="btn-primary" onclick="alert('Reserva creada exitosamente (Prototipo)'); window.location.href='@Url.Action("Reservas", "Reservas")';">Guardar Reserva</button>
                </div>
            </form>
        </div>

        <!-- Info adicional -->
        <div class="info-box">
            <h3>Informacion</h3>
            <ul>
                <li><strong>ID Habitacion:</strong> Numero de la habitacion a reservar</li>
                <li><strong>ID Cliente:</strong> Identificador del cliente</li>
                <li><strong>Fechas:</strong> Periodo de la reserva</li>
                <li><strong>Huespedes:</strong> Cantidad de personas</li>
                <li><strong>Estado:</strong> Estado actual de la reserva</li>
            </ul>
        </div>
    </div>
</body>
</html>
