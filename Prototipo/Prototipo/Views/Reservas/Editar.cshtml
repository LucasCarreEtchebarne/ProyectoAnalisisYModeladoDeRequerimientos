@using Prototipo.Common
@model Prototipo.Models.Reserva
@{
    ViewBag.Title = "Editar Reserva";
    ViewBag.Modulo = "Reservas";
}

<div class="module-header">
    <h1>Editar Reserva #@Model.IdReserva</h1>
    <a href="@Url.Action("Reservas", "Reservas")" class="btn-secondary">Volver</a>
</div>

<div class="form-container">
    @using (Html.BeginForm("Editar", "Reservas", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.IdReserva)
        @Html.HiddenFor(m => m.PrecioNoche)
        @Html.ValidationSummary(false, null, new { @class = "alert-box alert-warning" })

        <div class="form-group">
            @Html.LabelFor(m => m.IdCliente)
            @Html.DropDownListFor(m => m.IdCliente, (SelectList)ViewBag.Clientes, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.IdHabitacion)
            @Html.DropDownListFor(m => m.IdHabitacion, (SelectList)ViewBag.Habitaciones, new { @class = "form-control" })
        </div>

        <div class="form-row">
            <div class="form-group">
                @Html.LabelFor(m => m.FechaEntrada)
                <input type="date" name="FechaEntrada" class="form-control"
                       value="@Model.FechaEntrada.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.FechaSalida)
                <input type="date" name="FechaSalida" class="form-control"
                       value="@Model.FechaSalida.ToString("yyyy-MM-dd")" required />
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.CantidadHuespedes)
            @Html.TextBoxFor(m => m.CantidadHuespedes, new { @class = "form-control", type = "number", min = "1", max = "20", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.EstadoReserva)
            @Html.DropDownListFor(m => m.EstadoReserva,
                new SelectList(Estados.Reserva.Todos, Model.EstadoReserva), new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Observaciones)
            @Html.TextBoxFor(m => m.Observaciones, new { @class = "form-control" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Guardar Cambios</button>
            <a href="@Url.Action("DetalleReserva", "Reservas", new { id = Model.IdReserva })" class="btn-secondary">Cancelar</a>
        </div>
    }
</div>
