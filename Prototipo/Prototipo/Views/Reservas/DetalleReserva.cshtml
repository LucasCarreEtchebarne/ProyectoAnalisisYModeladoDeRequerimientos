@using Prototipo.Common
@model Prototipo.Models.Reserva
@{
    ViewBag.Title = "Detalle de Reserva";
    ViewBag.Modulo = "Reservas";
}

<div class="module-header">
    <h1>Reserva #@Model.IdReserva</h1>
    <a href="@Url.Action("Reservas", "Reservas")" class="btn-secondary">Volver</a>
</div>

<div class="detail-container">
    <div class="detail-section">
        <h3>Datos de la reserva</h3>
        <div class="detail-grid">
            <div class="detail-item"><label>Cliente</label><span>@Model.Cliente.NombreMostrar</span></div>
            <div class="detail-item"><label>Identificacion</label><span>@Model.Cliente.Identificacion</span></div>
            <div class="detail-item"><label>Habitacion</label><span>@Model.Habitacion.NumeroHabitacion - @Model.Habitacion.TipoHabitacion</span></div>
            <div class="detail-item"><label>Estado de la habitacion</label><span class="@Formato.BadgeEstado(Model.Habitacion.EstadoHabitacion)">@Model.Habitacion.EstadoHabitacion</span></div>
            <div class="detail-item"><label>Entrada</label><span>@Formato.Fecha(Model.FechaEntrada)</span></div>
            <div class="detail-item"><label>Salida</label><span>@Formato.Fecha(Model.FechaSalida)</span></div>
            <div class="detail-item"><label>Noches</label><span>@Model.CantidadNoches</span></div>
            <div class="detail-item"><label>Huespedes</label><span>@Model.CantidadHuespedes</span></div>
            <div class="detail-item"><label>Tarifa por noche</label><span>@Formato.Colones(Model.PrecioNoche)</span></div>
            <div class="detail-item"><label>Monto de hospedaje</label><span>@Formato.Colones(Model.MontoHospedaje)</span></div>
            <div class="detail-item"><label>Estado</label><span class="@Formato.BadgeEstado(Model.EstadoReserva)">@Model.EstadoReserva</span></div>
            <div class="detail-item"><label>Registrada</label><span>@Formato.FechaHora(Model.FechaRegistro)</span></div>
            <div class="detail-item-full"><label>Observaciones</label><span>@(string.IsNullOrEmpty(Model.Observaciones) ? "-" : Model.Observaciones)</span></div>
        </div>
    </div>

    <div class="form-actions">
        @if (Model.EstadoReserva == Estados.Reserva.Confirmada)
        {
            using (Html.BeginForm("CheckIn", "Reservas", new { id = Model.IdReserva }, FormMethod.Post, new { style = "display:inline" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-primary">Registrar Check-In</button>
            }
        }

        @if (Model.EstadoReserva == Estados.Reserva.CheckIn)
        {
            using (Html.BeginForm("CheckOut", "Reservas", new { id = Model.IdReserva }, FormMethod.Post, new { style = "display:inline" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-primary"
                        onclick="return confirm('Se dejara la habitacion en Limpieza y se creara la tarea de housekeeping. Continuar?');">
                    Registrar Check-Out
                </button>
            }
        }

        @if (Model.EstadoReserva != Estados.Reserva.Cancelada && Model.EstadoReserva != Estados.Reserva.CheckOut)
        {
            <a href="@Url.Action("Editar", "Reservas", new { id = Model.IdReserva })" class="btn-edit">Editar</a>

            using (Html.BeginForm("Cancelar", "Reservas", new { id = Model.IdReserva }, FormMethod.Post, new { style = "display:inline" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-delete"
                        onclick="return confirm('Cancelar esta reserva?');">Cancelar reserva</button>
            }
        }

        <a href="@Url.Action("Crear", "Facturacion")" class="btn-secondary">Facturar</a>
    </div>
</div>
