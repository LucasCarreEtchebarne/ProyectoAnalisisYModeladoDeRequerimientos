@using Prototipo.Common
@model Prototipo.Models.Bitacora
@{
    ViewBag.Title = "Detalle de Bitacora";
    ViewBag.Modulo = "Bitacora";
    var nombres = Estados.Modulos.Nombres;
}

<div class="module-header">
    <h1>Registro de Bitacora #@Model.IdBitacora</h1>
    <a href="@Url.Action("Bitacora", "Bitacora")" class="btn-secondary">Volver</a>
</div>

<div class="detail-container">
    <div class="detail-section">
        <h3>Datos del registro</h3>
        <div class="detail-grid">
            <div class="detail-item"><label>Fecha y hora</label><span>@Formato.FechaHora(Model.FechaHora)</span></div>
            <div class="detail-item"><label>Usuario</label><span>@Model.Usuario.NombreCompleto (@Model.Usuario.NombreUsuario)</span></div>
            <div class="detail-item"><label>Rol del usuario</label><span>@Model.Usuario.Rol</span></div>
            <div class="detail-item"><label>Modulo</label><span>@Model.Modulo - @(nombres.ContainsKey(Model.Modulo) ? nombres[Model.Modulo] : "")</span></div>
            <div class="detail-item"><label>Accion</label><span>@Model.AccionRealizada</span></div>
            <div class="detail-item"><label>Registro afectado</label><span>@(Model.IdRegistro.HasValue ? Model.IdRegistro.Value.ToString() : "-")</span></div>
            <div class="detail-item-full"><label>Descripcion</label><span>@(string.IsNullOrEmpty(Model.Descripcion) ? "-" : Model.Descripcion)</span></div>
        </div>
    </div>
</div>
