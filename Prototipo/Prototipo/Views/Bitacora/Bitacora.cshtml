@{
    ViewBag.Title = "Bitacora";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El Colibri Hotel & Steak House</title>

    <!-- Custom CSS -->
    <link href="~/Content/Site.css?v=2" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar-main">
        <div class="navbar-main-brand">
            <h2>El Colibri Hotel & Steak House</h2>
            <span class="navbar-subtitle">Sistema de Gestion</span>
        </div>
        <div class="navbar-main-user">
            <span>Admin</span>
            <a href="@Url.Action("Index", "Home")" class="btn-logout">Cerrar Sesion</a>
        </div>
    </nav>

    <!-- Menu de Modulos -->
    <nav class="modules-navbar">
        <a href="@Url.Action("Main", "Main")" class="module-link">Dashboard</a>
        <a href="@Url.Action("Habitaciones", "Habitaciones")" class="module-link">Habitaciones</a>
        <a href="@Url.Action("Reservas", "Reservas")" class="module-link">Reservas</a>
        <a href="@Url.Action("Eventos", "Eventos")" class="module-link">Eventos</a>
        <a href="@Url.Action("Inventario", "Inventario")" class="module-link">Inventario</a>
        <a href="@Url.Action("Mesas", "Mesas")" class="module-link">Punto de Venta</a>
        <a href="@Url.Action("Reportes", "Reportes")" class="module-link">Reportes</a>
        <a href="@Url.Action("Housekeeping", "Housekeeping")" class="module-link">Housekeeping</a>
        <a href="@Url.Action("Facturacion", "Facturacion")" class="module-link">Facturacion</a>
        <a href="@Url.Action("Pagos", "Pagos")" class="module-link">Pagos</a>
        <a href="@Url.Action("Bitacora", "Bitacora")" class="module-link active">Bitacora</a>
        <a href="@Url.Action("Clientes", "Clientes")" class="module-link">Clientes</a>
        <a href="@Url.Action("Usuarios", "Usuarios")" class="module-link">Usuarios</a>
        <a href="@Url.Action("IA", "IA")" class="module-link">IA</a>
    </nav>

    <!-- Contenido Principal -->
    <div class="main-content-area">
        <div class="module-header">
            <h1>Bitacora del Sistema</h1>
        </div>

        <!-- Filtros -->
        <div class="form-container">
            <h3>Filtros de Busqueda</h3>
            <form class="module-form">
                <div class="form-row">
                    <div class="form-group">
                        <label for="filtroModulo">Modulo</label>
                        <select id="filtroModulo">
                            <option value="">Todos</option>
                            <option value="Habitaciones">Habitaciones</option>
                            <option value="Reservas">Reservas</option>
                            <option value="Eventos">Eventos</option>
                            <option value="Inventario">Inventario</option>
                            <option value="Punto de Venta">Punto de Venta</option>
                            <option value="Reportes">Reportes</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="filtroUsuario">Usuario</label>
                        <input type="text" id="filtroUsuario" placeholder="Nombre de usuario..." />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="filtroAccion">Accion Realizada</label>
                        <select id="filtroAccion">
                            <option value="">Todas</option>
                            <option value="Crear">Crear</option>
                            <option value="Editar">Editar</option>
                            <option value="Eliminar">Eliminar</option>
                            <option value="Consultar">Consultar</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="filtroFecha">Fecha</label>
                        <input type="date" id="filtroFecha" />
                    </div>
                </div>
            </form>
        </div>

        <!-- Tabla de Bitacora -->
        <div class="table-container">
            <h3>Registros de Bitacora</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Modulo</th>
                        <th>Usuario</th>
                        <th>Accion Realizada</th>
                        <th>Fecha/Hora</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>101</td>
                        <td>Habitaciones</td>
                        <td>Admin</td>
                        <td>Crear habitacion</td>
                        <td>2024-01-18 10:30:15</td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleBitacora", "Bitacora")" class="btn-view">Ver Detalle</a>
                        </td>
                    </tr>
                    <tr>
                        <td>102</td>
                        <td>Reservas</td>
                        <td>Admin</td>
                        <td>Editar reserva</td>
                        <td>2024-01-18 11:15:42</td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleBitacora", "Bitacora")" class="btn-view">Ver Detalle</a>
                        </td>
                    </tr>
                    <tr>
                        <td>103</td>
                        <td>Eventos</td>
                        <td>Admin</td>
                        <td>Crear evento</td>
                        <td>2024-01-18 12:05:28</td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleBitacora", "Bitacora")" class="btn-view">Ver Detalle</a>
                        </td>
                    </tr>
                    <tr>
                        <td>104</td>
                        <td>Habitaciones</td>
                        <td>Admin</td>
                        <td>Eliminar habitacion</td>
                        <td>2024-01-18 14:20:10</td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleBitacora", "Bitacora")" class="btn-view">Ver Detalle</a>
                        </td>
                    </tr>
                    <tr>
                        <td>105</td>
                        <td>Reservas</td>
                        <td>Admin</td>
                        <td>Consultar reserva</td>
                        <td>2024-01-18 15:45:33</td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleBitacora", "Bitacora")" class="btn-view">Ver Detalle</a>
                        </td>
                    </tr>
                    <tr>
                        <td>106</td>
                        <td>Eventos</td>
                        <td>Admin</td>
                        <td>Editar evento</td>
                        <td>2024-01-18 16:10:05</td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleBitacora", "Bitacora")" class="btn-view">Ver Detalle</a>
                        </td>
                    </tr>
                    <tr>
                        <td>107</td>
                        <td>Inventario</td>
                        <td>Admin</td>
                        <td>Actualizar stock</td>
                        <td>2024-01-18 17:30:20</td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleBitacora", "Bitacora")" class="btn-view">Ver Detalle</a>
                        </td>
                    </tr>
                    <tr>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
