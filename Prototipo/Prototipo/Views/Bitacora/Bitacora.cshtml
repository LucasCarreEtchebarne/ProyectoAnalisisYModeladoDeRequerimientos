@using Prototipo.Common
@model List<Prototipo.Models.Bitacora>
@{
    ViewBag.Title = "Bitacora";
    ViewBag.Modulo = "Bitacora";
    var modulos = ViewBag.Modulos as Dictionary<string, string> ?? new Dictionary<string, string>();
    var usuarios = ViewBag.Usuarios as List<Prototipo.Models.Usuario> ?? new List<Prototipo.Models.Usuario>();
}

<div class="module-header">
    <h1>Bitacora de Auditoria</h1>
</div>

<div class="filter-container">
    @using (Html.BeginForm("Bitacora", "Bitacora", FormMethod.Get))
    {
        <label for="modulo">Modulo:</label>
        <select id="modulo" name="modulo" class="filter-select">
            <option value="">Todos</option>
            @foreach (var modulo in modulos)
            {
                <option value="@modulo.Key" selected="@(((string)ViewBag.ModuloFiltro) == modulo.Key)">@modulo.Key - @modulo.Value</option>
            }
        </select>

        <label for="idUsuario">Usuario:</label>
        <select id="idUsuario" name="idUsuario" class="filter-select">
            <option value="">Todos</option>
            @foreach (var usuario in usuarios)
            {
                <option value="@usuario.IdUsuario" selected="@(ViewBag.IdUsuario != null && (int)ViewBag.IdUsuario == usuario.IdUsuario)">
                    @usuario.NombreCompleto
                </option>
            }
        </select>

        <label for="desde">Desde:</label>
        <input type="date" id="desde" name="desde" class="filter-select"
               value="@(ViewBag.Desde != null ? ((DateTime)ViewBag.Desde).ToString("yyyy-MM-dd") : "")" />

        <label for="hasta">Hasta:</label>
        <input type="date" id="hasta" name="hasta" class="filter-select"
               value="@(ViewBag.Hasta != null ? ((DateTime)ViewBag.Hasta).ToString("yyyy-MM-dd") : "")" />

        <button type="submit" class="btn-primary">Filtrar</button>
    }
</div>

<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Fecha y hora</th>
                <th>Usuario</th>
                <th>Modulo</th>
                <th>Accion</th>
                <th>Registro</th>
                <th>Descripcion</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="8">No hay registros que coincidan con el filtro.</td></tr>
            }
            @foreach (var registro in Model)
            {
                <tr>
                    <td>@registro.IdBitacora</td>
                    <td>@Formato.FechaHora(registro.FechaHora)</td>
                    <td>@registro.Usuario.NombreCompleto</td>
                    <td>@registro.Modulo</td>
                    <td>@registro.AccionRealizada</td>
                    <td>@(registro.IdRegistro.HasValue ? registro.IdRegistro.Value.ToString() : "-")</td>
                    <td>@registro.Descripcion</td>
                    <td class="table-actions">
                        <a href="@Url.Action("DetalleBitacora", "Bitacora", new { id = registro.IdBitacora })" class="btn-view">Consultar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="info-box">
    <h3>Que se registra</h3>
    <ul>
        <li>Inicio y cierre de sesion, creaciones, ediciones, anulaciones y cancelaciones</li>
        <li>Cada registro guarda el usuario, el modulo, el id del registro afectado y la fecha</li>
        <li>La bitacora no se edita ni se elimina desde la aplicacion</li>
    </ul>
</div>
