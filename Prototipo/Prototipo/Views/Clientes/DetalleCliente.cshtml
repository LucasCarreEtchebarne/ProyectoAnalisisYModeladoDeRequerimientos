@using Prototipo.Common
@model Prototipo.Models.Cliente
@{
    ViewBag.Title = "Detalle del Cliente";
    ViewBag.Modulo = "Clientes";
}

<div class="module-header">
    <h1>Detalle del Cliente</h1>
    <a href="@Url.Action("Clientes", "Clientes")" class="btn-secondary">Volver</a>
</div>

<div class="detail-container">
    <div class="detail-section">
        <h3>Datos generales</h3>
        <div class="detail-grid">
            <div class="detail-item"><label>ID Cliente</label><span>@Model.IdCliente</span></div>
            <div class="detail-item"><label>Identificacion</label><span>@Model.Identificacion</span></div>
            <div class="detail-item"><label>Nombre completo</label><span>@Model.NombreMostrar</span></div>
            <div class="detail-item"><label>Telefono</label><span>@(string.IsNullOrEmpty(Model.Telefono) ? "-" : Model.Telefono)</span></div>
            <div class="detail-item"><label>Correo electronico</label><span>@(string.IsNullOrEmpty(Model.CorreoElectronico) ? "-" : Model.CorreoElectronico)</span></div>
            <div class="detail-item"><label>Fecha de registro</label><span>@Formato.Fecha(Model.FechaRegistro)</span></div>
            <div class="detail-item"><label>Estado</label><span class="@Formato.BadgeEstado(Model.EstadoCliente)">@Model.EstadoCliente</span></div>
            <div class="detail-item-full"><label>Direccion</label><span>@(string.IsNullOrEmpty(Model.Direccion) ? "-" : Model.Direccion)</span></div>
        </div>
    </div>

    <div class="form-actions">
        <a href="@Url.Action("Editar", "Clientes", new { id = Model.IdCliente })" class="btn-primary">Editar</a>
        <a href="@Url.Action("Crear", "Reservas")" class="btn-secondary">Nueva reserva</a>
    </div>
</div>
