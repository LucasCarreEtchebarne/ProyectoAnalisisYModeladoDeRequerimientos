                        <td>jose.gonzalez@email.com</td>
                        <td><span class="badge badge-activo">Activo</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleCliente", "Clientes")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Clientes")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de eliminar este cliente?')) alert('Cliente eliminado exitosamente (Prototipo)');">Eliminar</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
