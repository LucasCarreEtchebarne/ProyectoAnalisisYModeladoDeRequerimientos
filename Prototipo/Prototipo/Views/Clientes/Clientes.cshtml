@using Prototipo.Common
@model List<Prototipo.Models.Cliente>
@{
    ViewBag.Title = "Clientes";
    ViewBag.Modulo = "Clientes";
}

<div class="module-header">
    <h1>Gestion de Clientes</h1>
    <a href="@Url.Action("Crear", "Clientes")" class="btn-primary">Nuevo Cliente</a>
</div>

<div class="filter-container">
    @using (Html.BeginForm("Clientes", "Clientes", FormMethod.Get))
    {
        <label for="estado">Filtrar por Estado:</label>
        <select id="estado" name="estado" class="filter-select">
            <option value="">Todos</option>
            @foreach (var estado in Estados.Cliente.Todos)
            {
                <option value="@estado" selected="@(((string)ViewBag.Estado) == estado)">@estado</option>
            }
        </select>

        <label for="busqueda">Buscar Cliente:</label>
        <input type="text" id="busqueda" name="busqueda" class="filter-select"
               value="@ViewBag.Busqueda" placeholder="Nombre, Apellido o Identificacion" />

        <button type="submit" class="btn-primary">Buscar</button>
    }
</div>

<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Identificacion</th>
                <th>Nombre Completo</th>
                <th>Telefono</th>
                <th>Correo Electronico</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7">No hay clientes que coincidan con el filtro.</td></tr>
            }
            @foreach (var cliente in Model)
            {
                <tr>
                    <td>@cliente.IdCliente</td>
                    <td>@cliente.Identificacion</td>
                    <td>@cliente.NombreMostrar</td>
                    <td>@(string.IsNullOrEmpty(cliente.Telefono) ? "-" : cliente.Telefono)</td>
                    <td>@(string.IsNullOrEmpty(cliente.CorreoElectronico) ? "-" : cliente.CorreoElectronico)</td>
                    <td><span class="@Formato.BadgeEstado(cliente.EstadoCliente)">@cliente.EstadoCliente</span></td>
                    <td class="table-actions">
                        <a href="@Url.Action("DetalleCliente", "Clientes", new { id = cliente.IdCliente })" class="btn-view">Consultar</a>
                        <a href="@Url.Action("Editar", "Clientes", new { id = cliente.IdCliente })" class="btn-edit">Editar</a>
                        @if (cliente.EstadoCliente == Estados.Cliente.Activo)
                        {
                            using (Html.BeginForm("Inactivar", "Clientes", new { id = cliente.IdCliente }, FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-delete"
                                        onclick="return confirm('El cliente se inactiva, no se elimina. Continuar?');">Inactivar</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
