@using Prototipo.Common
@model Prototipo.Models.Cliente
@{
    ViewBag.Title = "Crear Cliente";
    ViewBag.Modulo = "Clientes";
}

<div class="module-header">
    <h1>Crear Nuevo Cliente</h1>
    <a href="@Url.Action("Clientes", "Clientes")" class="btn-secondary">Volver</a>
</div>

<div class="form-container">
    @using (Html.BeginForm("Crear", "Clientes", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, null, new { @class = "alert-box alert-warning" })

        <div class="form-group">
            @Html.LabelFor(m => m.Identificacion)
            @Html.TextBoxFor(m => m.Identificacion, new { @class = "form-control", placeholder = "1-1234-0567", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.NombreCompleto)
            @Html.TextBoxFor(m => m.NombreCompleto, new { @class = "form-control", placeholder = "Nombre", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.PrimerApellido)
            @Html.TextBoxFor(m => m.PrimerApellido, new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.SegundoApellido)
            @Html.TextBoxFor(m => m.SegundoApellido, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Telefono)
            @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control", placeholder = "8765-4321" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.CorreoElectronico)
            @Html.TextBoxFor(m => m.CorreoElectronico, new { @class = "form-control", type = "email", placeholder = "cliente@email.com" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Direccion)
            @Html.TextBoxFor(m => m.Direccion, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.EstadoCliente)
            @Html.DropDownListFor(m => m.EstadoCliente,
                new SelectList(Estados.Cliente.Todos, Model.EstadoCliente), new { @class = "form-control" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Guardar Cliente</button>
            <a href="@Url.Action("Clientes", "Clientes")" class="btn-secondary">Cancelar</a>
        </div>
    }
</div>

<div class="info-box">
    <h3>Informacion Importante</h3>
    <ul>
        <li>El <strong>ID Cliente</strong> lo genera la base de datos al guardar</li>
        <li>La <strong>Identificacion</strong> es unica: la base la rechaza si ya existe</li>
        <li>La <strong>Fecha de registro</strong> se asigna automaticamente</li>
        <li>Los clientes no se eliminan: se inactivan para conservar su historial</li>
    </ul>
</div>
