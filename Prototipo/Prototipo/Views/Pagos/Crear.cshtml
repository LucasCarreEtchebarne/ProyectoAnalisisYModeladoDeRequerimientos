@using Prototipo.Common
@model Prototipo.Models.Pago
@{
    ViewBag.Title = "Registrar Pago";
    ViewBag.Modulo = "Pagos";
    var facturas = ViewBag.FacturasPendientes as List<Prototipo.Models.Factura> ?? new List<Prototipo.Models.Factura>();
    var factura = ViewBag.Factura as Prototipo.Models.Factura;
}

<div class="module-header">
    <h1>Registrar Pago</h1>
    <a href="@Url.Action("Pagos", "Pagos")" class="btn-secondary">Volver</a>
</div>

@if (factura != null)
{
    <div class="alert-box">
        Factura @factura.NumeroFactura - @factura.Cliente.NombreMostrar.
        Total @Formato.Colones(factura.MontoTotal), saldo pendiente @Formato.Colones((decimal)ViewBag.Saldo).
    </div>
}

<div class="form-container">
    @using (Html.BeginForm("Crear", "Pagos", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            @Html.LabelFor(m => m.IdFactura)
            <select name="IdFactura" class="form-control" required onchange="location.href='@Url.Action("Crear", "Pagos")?idFactura=' + this.value;">
                <option value="">Seleccione una factura pendiente</option>
                @foreach (var f in facturas)
                {
                    <option value="@f.IdFactura" selected="@(Model.IdFactura == f.IdFactura)">
                        @f.NumeroFactura - @f.Cliente.NombreMostrar - @Formato.Colones(f.MontoTotal)
                    </option>
                }
            </select>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.MetodoPago)
            @Html.DropDownListFor(m => m.MetodoPago,
                new SelectList(Estados.MetodoPago.Todos, Model.MetodoPago), new { @class = "form-control", id = "metodoPago" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.MontoPagado)
            @Html.TextBoxFor(m => m.MontoPagado, new { @class = "form-control", type = "number", step = "0.01", min = "0.01", required = "required" })
        </div>

        <div class="form-row" id="camposEfectivo">
            <div class="form-group">
                @Html.LabelFor(m => m.MontoRecibido)
                @Html.TextBoxFor(m => m.MontoRecibido, new { @class = "form-control", type = "number", step = "0.01", min = "0" })
                <small>El cambio lo calcula el sistema.</small>
            </div>
        </div>

        <div class="form-row" id="camposTarjeta">
            <div class="form-group">
                @Html.LabelFor(m => m.TipoTarjeta)
                <select name="TipoTarjeta" class="form-control">
                    <option value="">Seleccione</option>
                    @foreach (var tipo in Estados.TipoTarjeta.Todos)
                    {
                        <option value="@tipo">@tipo</option>
                    }
                </select>
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.UltimosCuatroDigitos)
                @Html.TextBoxFor(m => m.UltimosCuatroDigitos, new { @class = "form-control", maxlength = "4", pattern = "[0-9]{4}" })
                <small>Nunca se guarda el numero completo de la tarjeta.</small>
            </div>
        </div>

        <div class="form-group" id="campoReferencia">
            @Html.LabelFor(m => m.NumeroReferencia)
            @Html.TextBoxFor(m => m.NumeroReferencia, new { @class = "form-control" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Registrar Pago</button>
            <a href="@Url.Action("Pagos", "Pagos")" class="btn-secondary">Cancelar</a>
        </div>
    }
</div>

<div class="info-box">
    <h3>Reglas de pago</h3>
    <ul>
        <li><strong>Efectivo:</strong> el monto recibido debe cubrir el monto a pagar; el cambio se calcula solo</li>
        <li><strong>Tarjeta:</strong> se exige tipo y ultimos cuatro digitos</li>
        <li><strong>Transferencia y SINPE:</strong> se exige numero de referencia</li>
        <li>El pago no puede superar el saldo pendiente de la factura</li>
        <li>Cuando los pagos aprobados cubren el total, la factura pasa a <strong>Pagada</strong></li>
    </ul>
</div>

@section scripts {
    <script>
        (function () {
            var metodo = document.getElementById('metodoPago');
            var efectivo = document.getElementById('camposEfectivo');
            var tarjeta = document.getElementById('camposTarjeta');
            var referencia = document.getElementById('campoReferencia');

            function actualizar() {
                var valor = metodo.value;
                efectivo.style.display = valor === 'Efectivo' ? '' : 'none';
                tarjeta.style.display = valor === 'Tarjeta' ? '' : 'none';
                referencia.style.display = (valor === 'Transferencia' || valor === 'SINPE') ? '' : 'none';
            }

            metodo.addEventListener('change', actualizar);
            actualizar();
        })();
    </script>
}
