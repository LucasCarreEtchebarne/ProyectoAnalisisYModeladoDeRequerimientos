@using Prototipo.Common
@model Prototipo.Models.Pago
@{
    ViewBag.Title = "Detalle del Pago";
    ViewBag.Modulo = "Pagos";
}

<div class="module-header">
    <h1>Pago #@Model.IdPago</h1>
    <a href="@Url.Action("Pagos", "Pagos")" class="btn-secondary">Volver</a>
</div>

<div class="detail-container">
    <div class="detail-section">
        <h3>Datos del pago</h3>
        <div class="detail-grid">
            <div class="detail-item"><label>Factura</label><span>@Model.Factura.NumeroFactura</span></div>
            <div class="detail-item"><label>Cliente</label><span>@Model.Factura.Cliente.NombreMostrar</span></div>
            <div class="detail-item"><label>Fecha y hora</label><span>@Formato.FechaHora(Model.FechaHoraPago)</span></div>
            <div class="detail-item"><label>Metodo</label><span>@Model.MetodoPago</span></div>
            <div class="detail-item"><label>Monto pagado</label><span>@Formato.Colones(Model.MontoPagado)</span></div>
            @if (Model.MetodoPago == Estados.MetodoPago.Efectivo)
            {
                <div class="detail-item"><label>Monto recibido</label><span>@Formato.Colones(Model.MontoRecibido)</span></div>
                <div class="detail-item"><label>Cambio devuelto</label><span>@Formato.Colones(Model.CambioDevuelto)</span></div>
            }
            @if (Model.MetodoPago == Estados.MetodoPago.Tarjeta)
            {
                <div class="detail-item"><label>Tipo de tarjeta</label><span>@Model.TipoTarjeta</span></div>
                <div class="detail-item"><label>Tarjeta</label><span>**** **** **** @Model.UltimosCuatroDigitos</span></div>
            }
            <div class="detail-item"><label>Referencia</label><span>@(string.IsNullOrEmpty(Model.NumeroReferencia) ? "-" : Model.NumeroReferencia)</span></div>
            <div class="detail-item"><label>Registrado por</label><span>@(Model.Usuario != null ? Model.Usuario.NombreCompleto : "-")</span></div>
            <div class="detail-item"><label>Estado</label><span class="@Formato.BadgeEstado(Model.EstadoPago)">@Model.EstadoPago</span></div>
        </div>
    </div>

    <div class="form-actions">
        <a href="@Url.Action("DetalleFactura", "Facturacion", new { id = Model.IdFactura })" class="btn-secondary">Ver factura</a>
        @if (Model.EstadoPago == Estados.Pago.Aprobado)
        {
            <a href="@Url.Action("Editar", "Pagos", new { id = Model.IdPago })" class="btn-delete">Reversar pago</a>
        }
    </div>
</div>
