@using Prototipo.Common
@model Prototipo.Models.Pago
@{
    ViewBag.Title = "Reversar Pago";
    ViewBag.Modulo = "Pagos";
}

<div class="module-header">
    <h1>Reversar Pago #@Model.IdPago</h1>
    <a href="@Url.Action("DetallePago", "Pagos", new { id = Model.IdPago })" class="btn-secondary">Volver</a>
</div>

<div class="form-container">
    <div class="detail-grid">
        <div class="detail-item"><label>Factura</label><span>@Model.Factura.NumeroFactura</span></div>
        <div class="detail-item"><label>Monto</label><span>@Formato.Colones(Model.MontoPagado)</span></div>
        <div class="detail-item"><label>Metodo</label><span>@Model.MetodoPago</span></div>
        <div class="detail-item"><label>Estado actual</label><span class="@Formato.BadgeEstado(Model.EstadoPago)">@Model.EstadoPago</span></div>
    </div>

    @if (Model.EstadoPago != Estados.Pago.Aprobado)
    {
        <div class="alert-box alert-warning">Solo se puede reversar un pago aprobado.</div>
    }
    else
    {
        using (Html.BeginForm("Reversar", "Pagos", new { id = Model.IdPago }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="motivo">Motivo del reverso</label>
                <input type="text" id="motivo" name="motivo" class="form-control" required />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-delete"
                        onclick="return confirm('El pago quedara reversado y la factura volvera a quedar pendiente. Continuar?');">
                    Reversar pago
                </button>
                <a href="@Url.Action("DetallePago", "Pagos", new { id = Model.IdPago })" class="btn-secondary">Cancelar</a>
            </div>
        }
    }
</div>

<div class="info-box">
    <h3>Por que no se edita un pago</h3>
    <ul>
        <li>Un pago registrado no se modifica: se reversa y se registra uno nuevo</li>
        <li>Al reversar, el saldo de la factura se recalcula automaticamente</li>
    </ul>
</div>
