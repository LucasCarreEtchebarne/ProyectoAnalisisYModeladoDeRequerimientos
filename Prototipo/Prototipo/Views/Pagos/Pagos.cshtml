@using Prototipo.Common
@model List<Prototipo.Models.Pago>
@{
    ViewBag.Title = "Pagos";
    ViewBag.Modulo = "Pagos";
}

<div class="module-header">
    <h1>Gestion de Pagos</h1>
    <a href="@Url.Action("Crear", "Pagos")" class="btn-primary">Registrar Pago</a>
</div>

<div class="filter-container">
    @using (Html.BeginForm("Pagos", "Pagos", FormMethod.Get))
    {
        <label for="metodo">Metodo:</label>
        <select id="metodo" name="metodo" class="filter-select">
            <option value="">Todos</option>
            @foreach (var metodo in Estados.MetodoPago.Todos)
            {
                <option value="@metodo" selected="@(((string)ViewBag.Metodo) == metodo)">@metodo</option>
            }
        </select>

        <label for="estado">Estado:</label>
        <select id="estado" name="estado" class="filter-select">
            <option value="">Todos</option>
            @foreach (var estado in Estados.Pago.Todos)
            {
                <option value="@estado" selected="@(((string)ViewBag.Estado) == estado)">@estado</option>
            }
        </select>

        <label for="desde">Desde:</label>
        <input type="date" id="desde" name="desde" class="filter-select"
               value="@(ViewBag.Desde != null ? ((DateTime)ViewBag.Desde).ToString("yyyy-MM-dd") : "")" />

        <label for="hasta">Hasta:</label>
        <input type="date" id="hasta" name="hasta" class="filter-select"
               value="@(ViewBag.Hasta != null ? ((DateTime)ViewBag.Hasta).ToString("yyyy-MM-dd") : "")" />

        <button type="submit" class="btn-primary">Filtrar</button>
    }
</div>

<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Fecha</th>
                <th>Factura</th>
                <th>Cliente</th>
                <th>Metodo</th>
                <th>Monto</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="8">No hay pagos que coincidan con el filtro.</td></tr>
            }
            @foreach (var pago in Model)
            {
                <tr>
                    <td>@pago.IdPago</td>
                    <td>@Formato.FechaHora(pago.FechaHoraPago)</td>
                    <td>@pago.Factura.NumeroFactura</td>
                    <td>@pago.Factura.Cliente.NombreMostrar</td>
                    <td>
                        @pago.MetodoPago
                        @if (!string.IsNullOrEmpty(pago.UltimosCuatroDigitos))
                        {
                            <text>(****@pago.UltimosCuatroDigitos)</text>
                        }
                    </td>
                    <td>@Formato.Colones(pago.MontoPagado)</td>
                    <td><span class="@Formato.BadgeEstado(pago.EstadoPago)">@pago.EstadoPago</span></td>
                    <td class="table-actions">
                        <a href="@Url.Action("DetallePago", "Pagos", new { id = pago.IdPago })" class="btn-view">Consultar</a>
                        @if (pago.EstadoPago == Estados.Pago.Aprobado)
                        {
                            <a href="@Url.Action("Editar", "Pagos", new { id = pago.IdPago })" class="btn-delete">Reversar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
