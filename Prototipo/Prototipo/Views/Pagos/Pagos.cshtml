@{
    ViewBag.Title = "Pagos";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El Colibri Hotel & Steak House</title>

    <!-- Custom CSS -->
    <link href="~/Content/Site.css?v=2" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar-main">
        <div class="navbar-main-brand">
            <h2>El Colibri Hotel & Steak House</h2>
            <span class="navbar-subtitle">Sistema de Gestion</span>
        </div>
        <div class="navbar-main-user">
            <span>Admin</span>
            <a href="@Url.Action("Index", "Home")" class="btn-logout">Cerrar Sesion</a>
        </div>
    </nav>

    <!-- Menu de Modulos -->
    <nav class="modules-navbar">
        <a href="@Url.Action("Main", "Main")" class="module-link">Dashboard</a>
        <a href="@Url.Action("Habitaciones", "Habitaciones")" class="module-link">Habitaciones</a>
        <a href="@Url.Action("Reservas", "Reservas")" class="module-link">Reservas</a>
        <a href="@Url.Action("Eventos", "Eventos")" class="module-link">Eventos</a>
        <a href="@Url.Action("Inventario", "Inventario")" class="module-link">Inventario</a>
        <a href="@Url.Action("Mesas", "Mesas")" class="module-link">Punto de Venta</a>
        <a href="@Url.Action("Reportes", "Reportes")" class="module-link">Reportes</a>
        <a href="@Url.Action("Housekeeping", "Housekeeping")" class="module-link">Housekeeping</a>
        <a href="@Url.Action("Facturacion", "Facturacion")" class="module-link">Facturacion</a>
        <a href="@Url.Action("Pagos", "Pagos")" class="module-link active">Pagos</a>
        <a href="@Url.Action("Bitacora", "Bitacora")" class="module-link">Bitacora</a>
        <a href="@Url.Action("Clientes", "Clientes")" class="module-link">Clientes</a>
        <a href="@Url.Action("Usuarios", "Usuarios")" class="module-link">Usuarios</a>
        <a href="@Url.Action("IA", "IA")" class="module-link">IA</a>
    </nav>

    <!-- Contenido Principal -->
    <div class="main-content-area">
        <div class="module-header">
            <h1>Gestion de Pagos</h1>
            <a href="@Url.Action("Crear", "Pagos")" class="btn-primary">Registrar Pago</a>
        </div>

        <!-- Resumen -->
        <div class="dashboard-grid">
            <div class="dashboard-card">
                <h3>$42,180</h3>
                <p>Recaudado del Mes</p>
            </div>

            <div class="dashboard-card">
                <h3>$6,140</h3>
                <p>Saldo Pendiente</p>
            </div>

            <div class="dashboard-card">
                <h3>4</h3>
                <p>Pagos en Proceso</p>
            </div>

            <div class="dashboard-card">
                <h3>2</h3>
                <p>Pagos Rechazados</p>
            </div>
        </div>

        <!-- Filtros -->
        <div class="form-container">
            <h3>Filtros de Busqueda</h3>
            <form class="module-form">
                <div class="form-row">
                    <div class="form-group">
                        <label for="filtroMetodoPago">Metodo de Pago</label>
                        <select id="filtroMetodoPago">
                            <option value="">Todos</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="TarjetaCredito">Tarjeta de Credito</option>
                            <option value="TarjetaDebito">Tarjeta de Debito</option>
                            <option value="Transferencia">Transferencia Bancaria</option>
                            <option value="Sinpe">SINPE Movil</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="filtroEstadoPago">Estado del Pago</label>
                        <select id="filtroEstadoPago">
                            <option value="">Todos</option>
                            <option value="Aprobado">Aprobado</option>
                            <option value="Procesando">Procesando</option>
                            <option value="Rechazado">Rechazado</option>
                            <option value="Reembolsado">Reembolsado</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="filtroFechaPago">Fecha del Pago</label>
                        <input type="date" id="filtroFechaPago" />
                    </div>

                    <div class="form-group">
                        <label for="filtroFacturaPago">Numero de Factura</label>
                        <input type="text" id="filtroFacturaPago" placeholder="Ej: FAC-2024-0002" />
                    </div>
                </div>
            </form>
        </div>

        <!-- Tabla de Pagos -->
        <div class="table-container">
            <h3>Pagos Registrados</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID Pago</th>
                        <th>Factura</th>
                        <th>Cliente</th>
                        <th>Metodo</th>
                        <th>Fecha</th>
                        <th>Monto</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>PAG-0085</td>
                        <td>FAC-2024-0001</td>
                        <td>Maria Fernandez</td>
                        <td>Tarjeta de Credito</td>
                        <td>2024-01-15</td>
                        <td>$1,240.00</td>
                        <td><span class="badge badge-aprobado">Aprobado</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetallePago", "Pagos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Pagos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de anular este pago?')) { alert('Pago anulado (Prototipo)'); window.location.reload(); }">Anular</button>
                        </td>
                    </tr>
                    <tr>
                        <td>PAG-0086</td>
                        <td>FAC-2024-0004</td>
                        <td>Ana Lucia Vargas</td>
                        <td>Transferencia Bancaria</td>
                        <td>2024-01-18</td>
                        <td>$2,180.50</td>
                        <td><span class="badge badge-aprobado">Aprobado</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetallePago", "Pagos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Pagos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de anular este pago?')) { alert('Pago anulado (Prototipo)'); window.location.reload(); }">Anular</button>
                        </td>
                    </tr>
                    <tr>
                        <td>PAG-0087</td>
                        <td>FAC-2024-0002</td>
                        <td>Roberto Jimenez</td>
                        <td>Tarjeta de Credito</td>
                        <td>2024-01-16</td>
                        <td>$300.00</td>
                        <td><span class="badge badge-aprobado">Aprobado</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetallePago", "Pagos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Pagos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de anular este pago?')) { alert('Pago anulado (Prototipo)'); window.location.reload(); }">Anular</button>
                        </td>
                    </tr>
                    <tr>
                        <td>PAG-0088</td>
                        <td>FAC-2024-0003</td>
                        <td>Corporacion Delta S.A.</td>
                        <td>Transferencia Bancaria</td>
                        <td>2024-01-24</td>
                        <td>$4,000.00</td>
                        <td><span class="badge badge-procesando">Procesando</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetallePago", "Pagos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Pagos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de anular este pago?')) { alert('Pago anulado (Prototipo)'); window.location.reload(); }">Anular</button>
                        </td>
                    </tr>
                    <tr>
                        <td>PAG-0089</td>
                        <td>FAC-2024-0005</td>
                        <td>Jorge Castillo</td>
                        <td>Tarjeta de Debito</td>
                        <td>2024-01-21</td>
                        <td>$960.00</td>
                        <td><span class="badge badge-rechazado">Rechazado</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetallePago", "Pagos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Pagos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de anular este pago?')) { alert('Pago anulado (Prototipo)'); window.location.reload(); }">Anular</button>
                        </td>
                    </tr>
                    <tr>
                        <td>PAG-0090</td>
                        <td>FAC-2024-0006</td>
                        <td>Patricia Rojas</td>
                        <td>Efectivo</td>
                        <td>2024-01-12</td>
                        <td>$318.00</td>
                        <td><span class="badge badge-reembolsado">Reembolsado</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetallePago", "Pagos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Pagos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de anular este pago?')) { alert('Pago anulado (Prototipo)'); window.location.reload(); }">Anular</button>
                        </td>
                    </tr>
                    <tr>
                        <td>PAG-0091</td>
                        <td>FAC-2024-0007</td>
                        <td>Luis Alberto Mena</td>
                        <td>SINPE Movil</td>
                        <td>2024-01-25</td>
                        <td>$145.00</td>
                        <td><span class="badge badge-procesando">Procesando</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetallePago", "Pagos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Pagos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de anular este pago?')) { alert('Pago anulado (Prototipo)'); window.location.reload(); }">Anular</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
