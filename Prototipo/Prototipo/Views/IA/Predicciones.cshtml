@using Prototipo.Common
@{
    ViewBag.Title = "Proyecciones";
    ViewBag.Modulo = "IA";
    var criticos = ViewBag.InsumosCriticos as List<Prototipo.Models.Inventario> ?? new List<Prototipo.Models.Inventario>();
}

<div class="module-header">
    <h1>Proyecciones Operativas</h1>
    <a href="@Url.Action("IA", "IA")" class="btn-secondary">Volver al asistente</a>
</div>

<div class="dashboard-grid">
    <div class="dashboard-card">
        <h3>@ViewBag.ReservasProximaSemana</h3>
        <p>Reservas con entrada en los proximos 7 dias</p>
    </div>
    <div class="dashboard-card">
        <h3>@ViewBag.OcupacionProyectada %</h3>
        <p>Ocupacion proyectada de la semana</p>
    </div>
    <div class="dashboard-card">
        <h3>@Formato.Colones((decimal)ViewBag.IngresoMesActual)</h3>
        <p>Ingreso acumulado del mes</p>
    </div>
    <div class="dashboard-card">
        <h3>@Formato.Colones((decimal)ViewBag.IngresoProyectado)</h3>
        <p>Proyeccion de cierre del mes</p>
    </div>
    <div class="dashboard-card">
        <h3>@Formato.Colones((decimal)ViewBag.IngresoMesAnterior)</h3>
        <p>Ingreso del mes anterior</p>
    </div>
</div>

<div class="detail-section">
    <h3>Insumos a reponer</h3>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Stock actual</th>
                    <th>Stock minimo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (criticos.Count == 0)
                {
                    <tr><td colspan="4">No hay insumos bajo el minimo.</td></tr>
                }
                @foreach (var producto in criticos)
                {
                    <tr>
                        <td>@producto.NombreProducto</td>
                        <td>@producto.Stock @producto.UnidadMedida</td>
                        <td>@producto.StockMinimo</td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleProducto", "Inventario", new { id = producto.IdProducto })" class="btn-view">Reponer</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="info-box">
    <h3>Como se calculan estas cifras</h3>
    <ul>
        <li><strong>Ocupacion proyectada:</strong> noches comprometidas de la semana entre habitaciones por 7 dias</li>
        <li><strong>Proyeccion de cierre:</strong> proyeccion lineal del ingreso acumulado sobre los dias del mes</li>
        <li>Son estimaciones directas sobre el historico de la base, no un modelo de inferencia</li>
    </ul>
</div>
