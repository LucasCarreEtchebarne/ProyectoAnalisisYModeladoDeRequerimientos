@using Prototipo.Common
@model List<Prototipo.Models.ConsultaIA>
@{
    ViewBag.Title = "Asistente IA";
    ViewBag.Modulo = "IA";
}

<div class="module-header">
    <h1>Asistente de Consultas</h1>
    <a href="@Url.Action("Predicciones", "IA")" class="btn-secondary">Proyecciones</a>
</div>

<div class="ia-grid">
    <div class="ia-card">
        <div class="ia-chat">
            <div class="ia-chat-log">
                @if (TempData["UltimaConsulta"] != null)
                {
                    <div class="ia-mensaje ia-mensaje-usuario">@TempData["UltimaConsulta"]</div>
                    <div class="ia-mensaje ia-mensaje-bot">
                        <pre style="white-space:pre-wrap;margin:0;font-family:inherit">@TempData["UltimaRespuesta"]</pre>
                    </div>
                }
                else
                {
                    <div class="ia-mensaje ia-mensaje-bot">
                        Puede preguntar por habitaciones, reservas, inventario, ingresos,
                        productos mas vendidos, housekeeping o eventos.
                    </div>
                }
            </div>

            @using (Html.BeginForm("Consultar", "IA", FormMethod.Post, new { @class = "ia-chat-input" }))
            {
                @Html.AntiForgeryToken()
                <input type="text" name="consulta" class="form-control"
                       placeholder="Ejemplo: cuantas habitaciones estan disponibles?" required autofocus />
                <button type="submit" class="btn-primary">Consultar</button>
            }
        </div>
    </div>
</div>

<div class="detail-section">
    <h3>Historial de consultas</h3>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Consulta</th>
                    <th>Respuesta</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="3">Todavia no ha realizado consultas.</td></tr>
                }
                @foreach (var consulta in Model)
                {
                    <tr>
                        <td>@Formato.FechaHora(consulta.FechaRealizada)</td>
                        <td>@consulta.ConsultaIngresada</td>
                        <td><pre style="white-space:pre-wrap;margin:0;font-family:inherit">@consulta.RespuestaGenerada</pre></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="info-box">
    <h3>Alcance actual del modulo</h3>
    <ul>
        <li>Las respuestas se calculan con consultas directas a la base HotelColibri</li>
        <li>Toda consulta y su respuesta quedan guardadas en la tabla <strong>CONSULTA_IA</strong></li>
        <li>El proveedor de inferencia todavia no esta definido (pendiente AN02): cuando se
            contrate, solo cambia la generacion de la respuesta, no el registro</li>
    </ul>
</div>
