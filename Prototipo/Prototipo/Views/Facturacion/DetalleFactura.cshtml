@using Prototipo.Common
@model Prototipo.Models.Factura
@{
    ViewBag.Title = "Detalle de Factura";
    ViewBag.Modulo = "Facturacion";
    var pagado = (decimal)ViewBag.TotalPagado;
    var saldo = (decimal)ViewBag.Saldo;
}

<div class="module-header">
    <h1>Factura @Model.NumeroFactura</h1>
    <a href="@Url.Action("Facturacion", "Facturacion")" class="btn-secondary">Volver</a>
</div>

<div class="detail-container">
    <div class="detail-section">
        <h3>Datos de la factura</h3>
        <div class="detail-grid">
            <div class="detail-item"><label>Numero</label><span>@Model.NumeroFactura</span></div>
            <div class="detail-item"><label>Fecha de emision</label><span>@Formato.FechaHora(Model.FechaEmision)</span></div>
            <div class="detail-item"><label>Cliente</label><span>@Model.Cliente.NombreMostrar</span></div>
            <div class="detail-item"><label>Identificacion</label><span>@Model.Cliente.Identificacion</span></div>
            <div class="detail-item"><label>Tipo</label><span>@Model.TipoFactura</span></div>
            <div class="detail-item"><label>Emitida por</label><span>@(Model.Usuario != null ? Model.Usuario.NombreCompleto : "-")</span></div>
            <div class="detail-item"><label>Estado</label><span class="@Formato.BadgeEstado(Model.EstadoFactura)">@Model.EstadoFactura</span></div>
            @if (Model.EstadoFactura == Estados.Factura.Anulada)
            {
                <div class="detail-item"><label>Anulada el</label><span>@Formato.FechaHora(Model.FechaAnulacion)</span></div>
                <div class="detail-item-full"><label>Motivo de anulacion</label><span>@Model.MotivoAnulacion</span></div>
            }
        </div>
    </div>

    <div class="detail-section">
        <h3>Detalle</h3>
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Concepto</th>
                        <th>Descripcion</th>
                        <th>Cantidad</th>
                        <th>Precio unitario</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var linea in Model.Detalles)
                    {
                        <tr>
                            <td>@linea.TipoConcepto</td>
                            <td>@linea.Descripcion</td>
                            <td>@linea.Cantidad</td>
                            <td>@Formato.Colones(linea.PrecioUnitario)</td>
                            <td>@Formato.Colones(linea.Subtotal)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="totales-box">
            <div class="totales-row"><span>Monto total:</span> <strong>@Formato.Colones(Model.MontoTotal)</strong></div>
            <div class="totales-row"><span>Pagado:</span> <strong>@Formato.Colones(pagado)</strong></div>
            <div class="totales-row"><span>Saldo pendiente:</span> <strong>@Formato.Colones(saldo)</strong></div>
        </div>
    </div>

    <div class="detail-section">
        <h3>Pagos</h3>
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Metodo</th>
                        <th>Monto</th>
                        <th>Referencia</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Pagos.Count == 0)
                    {
                        <tr><td colspan="6">La factura no tiene pagos registrados.</td></tr>
                    }
                    @foreach (var pago in Model.Pagos.OrderByDescending(p => p.FechaHoraPago))
                    {
                        <tr>
                            <td>@Formato.FechaHora(pago.FechaHoraPago)</td>
                            <td>
                                @pago.MetodoPago
                                @if (!string.IsNullOrEmpty(pago.UltimosCuatroDigitos))
                                {
                                    <text>(@pago.TipoTarjeta ****@pago.UltimosCuatroDigitos)</text>
                                }
                            </td>
                            <td>@Formato.Colones(pago.MontoPagado)</td>
                            <td>@(string.IsNullOrEmpty(pago.NumeroReferencia) ? "-" : pago.NumeroReferencia)</td>
                            <td><span class="@Formato.BadgeEstado(pago.EstadoPago)">@pago.EstadoPago</span></td>
                            <td class="table-actions">
                                <a href="@Url.Action("DetallePago", "Pagos", new { id = pago.IdPago })" class="btn-view">Consultar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="form-actions">
        @if (Model.EstadoFactura == Estados.Factura.Pendiente)
        {
            <a href="@Url.Action("Crear", "Pagos", new { idFactura = Model.IdFactura })" class="btn-primary">Registrar pago</a>
        }
        @if (Model.EstadoFactura != Estados.Factura.Anulada)
        {
            <a href="@Url.Action("Editar", "Facturacion", new { id = Model.IdFactura })" class="btn-delete">Anular factura</a>
        }
    </div>
</div>
