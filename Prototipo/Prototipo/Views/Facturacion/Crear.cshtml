@using Prototipo.Common
@{
    ViewBag.Title = "Crear Factura";
    ViewBag.Modulo = "Facturacion";
    var pedidos = ViewBag.Pedidos as List<Prototipo.Models.Pedido> ?? new List<Prototipo.Models.Pedido>();
    var reservas = ViewBag.Reservas as List<Prototipo.Models.Reserva> ?? new List<Prototipo.Models.Reserva>();
    var eventos = ViewBag.Eventos as List<Prototipo.Models.Evento> ?? new List<Prototipo.Models.Evento>();
}

<div class="module-header">
    <h1>Emitir Factura</h1>
    <a href="@Url.Action("Facturacion", "Facturacion")" class="btn-secondary">Volver</a>
</div>

<div class="detail-section">
    <h3>Pedidos pendientes de facturar</h3>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Pedido</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Estado</th>
                    <th>Total</th>
                    <th>Accion</th>
                </tr>
            </thead>
            <tbody>
                @if (pedidos.Count == 0)
                {
                    <tr><td colspan="6">No hay pedidos pendientes de facturar.</td></tr>
                }
                @foreach (var pedido in pedidos)
                {
                    <tr>
                        <td>#@pedido.IdPedido</td>
                        <td>@Formato.FechaHora(pedido.FechaHoraPedido)</td>
                        <td>@(pedido.Cliente != null ? pedido.Cliente.NombreMostrar : "-")</td>
                        <td><span class="@Formato.BadgeEstado(pedido.EstadoPedido)">@pedido.EstadoPedido</span></td>
                        <td>@Formato.Colones(pedido.Total)</td>
                        <td>
                            @using (Html.BeginForm("Crear", "Facturacion", FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="origen" value="pedido" />
                                <input type="hidden" name="idOrigen" value="@pedido.IdPedido" />
                                <button type="submit" class="btn-primary">Facturar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="detail-section">
    <h3>Reservas pendientes de facturar</h3>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Reserva</th>
                    <th>Cliente</th>
                    <th>Habitacion</th>
                    <th>Noches</th>
                    <th>Hospedaje</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (reservas.Count == 0)
                {
                    <tr><td colspan="6">No hay reservas pendientes de facturar.</td></tr>
                }
                @foreach (var reserva in reservas)
                {
                    <tr>
                        <td>#@reserva.IdReserva</td>
                        <td>@reserva.Cliente.NombreMostrar</td>
                        <td>@reserva.Habitacion.NumeroHabitacion</td>
                        <td>@reserva.CantidadNoches</td>
                        <td>@Formato.Colones(reserva.MontoHospedaje)</td>
                        <td class="table-actions">
                            @using (Html.BeginForm("Crear", "Facturacion", FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="origen" value="reserva" />
                                <input type="hidden" name="idOrigen" value="@reserva.IdReserva" />
                                <button type="submit" class="btn-primary">Solo hospedaje</button>
                            }
                            @using (Html.BeginForm("Crear", "Facturacion", FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="origen" value="mixta" />
                                <input type="hidden" name="idOrigen" value="@reserva.IdReserva" />
                                <button type="submit" class="btn-edit">Hospedaje + consumos</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="detail-section">
    <h3>Eventos pendientes de facturar</h3>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Evento</th>
                    <th>Cliente</th>
                    <th>Espacio</th>
                    <th>Fecha</th>
                    <th>Monto</th>
                    <th>Accion</th>
                </tr>
            </thead>
            <tbody>
                @if (eventos.Count == 0)
                {
                    <tr><td colspan="6">No hay eventos pendientes de facturar.</td></tr>
                }
                @foreach (var evento in eventos)
                {
                    <tr>
                        <td>@evento.NombreEvento</td>
                        <td>@evento.Cliente.NombreMostrar</td>
                        <td>@evento.Espacio.NombreEspacio</td>
                        <td>@Formato.Fecha(evento.FechaEvento)</td>
                        <td>@Formato.Colones(evento.MontoAcordado)</td>
                        <td>
                            @using (Html.BeginForm("Crear", "Facturacion", FormMethod.Post, new { style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="origen" value="evento" />
                                <input type="hidden" name="idOrigen" value="@evento.IdEvento" />
                                <button type="submit" class="btn-primary">Facturar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="info-box">
    <h3>Como se arma la factura</h3>
    <ul>
        <li>El monto total lo calcula el sistema sumando los subtotales del detalle</li>
        <li><strong>Hospedaje + consumos</strong> genera una factura Mixta con la estadia y los pedidos de esa reserva</li>
        <li>Un pedido, una reserva o un evento solo se pueden facturar una vez</li>
    </ul>
</div>
