@using Prototipo.Common
@model List<Prototipo.Models.Factura>
@{
    ViewBag.Title = "Facturacion";
    ViewBag.Modulo = "Facturacion";
}

<div class="module-header">
    <h1>Gestion de Facturacion</h1>
    <a href="@Url.Action("Crear", "Facturacion")" class="btn-primary">Nueva Factura</a>
</div>

<div class="filter-container">
    @using (Html.BeginForm("Facturacion", "Facturacion", FormMethod.Get))
    {
        <label for="estado">Estado:</label>
        <select id="estado" name="estado" class="filter-select">
            <option value="">Todos</option>
            @foreach (var estado in Estados.Factura.Todos)
            {
                <option value="@estado" selected="@(((string)ViewBag.Estado) == estado)">@estado</option>
            }
        </select>

        <label for="tipo">Tipo:</label>
        <select id="tipo" name="tipo" class="filter-select">
            <option value="">Todos</option>
            @foreach (var tipo in Estados.TipoFactura.Todos)
            {
                <option value="@tipo" selected="@(((string)ViewBag.Tipo) == tipo)">@tipo</option>
            }
        </select>

        <label for="desde">Desde:</label>
        <input type="date" id="desde" name="desde" class="filter-select"
               value="@(ViewBag.Desde != null ? ((DateTime)ViewBag.Desde).ToString("yyyy-MM-dd") : "")" />

        <label for="hasta">Hasta:</label>
        <input type="date" id="hasta" name="hasta" class="filter-select"
               value="@(ViewBag.Hasta != null ? ((DateTime)ViewBag.Hasta).ToString("yyyy-MM-dd") : "")" />

        <label for="busqueda">Buscar:</label>
        <input type="text" id="busqueda" name="busqueda" class="filter-select" value="@ViewBag.Busqueda" placeholder="Numero o cliente" />

        <button type="submit" class="btn-primary">Filtrar</button>
    }
</div>

<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>Numero</th>
                <th>Fecha</th>
                <th>Cliente</th>
                <th>Tipo</th>
                <th>Monto total</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7">No hay facturas que coincidan con el filtro.</td></tr>
            }
            @foreach (var factura in Model)
            {
                <tr>
                    <td>@factura.NumeroFactura</td>
                    <td>@Formato.Fecha(factura.FechaEmision)</td>
                    <td>@factura.Cliente.NombreMostrar</td>
                    <td>@factura.TipoFactura</td>
                    <td>@Formato.Colones(factura.MontoTotal)</td>
                    <td><span class="@Formato.BadgeEstado(factura.EstadoFactura)">@factura.EstadoFactura</span></td>
                    <td class="table-actions">
                        <a href="@Url.Action("DetalleFactura", "Facturacion", new { id = factura.IdFactura })" class="btn-view">Consultar</a>
                        @if (factura.EstadoFactura == Estados.Factura.Pendiente)
                        {
                            <a href="@Url.Action("Crear", "Pagos", new { idFactura = factura.IdFactura })" class="btn-edit">Cobrar</a>
                        }
                        @if (factura.EstadoFactura != Estados.Factura.Anulada)
                        {
                            <a href="@Url.Action("Editar", "Facturacion", new { id = factura.IdFactura })" class="btn-delete">Anular</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
