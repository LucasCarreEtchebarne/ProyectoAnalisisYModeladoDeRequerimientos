@using Prototipo.Common
@model Prototipo.Models.Factura
@{
    ViewBag.Title = "Anular Factura";
    ViewBag.Modulo = "Facturacion";
}

<div class="module-header">
    <h1>Anular Factura @Model.NumeroFactura</h1>
    <a href="@Url.Action("DetalleFactura", "Facturacion", new { id = Model.IdFactura })" class="btn-secondary">Volver</a>
</div>

<div class="form-container">
    <div class="detail-grid">
        <div class="detail-item"><label>Cliente</label><span>@Model.Cliente.NombreMostrar</span></div>
        <div class="detail-item"><label>Monto total</label><span>@Formato.Colones(Model.MontoTotal)</span></div>
        <div class="detail-item"><label>Estado actual</label><span class="@Formato.BadgeEstado(Model.EstadoFactura)">@Model.EstadoFactura</span></div>
    </div>

    @if (Model.EstadoFactura == Estados.Factura.Anulada)
    {
        <div class="alert-box alert-warning">
            Esta factura ya fue anulada el @Formato.FechaHora(Model.FechaAnulacion): @Model.MotivoAnulacion
        </div>
    }
    else
    {
        using (Html.BeginForm("Anular", "Facturacion", new { id = Model.IdFactura }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="motivoAnulacion">Motivo de la anulacion</label>
                <input type="text" id="motivoAnulacion" name="motivoAnulacion" class="form-control"
                       maxlength="250" required placeholder="Indique por que se anula la factura" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-delete"
                        onclick="return confirm('La factura quedara anulada y sus pagos reversados. Continuar?');">
                    Anular factura
                </button>
                <a href="@Url.Action("DetalleFactura", "Facturacion", new { id = Model.IdFactura })" class="btn-secondary">Cancelar</a>
            </div>
        }
    }
</div>

<div class="info-box">
    <h3>Por que no se edita una factura</h3>
    <ul>
        <li>Las facturas no se eliminan ni se modifican: se anulan indicando el motivo</li>
        <li>La base exige el motivo cuando el estado pasa a Anulada</li>
        <li>Los pagos aprobados de la factura quedan en estado Reversado</li>
    </ul>
</div>
