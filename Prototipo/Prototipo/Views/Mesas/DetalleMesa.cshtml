@using Prototipo.Common
@model Prototipo.Models.Mesa
@{
    ViewBag.Title = "Detalle de Mesa";
    ViewBag.Modulo = "Mesas";
    var pedidos = ViewBag.Pedidos as List<Prototipo.Models.Pedido> ?? new List<Prototipo.Models.Pedido>();
    var estados = ViewBag.Estados as string[] ?? new string[0];
}

<div class="module-header">
    <h1>Mesa @Model.NumeroMesa</h1>
    <a href="@Url.Action("Mesas", "Mesas")" class="btn-secondary">Volver</a>
</div>

<div class="detail-container">
    <div class="detail-section">
        <h3>Datos de la mesa</h3>
        <div class="detail-grid">
            <div class="detail-item"><label>Numero</label><span>@Model.NumeroMesa</span></div>
            <div class="detail-item"><label>Capacidad</label><span>@Model.Capacidad persona(s)</span></div>
            <div class="detail-item"><label>Estado</label><span class="@Formato.BadgeEstado(Model.EstadoMesa)">@Model.EstadoMesa</span></div>
            <div class="detail-item-full"><label>Descripcion</label><span>@(string.IsNullOrEmpty(Model.Descripcion) ? "-" : Model.Descripcion)</span></div>
        </div>
    </div>

    <div class="detail-section">
        <h3>Cambiar estado</h3>
        @using (Html.BeginForm("CambiarEstado", "Mesas", new { id = Model.IdMesa }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="form-group">
                <select name="estado" class="form-control">
                    @foreach (var estado in estados)
                    {
                        <option value="@estado" selected="@(Model.EstadoMesa == estado)">@estado</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn-primary">Aplicar</button>
        }
    </div>

    <div class="detail-section">
        <h3>Pedidos recientes</h3>
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (pedidos.Count == 0)
                    {
                        <tr><td colspan="4">La mesa no tiene pedidos registrados.</td></tr>
                    }
                    @foreach (var pedido in pedidos)
                    {
                        <tr>
                            <td>@pedido.IdPedido</td>
                            <td>@Formato.FechaHora(pedido.FechaHoraPedido)</td>
                            <td><span class="@Formato.BadgeEstado(pedido.EstadoPedido)">@pedido.EstadoPedido</span></td>
                            <td class="table-actions">
                                <a href="@Url.Action("DetallePedido", "Pedidos", new { id = pedido.IdPedido })" class="btn-view">Consultar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="form-actions">
        <a href="@Url.Action("Crear", "Pedidos", new { idMesa = Model.IdMesa })" class="btn-primary">Tomar pedido</a>
    </div>
</div>
