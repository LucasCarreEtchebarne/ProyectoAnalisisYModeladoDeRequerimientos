@using Prototipo.Common
@model List<Prototipo.Models.Mesa>
@{
    ViewBag.Title = "Punto de Venta";
    ViewBag.Modulo = "Mesas";
}

<div class="module-header">
    <h1>Punto de Venta - Mesas</h1>
    <a href="@Url.Action("Crear", "Pedidos")" class="btn-primary">Nuevo Pedido</a>
</div>

<div class="filter-container">
    @using (Html.BeginForm("Mesas", "Mesas", FormMethod.Get))
    {
        <label for="estado">Estado:</label>
        <select id="estado" name="estado" class="filter-select">
            <option value="">Todas</option>
            @foreach (var estado in Estados.Mesa.Todos)
            {
                <option value="@estado" selected="@(((string)ViewBag.Estado) == estado)">@estado</option>
            }
        </select>
        <button type="submit" class="btn-primary">Filtrar</button>
    }
</div>

<div class="mesas-grid">
    @foreach (var mesa in Model)
    {
        <div class="mesa-card">
            <h3>Mesa @mesa.NumeroMesa</h3>
            <p>Capacidad: @mesa.Capacidad persona(s)</p>
            <p><span class="@Formato.BadgeEstado(mesa.EstadoMesa)">@mesa.EstadoMesa</span></p>
            @if (!string.IsNullOrEmpty(mesa.Descripcion))
            {
                <p>@mesa.Descripcion</p>
            }
            <div class="mesa-card-actions">
                <a href="@Url.Action("DetalleMesa", "Mesas", new { id = mesa.IdMesa })" class="btn-view">Consultar</a>
                @if (mesa.EstadoMesa != Estados.Mesa.Ocupada)
                {
                    <a href="@Url.Action("Crear", "Pedidos", new { idMesa = mesa.IdMesa })" class="btn-primary">Tomar pedido</a>
                }
            </div>
        </div>
    }
    @if (Model.Count == 0)
    {
        <p>No hay mesas registradas.</p>
    }
</div>
