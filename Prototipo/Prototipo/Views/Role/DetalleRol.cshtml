@using Prototipo.Common
@model List<Prototipo.Models.Usuario>
@{
    ViewBag.Title = "Detalle del Rol";
    ViewBag.Modulo = "Usuarios";
}

<div class="module-header">
    <h1>Rol: @ViewBag.Rol</h1>
    <a href="@Url.Action("Roles", "Role")" class="btn-secondary">Volver</a>
</div>

<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Nombre completo</th>
                <th>Correo</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="5">No hay usuarios con este rol.</td></tr>
            }
            @foreach (var usuario in Model)
            {
                <tr>
                    <td>@usuario.NombreUsuario</td>
                    <td>@usuario.NombreCompleto</td>
                    <td>@usuario.CorreoElectronico</td>
                    <td><span class="@Formato.BadgeEstado(usuario.Estado)">@usuario.Estado</span></td>
                    <td class="table-actions">
                        <a href="@Url.Action("DetalleUsuario", "Usuarios", new { id = usuario.IdUsuario })" class="btn-view">Consultar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
