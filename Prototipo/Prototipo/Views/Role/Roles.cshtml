@model string[]
@{
    ViewBag.Title = "Roles";
    ViewBag.Modulo = "Usuarios";
    var conteos = ViewBag.Conteos as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<div class="module-header">
    <h1>Roles del Sistema</h1>
    <a href="@Url.Action("Usuarios", "Usuarios")" class="btn-secondary">Volver a Usuarios</a>
</div>

<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>Rol</th>
                <th>Usuarios asignados</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rol in Model)
            {
                <tr>
                    <td>@rol</td>
                    <td>@(conteos.ContainsKey(rol) ? conteos[rol] : 0)</td>
                    <td class="table-actions">
                        <a href="@Url.Action("DetalleRol", "Role", new { rol = rol })" class="btn-view">Ver usuarios</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="info-box">
    <h3>Por que los roles no se crean aqui</h3>
    <ul>
        <li>Los roles no son una tabla: son el CHECK de <strong>USUARIO.Rol</strong> en la base de datos</li>
        <li>Agregar un rol nuevo exige modificar ese CHECK en el script de la base</li>
        <li>Para cambiar el rol de una persona use el modulo de <strong>Usuarios</strong></li>
    </ul>
</div>
