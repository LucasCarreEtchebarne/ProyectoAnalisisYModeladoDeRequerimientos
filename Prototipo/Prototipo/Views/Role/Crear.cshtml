@{
    ViewBag.Title = "Crear Rol";
    ViewBag.Modulo = "Usuarios";
}

<div class="module-header">
    <h1>Crear Rol</h1>
    <a href="@Url.Action("Roles", "Role")" class="btn-secondary">Volver</a>
</div>

<div class="info-box">
    <h3>Los roles no se crean desde la aplicacion</h3>
    <ul>
        <li>Los roles son el CHECK de la columna <strong>USUARIO.Rol</strong> en la base de datos</li>
        <li>Para agregar un rol hay que modificar ese CHECK en el script HotelColibri_BD.sql</li>
    </ul>
</div>
