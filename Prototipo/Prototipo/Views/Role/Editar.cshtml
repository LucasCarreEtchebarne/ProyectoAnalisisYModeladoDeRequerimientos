@{
    ViewBag.Title = "Editar Rol";
    ViewBag.Modulo = "Usuarios";
}

<div class="module-header">
    <h1>Editar Rol</h1>
    <a href="@Url.Action("Roles", "Role")" class="btn-secondary">Volver</a>
</div>

<div class="info-box">
    <h3>Los roles no se editan desde la aplicacion</h3>
    <ul>
        <li>Para cambiar el rol de una persona use el modulo de <strong>Usuarios</strong></li>
        <li>Para cambiar la lista de roles hay que modificar el CHECK de USUARIO.Rol en la base</li>
    </ul>
</div>
