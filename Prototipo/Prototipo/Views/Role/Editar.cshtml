@{
    ViewBag.Title = "Editar Rol";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El Colibri Hotel & Steak House</title>

    <!-- Custom CSS -->
    <link href="~/Content/Site.css?v=2" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar-main">
        <div class="navbar-main-brand">
            <h2>El Colibri Hotel & Steak House</h2>
            <span class="navbar-subtitle">Sistema de Gestion</span>
        </div>
        <div class="navbar-main-user">
            <span>Admin</span>
            <a href="@Url.Action("Index", "Home")" class="btn-logout">Cerrar Sesion</a>
        </div>
    </nav>

    <!-- Menu de Modulos -->
    <nav class="modules-navbar">
        <a href="@Url.Action("Main", "Main")" class="module-link">Dashboard</a>
        <a href="@Url.Action("Habitaciones", "Habitaciones")" class="module-link">Habitaciones</a>
        <a href="@Url.Action("Reservas", "Reservas")" class="module-link">Reservas</a>
        <a href="@Url.Action("Eventos", "Eventos")" class="module-link">Eventos</a>
        <a href="@Url.Action("Inventario", "Inventario")" class="module-link">Inventario</a>
        <a href="@Url.Action("Mesas", "Mesas")" class="module-link">Punto de Venta</a>
        <a href="@Url.Action("Reportes", "Reportes")" class="module-link">Reportes</a>
        <a href="@Url.Action("Housekeeping", "Housekeeping")" class="module-link">Housekeeping</a>
        <a href="@Url.Action("Facturacion", "Facturacion")" class="module-link">Facturacion</a>
        <a href="@Url.Action("Pagos", "Pagos")" class="module-link">Pagos</a>
        <a href="@Url.Action("Bitacora", "Bitacora")" class="module-link">Bitacora</a>
        <a href="@Url.Action("Clientes", "Clientes")" class="module-link">Clientes</a>
        <a href="@Url.Action("Usuarios", "Usuarios")" class="module-link active">Usuarios</a>
        <a href="@Url.Action("IA", "IA")" class="module-link">IA</a>
    </nav>

    <!-- Contenido Principal -->
    <div class="main-content-area">
        <div class="module-header">
            <h1>Editar Rol: Recepcionista</h1>
        </div>

        <!-- Formulario de Edicion -->
        <div class="form-container">
            <form class="module-form" method="post" action="@Url.Action("Roles", "Role")">
                <div class="form-row">
                    <div class="form-group">
                        <label for="nombreRol">Nombre del Rol</label>
                        <input type="text" id="nombreRol" name="nombreRol" value="Recepcionista" required />
                    </div>

                    <div class="form-group">
                        <label for="estadoRol">Estado</label>
                        <select id="estadoRol" name="estadoRol" required>
                            <option value="Activo" selected>Activo</option>
                            <option value="Inactivo">Inactivo</option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label for="descripcionRol">Descripcion</label>
                    <textarea id="descripcionRol" name="descripcionRol" rows="3">Gestion de reservas, clientes y habitaciones. Puede registrar check-in y check-out, pero no accede a informacion financiera ni a la configuracion del sistema.</textarea>
                </div>
            </form>
        </div>

        <!-- Matriz de Permisos -->
        <div class="table-container">
            <h3>Permisos por Modulo</h3>
            <table class="data-table permisos-tabla">
                <thead>
                    <tr>
                        <th>Modulo</th>
                        <th>Consultar</th>
                        <th>Crear</th>
                        <th>Editar</th>
                        <th>Eliminar</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Habitaciones</td>
                        <td><input type="checkbox" name="habitaciones_consultar" checked /></td>
                        <td><input type="checkbox" name="habitaciones_crear" /></td>
                        <td><input type="checkbox" name="habitaciones_editar" checked /></td>
                        <td><input type="checkbox" name="habitaciones_eliminar" /></td>
                    </tr>
                    <tr>
                        <td>Reservas</td>
                        <td><input type="checkbox" name="reservas_consultar" checked /></td>
                        <td><input type="checkbox" name="reservas_crear" checked /></td>
                        <td><input type="checkbox" name="reservas_editar" checked /></td>
                        <td><input type="checkbox" name="reservas_eliminar" checked /></td>
                    </tr>
                    <tr>
                        <td>Eventos</td>
                        <td><input type="checkbox" name="eventos_consultar" checked /></td>
                        <td><input type="checkbox" name="eventos_crear" /></td>
                        <td><input type="checkbox" name="eventos_editar" /></td>
                        <td><input type="checkbox" name="eventos_eliminar" /></td>
                    </tr>
                    <tr>
                        <td>Inventario</td>
                        <td><input type="checkbox" name="inventario_consultar" /></td>
                        <td><input type="checkbox" name="inventario_crear" /></td>
                        <td><input type="checkbox" name="inventario_editar" /></td>
                        <td><input type="checkbox" name="inventario_eliminar" /></td>
                    </tr>
                    <tr>
                        <td>Punto de Venta</td>
                        <td><input type="checkbox" name="pdv_consultar" checked /></td>
                        <td><input type="checkbox" name="pdv_crear" checked /></td>
                        <td><input type="checkbox" name="pdv_editar" /></td>
                        <td><input type="checkbox" name="pdv_eliminar" /></td>
                    </tr>
                    <tr>
                        <td>Reportes</td>
                        <td><input type="checkbox" name="reportes_consultar" /></td>
                        <td><input type="checkbox" name="reportes_crear" /></td>
                        <td><input type="checkbox" name="reportes_editar" /></td>
                        <td><input type="checkbox" name="reportes_eliminar" /></td>
                    </tr>
                    <tr>
                        <td>Housekeeping</td>
                        <td><input type="checkbox" name="housekeeping_consultar" checked /></td>
                        <td><input type="checkbox" name="housekeeping_crear" /></td>
                        <td><input type="checkbox" name="housekeeping_editar" /></td>
                        <td><input type="checkbox" name="housekeeping_eliminar" /></td>
                    </tr>
                    <tr>
                        <td>Facturacion</td>
                        <td><input type="checkbox" name="facturacion_consultar" /></td>
                        <td><input type="checkbox" name="facturacion_crear" /></td>
                        <td><input type="checkbox" name="facturacion_editar" /></td>
                        <td><input type="checkbox" name="facturacion_eliminar" /></td>
                    </tr>
                    <tr>
                        <td>Pagos</td>
                        <td><input type="checkbox" name="pagos_consultar" /></td>
                        <td><input type="checkbox" name="pagos_crear" /></td>
                        <td><input type="checkbox" name="pagos_editar" /></td>
                        <td><input type="checkbox" name="pagos_eliminar" /></td>
                    </tr>
                    <tr>
                        <td>Bitacora</td>
                        <td><input type="checkbox" name="bitacora_consultar" /></td>
                        <td><input type="checkbox" name="bitacora_crear" disabled /></td>
                        <td><input type="checkbox" name="bitacora_editar" disabled /></td>
                        <td><input type="checkbox" name="bitacora_eliminar" disabled /></td>
                    </tr>
                    <tr>
                        <td>Clientes</td>
                        <td><input type="checkbox" name="clientes_consultar" checked /></td>
                        <td><input type="checkbox" name="clientes_crear" checked /></td>
                        <td><input type="checkbox" name="clientes_editar" checked /></td>
                        <td><input type="checkbox" name="clientes_eliminar" /></td>
                    </tr>
                    <tr>
                        <td>Usuarios</td>
                        <td><input type="checkbox" name="usuarios_consultar" /></td>
                        <td><input type="checkbox" name="usuarios_crear" /></td>
                        <td><input type="checkbox" name="usuarios_editar" /></td>
                        <td><input type="checkbox" name="usuarios_eliminar" /></td>
                    </tr>
                    <tr>
                        <td>IA</td>
                        <td><input type="checkbox" name="ia_consultar" /></td>
                        <td><input type="checkbox" name="ia_crear" disabled /></td>
                        <td><input type="checkbox" name="ia_editar" disabled /></td>
                        <td><input type="checkbox" name="ia_eliminar" disabled /></td>
                    </tr>
                </tbody>
            </table>

            <div class="form-actions">
                <a href="@Url.Action("Roles", "Role")" class="btn-secondary">Cancelar</a>
                <button type="button" class="btn-primary" onclick="alert('Rol actualizado exitosamente (Prototipo)'); window.location.href='@Url.Action("Roles", "Role")';">Guardar Cambios</button>
            </div>
        </div>

        <!-- Advertencia -->
        <div class="alert-box alert-warning">
            <h3>Atencion</h3>
            <p>Este rol tiene 4 usuarios asignados. Los cambios de permisos se aplicaran a todos ellos la proxima vez que inicien sesion, y quedaran registrados en la Bitacora del sistema.</p>
        </div>
    </div>
</body>
</html>
