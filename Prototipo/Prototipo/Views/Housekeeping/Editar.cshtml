@{
    ViewBag.Title = "Editar Tarea de Housekeeping";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El Colibri Hotel & Steak House</title>

    <!-- Custom CSS -->
    <link href="~/Content/Site.css?v=2" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar-main">
        <div class="navbar-main-brand">
            <h2>El Colibri Hotel & Steak House</h2>
            <span class="navbar-subtitle">Sistema de Gestion</span>
        </div>
        <div class="navbar-main-user">
            <span>Admin</span>
            <a href="@Url.Action("Index", "Home")" class="btn-logout">Cerrar Sesion</a>
        </div>
    </nav>

    <!-- Menu de Modulos -->
    <nav class="modules-navbar">
        <a href="@Url.Action("Main", "Main")" class="module-link">Dashboard</a>
        <a href="@Url.Action("Habitaciones", "Habitaciones")" class="module-link">Habitaciones</a>
        <a href="@Url.Action("Reservas", "Reservas")" class="module-link">Reservas</a>
        <a href="@Url.Action("Eventos", "Eventos")" class="module-link">Eventos</a>
        <a href="@Url.Action("Inventario", "Inventario")" class="module-link">Inventario</a>
        <a href="@Url.Action("Mesas", "Mesas")" class="module-link">Punto de Venta</a>
        <a href="@Url.Action("Reportes", "Reportes")" class="module-link">Reportes</a>
        <a href="@Url.Action("Housekeeping", "Housekeeping")" class="module-link active">Housekeeping</a>
        <a href="@Url.Action("Facturacion", "Facturacion")" class="module-link">Facturacion</a>
        <a href="@Url.Action("Pagos", "Pagos")" class="module-link">Pagos</a>
        <a href="@Url.Action("Bitacora", "Bitacora")" class="module-link">Bitacora</a>
        <a href="@Url.Action("Clientes", "Clientes")" class="module-link">Clientes</a>
        <a href="@Url.Action("Usuarios", "Usuarios")" class="module-link">Usuarios</a>
        <a href="@Url.Action("IA", "IA")" class="module-link">IA</a>
    </nav>

    <!-- Contenido Principal -->
    <div class="main-content-area">
        <div class="module-header">
            <h1>Editar Tarea de Housekeeping</h1>
            <a href="@Url.Action("Housekeeping", "Housekeeping")" class="btn-secondary">Volver</a>
        </div>

        <!-- Formulario -->
        <div class="form-container">
            <form>
                <div class="form-group">
                    <label for="idTarea">ID Tarea</label>
                    <input type="text" id="idTarea" name="idTarea" class="form-control" value="1" readonly />
                </div>

                <div class="form-group">
                    <label for="tipoTarea">Tipo de Tarea</label>
                    <select id="tipoTarea" name="tipoTarea" class="form-control" required>
                        <option value="">Seleccione un tipo</option>
                        <option value="Limpieza" selected>Limpieza</option>
                        <option value="Mantenimiento">Mantenimiento</option>
                        <option value="Revision">Revision</option>
                        <option value="Reabastecimiento">Reabastecimiento</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="idHabitacion">Habitacion</label>
                    <select id="idHabitacion" name="idHabitacion" class="form-control" required>
                        <option value="">Seleccione una habitacion</option>
                        <option value="101" selected>101 - Individual</option>
                        <option value="102">102 - Familiar</option>
                        <option value="201">201 - Doble</option>
                        <option value="205">205 - Doble</option>
                        <option value="301">301 - Suite</option>
                        <option value="302">302 - Suite</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="idUsuario">Usuario Asignado</label>
                    <select id="idUsuario" name="idUsuario" class="form-control" required>
                        <option value="">Seleccione un usuario</option>
                        <option value="1" selected>Maria Rodriguez - Personal de Limpieza</option>
                        <option value="2">Carlos Sanchez - Mantenimiento</option>
                        <option value="3">Ana Martinez - Personal de Limpieza</option>
                        <option value="4">Luis Gonzalez - Personal de Limpieza</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="fechaAsignacion">Fecha de Asignacion</label>
                    <input type="datetime-local" id="fechaAsignacion" name="fechaAsignacion" class="form-control" value="2024-01-25T08:00" required />
                </div>

                <div class="form-group">
                    <label for="fechaLimite">Fecha Limite</label>
                    <input type="datetime-local" id="fechaLimite" name="fechaLimite" class="form-control" value="2024-01-25T12:00" required />
                </div>

                <div class="form-group">
                    <label for="estadoTarea">Estado de la Tarea</label>
                    <select id="estadoTarea" name="estadoTarea" class="form-control" required>
                        <option value="">Seleccione un estado</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="EnProgreso" selected>En Progreso</option>
                        <option value="Completada">Completada</option>
                        <option value="Cancelada">Cancelada</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="observaciones">Observaciones</label>
                    <textarea id="observaciones" name="observaciones" class="form-control" rows="4" placeholder="Ingrese observaciones o instrucciones especiales">Limpieza completa de la habitacion, cambio de sabanas y reabastecimiento de amenidades.</textarea>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-primary" onclick="alert('Tarea actualizada exitosamente (Prototipo)'); window.location.href='@Url.Action("Housekeeping", "Housekeeping")';">Actualizar Tarea</button>
                    <a href="@Url.Action("Housekeeping", "Housekeeping")" class="btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>

        <!-- Nota informativa -->
        <div class="info-box">
            <h3>Informacion Importante</h3>
            <ul>
                <li>El <strong>ID Tarea</strong> no puede ser modificado</li>
                <li>Cambiar el <strong>Estado</strong> a "Completada" registrara automaticamente la fecha de finalizacion</li>
                <li>Asegurese de que la <strong>Fecha Limite</strong> sea realista para la tarea asignada</li>
                <li>Los cambios se aplicaran inmediatamente al guardar</li>
            </ul>
        </div>
    </div>
</body>
</html>
