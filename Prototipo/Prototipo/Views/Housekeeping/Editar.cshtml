@using Prototipo.Common
@model Prototipo.Models.TareaHousekeeping
@{
    ViewBag.Title = "Editar Tarea";
    ViewBag.Modulo = "Housekeeping";
}

<div class="module-header">
    <h1>Editar Tarea #@Model.IdTarea</h1>
    <a href="@Url.Action("Housekeeping", "Housekeeping")" class="btn-secondary">Volver</a>
</div>

<div class="form-container">
    @using (Html.BeginForm("Editar", "Housekeeping", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.IdTarea)
        @Html.HiddenFor(m => m.FechaAsignacion)
        @Html.ValidationSummary(false, null, new { @class = "alert-box alert-warning" })

        <div class="form-group">
            @Html.LabelFor(m => m.IdHabitacion)
            @Html.DropDownListFor(m => m.IdHabitacion, (SelectList)ViewBag.Habitaciones, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.IdUsuario)
            @Html.DropDownListFor(m => m.IdUsuario, (SelectList)ViewBag.Usuarios, new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.TipoTarea)
            @Html.TextBoxFor(m => m.TipoTarea, new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.FechaLimite)
            <input type="datetime-local" name="FechaLimite" class="form-control"
                   value="@(Model.FechaLimite.HasValue ? Model.FechaLimite.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.EstadoTarea)
            @Html.DropDownListFor(m => m.EstadoTarea,
                new SelectList(Estados.Tarea.Todos, Model.EstadoTarea), new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Observaciones)
            @Html.TextBoxFor(m => m.Observaciones, new { @class = "form-control" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Guardar Cambios</button>
            <a href="@Url.Action("DetalleTarea", "Housekeeping", new { id = Model.IdTarea })" class="btn-secondary">Cancelar</a>
        </div>
    }
</div>
