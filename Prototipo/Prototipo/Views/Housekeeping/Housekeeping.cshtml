@using Prototipo.Common
@model List<Prototipo.Models.TareaHousekeeping>
@{
    ViewBag.Title = "Housekeeping";
    ViewBag.Modulo = "Housekeeping";
}

<div class="module-header">
    <h1>Gestion de Housekeeping</h1>
    <a href="@Url.Action("Crear", "Housekeeping")" class="btn-primary">Nueva Tarea</a>
</div>

<div class="filter-container">
    @using (Html.BeginForm("Housekeeping", "Housekeeping", FormMethod.Get))
    {
        <label for="estado">Estado:</label>
        <select id="estado" name="estado" class="filter-select">
            <option value="">Todos</option>
            @foreach (var estado in Estados.Tarea.Todos)
            {
                <option value="@estado" selected="@(((string)ViewBag.Estado) == estado)">@estado</option>
            }
        </select>
        <button type="submit" class="btn-primary">Filtrar</button>
    }
</div>

<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Habitacion</th>
                <th>Tipo de tarea</th>
                <th>Asignada a</th>
                <th>Asignacion</th>
                <th>Limite</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="8">No hay tareas que coincidan con el filtro.</td></tr>
            }
            @foreach (var tarea in Model)
            {
                <tr>
                    <td>@tarea.IdTarea</td>
                    <td>@tarea.Habitacion.NumeroHabitacion</td>
                    <td>@tarea.TipoTarea</td>
                    <td>@tarea.Usuario.NombreCompleto</td>
                    <td>@Formato.FechaHora(tarea.FechaAsignacion)</td>
                    <td>@Formato.FechaHora(tarea.FechaLimite)</td>
                    <td><span class="@Formato.BadgeEstado(tarea.EstadoTarea)">@tarea.EstadoTarea</span></td>
                    <td class="table-actions">
                        <a href="@Url.Action("DetalleTarea", "Housekeeping", new { id = tarea.IdTarea })" class="btn-view">Consultar</a>
                        <a href="@Url.Action("Editar", "Housekeeping", new { id = tarea.IdTarea })" class="btn-edit">Editar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
