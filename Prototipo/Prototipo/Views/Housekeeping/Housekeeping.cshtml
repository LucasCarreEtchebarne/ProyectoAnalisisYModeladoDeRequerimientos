@{
    ViewBag.Title = "Gestion de Housekeeping";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El Colibri Hotel & Steak House</title>

    <!-- Custom CSS -->
    <link href="~/Content/Site.css?v=2" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar-main">
        <div class="navbar-main-brand">
            <h2>El Colibri Hotel & Steak House</h2>
            <span class="navbar-subtitle">Sistema de Gestion</span>
        </div>
        <div class="navbar-main-user">
            <span>Admin</span>
            <a href="@Url.Action("Index", "Home")" class="btn-logout">Cerrar Sesion</a>
        </div>
    </nav>

    <!-- Menu de Modulos -->
    <nav class="modules-navbar">
        <a href="@Url.Action("Main", "Main")" class="module-link">Dashboard</a>
        <a href="@Url.Action("Habitaciones", "Habitaciones")" class="module-link">Habitaciones</a>
        <a href="@Url.Action("Reservas", "Reservas")" class="module-link">Reservas</a>
        <a href="@Url.Action("Eventos", "Eventos")" class="module-link">Eventos</a>
        <a href="@Url.Action("Inventario", "Inventario")" class="module-link">Inventario</a>
        <a href="@Url.Action("Mesas", "Mesas")" class="module-link">Punto de Venta</a>
        <a href="@Url.Action("Reportes", "Reportes")" class="module-link">Reportes</a>
        <a href="@Url.Action("Housekeeping", "Housekeeping")" class="module-link active">Housekeeping</a>
        <a href="@Url.Action("Facturacion", "Facturacion")" class="module-link">Facturacion</a>
        <a href="@Url.Action("Pagos", "Pagos")" class="module-link">Pagos</a>
        <a href="@Url.Action("Bitacora", "Bitacora")" class="module-link">Bitacora</a>
        <a href="@Url.Action("Clientes", "Clientes")" class="module-link">Clientes</a>
        <a href="@Url.Action("Usuarios", "Usuarios")" class="module-link">Usuarios</a>
        <a href="@Url.Action("IA", "IA")" class="module-link">IA</a>
    </nav>

    <!-- Contenido Principal -->
    <div class="main-content-area">
        <div class="module-header">
            <h1>Gestion de Housekeeping</h1>
            <a href="@Url.Action("Crear", "Housekeeping")" class="btn-primary">Nueva Tarea</a>
        </div>

        <!-- Filtros -->
        <div class="filter-container">
            <label for="filtroTipo">Filtrar por Tipo:</label>
            <select id="filtroTipo" class="filter-select">
                <option value="">Todos</option>
                <option value="Limpieza">Limpieza</option>
                <option value="Mantenimiento">Mantenimiento</option>
                <option value="Revision">Revision</option>
                <option value="Reabastecimiento">Reabastecimiento</option>
            </select>

            <label for="filtroEstado">Filtrar por Estado:</label>
            <select id="filtroEstado" class="filter-select">
                <option value="">Todos</option>
                <option value="Pendiente">Pendiente</option>
                <option value="EnProgreso">En Progreso</option>
                <option value="Completada">Completada</option>
                <option value="Cancelada">Cancelada</option>
            </select>
        </div>

        <!-- Tabla de tareas -->
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tipo de Tarea</th>
                        <th>Habitacion</th>
                        <th>Usuario Asignado</th>
                        <th>Fecha Asignacion</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>Limpieza</td>
                        <td>101</td>
                        <td>Maria Rodriguez</td>
                        <td>25/01/2024 08:00</td>
                        <td><span class="badge badge-enprogreso">En Progreso</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleTarea", "Housekeeping")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Housekeeping")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de eliminar esta tarea?')) alert('Tarea eliminada exitosamente (Prototipo)');">Eliminar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Mantenimiento</td>
                        <td>205</td>
                        <td>Carlos Sanchez</td>
                        <td>25/01/2024 09:30</td>
                        <td><span class="badge badge-pendiente">Pendiente</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleTarea", "Housekeeping")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Housekeeping")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de eliminar esta tarea?')) alert('Tarea eliminada exitosamente (Prototipo)');">Eliminar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>Revision</td>
                        <td>302</td>
                        <td>Ana Martinez</td>
                        <td>25/01/2024 10:00</td>
                        <td><span class="badge badge-completada">Completada</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleTarea", "Housekeeping")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Housekeeping")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de eliminar esta tarea?')) alert('Tarea eliminada exitosamente (Prototipo)');">Eliminar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td>Reabastecimiento</td>
                        <td>150</td>
                        <td>Luis Gonzalez</td>
                        <td>25/01/2024 11:15</td>
                        <td><span class="badge badge-enprogreso">En Progreso</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleTarea", "Housekeeping")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Housekeeping")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de eliminar esta tarea?')) alert('Tarea eliminada exitosamente (Prototipo)');">Eliminar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>5</td>
                        <td>Limpieza</td>
                        <td>201</td>
                        <td>Maria Rodriguez</td>
                        <td>25/01/2024 13:00</td>
                        <td><span class="badge badge-pendiente">Pendiente</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleTarea", "Housekeeping")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Housekeeping")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de eliminar esta tarea?')) alert('Tarea eliminada exitosamente (Prototipo)');">Eliminar</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
