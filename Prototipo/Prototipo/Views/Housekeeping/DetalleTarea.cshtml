@using Prototipo.Common
@model Prototipo.Models.TareaHousekeeping
@{
    ViewBag.Title = "Detalle de Tarea";
    ViewBag.Modulo = "Housekeeping";
    var estados = ViewBag.EstadosTarea as string[] ?? new string[0];
}

<div class="module-header">
    <h1>Tarea #@Model.IdTarea</h1>
    <a href="@Url.Action("Housekeeping", "Housekeeping")" class="btn-secondary">Volver</a>
</div>

<div class="detail-container">
    <div class="detail-section">
        <h3>Datos de la tarea</h3>
        <div class="detail-grid">
            <div class="detail-item"><label>Habitacion</label><span>@Model.Habitacion.NumeroHabitacion</span></div>
            <div class="detail-item"><label>Estado de la habitacion</label><span class="@Formato.BadgeEstado(Model.Habitacion.EstadoHabitacion)">@Model.Habitacion.EstadoHabitacion</span></div>
            <div class="detail-item"><label>Tipo de tarea</label><span>@Model.TipoTarea</span></div>
            <div class="detail-item"><label>Asignada a</label><span>@Model.Usuario.NombreCompleto</span></div>
            <div class="detail-item"><label>Fecha de asignacion</label><span>@Formato.FechaHora(Model.FechaAsignacion)</span></div>
            <div class="detail-item"><label>Fecha limite</label><span>@Formato.FechaHora(Model.FechaLimite)</span></div>
            <div class="detail-item"><label>Completada</label><span>@Formato.FechaHora(Model.FechaCompletada)</span></div>
            <div class="detail-item"><label>Estado</label><span class="@Formato.BadgeEstado(Model.EstadoTarea)">@Model.EstadoTarea</span></div>
            <div class="detail-item-full"><label>Observaciones</label><span>@(string.IsNullOrEmpty(Model.Observaciones) ? "-" : Model.Observaciones)</span></div>
        </div>
    </div>

    <div class="detail-section">
        <h3>Actualizar estado</h3>
        @using (Html.BeginForm("CambiarEstado", "Housekeeping", new { id = Model.IdTarea }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="form-group">
                <select name="estado" class="form-control">
                    @foreach (var estado in estados)
                    {
                        <option value="@estado" selected="@(Model.EstadoTarea == estado)">@estado</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn-primary">Aplicar</button>
        }
        <p><small>Al marcar la tarea como Completada, una habitacion en Limpieza vuelve a Disponible.</small></p>
    </div>

    <div class="form-actions">
        <a href="@Url.Action("Editar", "Housekeeping", new { id = Model.IdTarea })" class="btn-primary">Editar</a>
    </div>
</div>
