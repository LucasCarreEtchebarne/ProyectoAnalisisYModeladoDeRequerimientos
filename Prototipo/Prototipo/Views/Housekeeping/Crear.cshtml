@using Prototipo.Common
@model Prototipo.Models.TareaHousekeeping
@{
    ViewBag.Title = "Crear Tarea";
    ViewBag.Modulo = "Housekeeping";
}

<div class="module-header">
    <h1>Crear Tarea de Housekeeping</h1>
    <a href="@Url.Action("Housekeeping", "Housekeeping")" class="btn-secondary">Volver</a>
</div>

<div class="form-container">
    @using (Html.BeginForm("Crear", "Housekeeping", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, null, new { @class = "alert-box alert-warning" })

        <div class="form-group">
            @Html.LabelFor(m => m.IdHabitacion)
            @Html.DropDownListFor(m => m.IdHabitacion, (SelectList)ViewBag.Habitaciones,
                "Seleccione una habitacion", new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.IdUsuario)
            @Html.DropDownListFor(m => m.IdUsuario, (SelectList)ViewBag.Usuarios,
                "Seleccione el responsable", new { @class = "form-control", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.TipoTarea)
            @Html.TextBoxFor(m => m.TipoTarea, new { @class = "form-control", placeholder = "Limpieza general, Mantenimiento", required = "required" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.FechaLimite)
            <input type="datetime-local" name="FechaLimite" class="form-control" />
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.EstadoTarea)
            @Html.DropDownListFor(m => m.EstadoTarea,
                new SelectList(Estados.Tarea.Todos, Model.EstadoTarea), new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Observaciones)
            @Html.TextBoxFor(m => m.Observaciones, new { @class = "form-control" })
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Guardar Tarea</button>
            <a href="@Url.Action("Housekeeping", "Housekeeping")" class="btn-secondary">Cancelar</a>
        </div>
    }
</div>

<div class="info-box">
    <h3>Tareas automaticas</h3>
    <ul>
        <li>Al registrar un check-out el sistema crea la tarea de limpieza automaticamente</li>
        <li>Al completar una tarea, si la habitacion estaba en Limpieza vuelve a Disponible</li>
    </ul>
</div>
