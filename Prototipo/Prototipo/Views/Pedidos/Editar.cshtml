@{
    ViewBag.Title = "Editar Pedido";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El Colibri Hotel & Steak House</title>

    <!-- Custom CSS -->
    <link href="~/Content/Site.css?v=2" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar-main">
        <div class="navbar-main-brand">
            <h2>El Colibri Hotel & Steak House</h2>
            <span class="navbar-subtitle">Sistema de Gestion</span>
        </div>
        <div class="navbar-main-user">
            <span>Admin</span>
            <a href="@Url.Action("Index", "Home")" class="btn-logout">Cerrar Sesion</a>
        </div>
    </nav>

    <!-- Menu de Modulos -->
    <nav class="modules-navbar">
        <a href="@Url.Action("Main", "Main")" class="module-link">Dashboard</a>
        <a href="@Url.Action("Habitaciones", "Habitaciones")" class="module-link">Habitaciones</a>
        <a href="@Url.Action("Reservas", "Reservas")" class="module-link">Reservas</a>
        <a href="@Url.Action("Eventos", "Eventos")" class="module-link">Eventos</a>
        <a href="@Url.Action("Inventario", "Inventario")" class="module-link">Inventario</a>
        <a href="@Url.Action("Mesas", "Mesas")" class="module-link active">Punto de Venta</a>
        <a href="@Url.Action("Reportes", "Reportes")" class="module-link">Reportes</a>
        <a href="@Url.Action("Housekeeping", "Housekeeping")" class="module-link">Housekeeping</a>
        <a href="@Url.Action("Facturacion", "Facturacion")" class="module-link">Facturacion</a>
        <a href="@Url.Action("Pagos", "Pagos")" class="module-link">Pagos</a>
        <a href="@Url.Action("Bitacora", "Bitacora")" class="module-link">Bitacora</a>
        <a href="@Url.Action("Clientes", "Clientes")" class="module-link">Clientes</a>
        <a href="@Url.Action("Usuarios", "Usuarios")" class="module-link">Usuarios</a>
        <a href="@Url.Action("IA", "IA")" class="module-link">IA</a>
    </nav>

    <!-- Contenido Principal -->
    <div class="main-content-area">
        <div class="module-header">
            <h1>Editar Pedido #1002</h1>
        </div>

        <!-- Formulario de Edicion -->
        <div class="form-container">
            <form class="module-form" method="post" action="@Url.Action("Pedidos", "Pedidos")">
                <div class="form-row">
                    <div class="form-group">
                        <label for="origen">Origen del Pedido</label>
                        <select id="origen" name="origen" required>
                            <option value="Restaurante" selected>Restaurante</option>
                            <option value="RoomService">Room Service</option>
                            <option value="Bar">Bar</option>
                            <option value="Evento">Evento</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="mesa">Mesa / Habitacion</label>
                        <select id="mesa" name="mesa" required>
                            <option value="Mesa3" selected>Mesa 3 - Salon Principal</option>
                            <option value="Mesa1">Mesa 1 - Terraza</option>
                            <option value="Mesa7">Mesa 7 - Bar</option>
                            <option value="Hab204">Habitacion 204</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="mesero">Mesero Asignado</label>
                        <select id="mesero" name="mesero" required>
                            <option value="CarlosRamirez" selected>Carlos Ramirez</option>
                            <option value="AnaSolis">Ana Solis</option>
                            <option value="LuisMora">Luis Mora</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="comensales">Numero de Comensales</label>
                        <input type="number" id="comensales" name="comensales" value="6" required />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="estadoPedido">Estado del Pedido</label>
                        <select id="estadoPedido" name="estadoPedido" required>
                            <option value="Abierto" selected>Abierto</option>
                            <option value="EnPreparacion">En Preparacion</option>
                            <option value="Servido">Servido</option>
                            <option value="Pagado">Pagado</option>
                            <option value="Cancelado">Cancelado</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="descuento">Descuento (%)</label>
                        <input type="number" id="descuento" name="descuento" value="0" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="observaciones">Observaciones</label>
                    <textarea id="observaciones" name="observaciones" rows="4">Un comensal es alergico a los mariscos. Servir el postre despues de las 21:00.</textarea>
                </div>

                <div class="form-actions">
                    <a href="@Url.Action("Pedidos", "Pedidos")" class="btn-secondary">Cancelar</a>
                    <button type="button" class="btn-primary" onclick="alert('Pedido actualizado exitosamente (Prototipo)'); window.location.href='@Url.Action("Pedidos", "Pedidos")';">Guardar Cambios</button>
                </div>
            </form>
        </div>

        <!-- Articulos Actuales -->
        <div class="table-container">
            <h3>Articulos del Pedido</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Cantidad</th>
                        <th>Producto</th>
                        <th>Precio Unitario</th>
                        <th>Subtotal</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>2</td>
                        <td>Lomito El Colibri</td>
                        <td>$145.00</td>
                        <td>$290.00</td>
                        <td class="table-actions">
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de quitar este articulo?')) { alert('Articulo eliminado (Prototipo)'); window.location.reload(); }">Quitar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>1</td>
                        <td>Costillas BBQ</td>
                        <td>$128.00</td>
                        <td>$128.00</td>
                        <td class="table-actions">
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de quitar este articulo?')) { alert('Articulo eliminado (Prototipo)'); window.location.reload(); }">Quitar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td>Cerveza Artesanal</td>
                        <td>$18.00</td>
                        <td>$72.00</td>
                        <td class="table-actions">
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de quitar este articulo?')) { alert('Articulo eliminado (Prototipo)'); window.location.reload(); }">Quitar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Postre del Dia</td>
                        <td>$32.00</td>
                        <td>$64.00</td>
                        <td class="table-actions">
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de quitar este articulo?')) { alert('Articulo eliminado (Prototipo)'); window.location.reload(); }">Quitar</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
