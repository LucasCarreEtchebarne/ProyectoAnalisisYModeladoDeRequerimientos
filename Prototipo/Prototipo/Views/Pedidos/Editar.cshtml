@using Prototipo.Common
@model Prototipo.Models.Pedido
@{
    ViewBag.Title = "Editar Pedido";
    ViewBag.Modulo = "Pedidos";
}

<div class="module-header">
    <h1>Editar Pedido #@Model.IdPedido</h1>
    <a href="@Url.Action("DetallePedido", "Pedidos", new { id = Model.IdPedido })" class="btn-secondary">Volver</a>
</div>

<div class="form-container">
    @using (Html.BeginForm("Editar", "Pedidos", new { id = Model.IdPedido }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label for="idCliente">Cliente</label>
            @Html.DropDownList("idCliente", (SelectList)ViewBag.Clientes, "Sin cliente asociado", new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label for="observaciones">Observaciones</label>
            <input type="text" id="observaciones" name="observaciones" class="form-control" value="@Model.Observaciones" />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Guardar Cambios</button>
            <a href="@Url.Action("DetallePedido", "Pedidos", new { id = Model.IdPedido })" class="btn-secondary">Cancelar</a>
        </div>
    }
</div>

<div class="info-box">
    <h3>Que se puede editar</h3>
    <ul>
        <li>Solo el cliente asociado y las observaciones.</li>
        <li>Las lineas del pedido no se modifican: cancele el pedido y cree uno nuevo, asi el
            movimiento de inventario queda trazado correctamente.</li>
    </ul>
</div>
