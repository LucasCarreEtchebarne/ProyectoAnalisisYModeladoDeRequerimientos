@using Prototipo.Common
@model List<Prototipo.Models.Pedido>
@{
    ViewBag.Title = "Pedidos";
    ViewBag.Modulo = "Pedidos";
}

<div class="module-header">
    <h1>Gestion de Pedidos</h1>
    <a href="@Url.Action("Crear", "Pedidos")" class="btn-primary">Nuevo Pedido</a>
</div>

<div class="filter-container">
    @using (Html.BeginForm("Pedidos", "Pedidos", FormMethod.Get))
    {
        <label for="estado">Estado:</label>
        <select id="estado" name="estado" class="filter-select">
            <option value="">Todos</option>
            @foreach (var estado in Estados.Pedido.Todos)
            {
                <option value="@estado" selected="@(((string)ViewBag.Estado) == estado)">@estado</option>
            }
        </select>

        <label for="tipo">Tipo:</label>
        <select id="tipo" name="tipo" class="filter-select">
            <option value="">Todos</option>
            @foreach (var tipo in Estados.TipoPedido.Todos)
            {
                <option value="@tipo" selected="@(((string)ViewBag.Tipo) == tipo)">@tipo</option>
            }
        </select>

        <label for="desde">Desde:</label>
        <input type="date" id="desde" name="desde" class="filter-select"
               value="@(ViewBag.Desde != null ? ((DateTime)ViewBag.Desde).ToString("yyyy-MM-dd") : "")" />

        <label for="hasta">Hasta:</label>
        <input type="date" id="hasta" name="hasta" class="filter-select"
               value="@(ViewBag.Hasta != null ? ((DateTime)ViewBag.Hasta).ToString("yyyy-MM-dd") : "")" />

        <button type="submit" class="btn-primary">Filtrar</button>
    }
</div>

<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Fecha</th>
                <th>Tipo</th>
                <th>Origen</th>
                <th>Cliente</th>
                <th>Atendido por</th>
                <th>Total</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="9">No hay pedidos que coincidan con el filtro.</td></tr>
            }
            @foreach (var pedido in Model)
            {
                <tr>
                    <td>@pedido.IdPedido</td>
                    <td>@Formato.FechaHora(pedido.FechaHoraPedido)</td>
                    <td>@pedido.TipoPedido</td>
                    <td>
                        @if (pedido.Mesa != null)
                        {
                            <text>Mesa @pedido.Mesa.NumeroMesa</text>
                        }
                        else if (pedido.Habitacion != null)
                        {
                            <text>Hab. @pedido.Habitacion.NumeroHabitacion</text>
                        }
                        else
                        {
                            <text>Para llevar</text>
                        }
                    </td>
                    <td>@(pedido.Cliente != null ? pedido.Cliente.NombreMostrar : "-")</td>
                    <td>@(pedido.Usuario != null ? pedido.Usuario.NombreCompleto : "-")</td>
                    <td>@Formato.Colones(pedido.Total)</td>
                    <td><span class="@Formato.BadgeEstado(pedido.EstadoPedido)">@pedido.EstadoPedido</span></td>
                    <td class="table-actions">
                        <a href="@Url.Action("DetallePedido", "Pedidos", new { id = pedido.IdPedido })" class="btn-view">Consultar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
