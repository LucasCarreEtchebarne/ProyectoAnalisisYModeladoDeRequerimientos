@{
    ViewBag.Title = "Pedidos";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El Colibri Hotel & Steak House</title>

    <!-- Custom CSS -->
    <link href="~/Content/Site.css?v=2" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar-main">
        <div class="navbar-main-brand">
            <h2>El Colibri Hotel & Steak House</h2>
            <span class="navbar-subtitle">Sistema de Gestion</span>
        </div>
        <div class="navbar-main-user">
            <span>Admin</span>
            <a href="@Url.Action("Index", "Home")" class="btn-logout">Cerrar Sesion</a>
        </div>
    </nav>

    <!-- Menu de Modulos -->
    <nav class="modules-navbar">
        <a href="@Url.Action("Main", "Main")" class="module-link">Dashboard</a>
        <a href="@Url.Action("Habitaciones", "Habitaciones")" class="module-link">Habitaciones</a>
        <a href="@Url.Action("Reservas", "Reservas")" class="module-link">Reservas</a>
        <a href="@Url.Action("Eventos", "Eventos")" class="module-link">Eventos</a>
        <a href="@Url.Action("Inventario", "Inventario")" class="module-link">Inventario</a>
        <a href="@Url.Action("Mesas", "Mesas")" class="module-link active">Punto de Venta</a>
        <a href="@Url.Action("Reportes", "Reportes")" class="module-link">Reportes</a>
        <a href="@Url.Action("Housekeeping", "Housekeeping")" class="module-link">Housekeeping</a>
        <a href="@Url.Action("Facturacion", "Facturacion")" class="module-link">Facturacion</a>
        <a href="@Url.Action("Pagos", "Pagos")" class="module-link">Pagos</a>
        <a href="@Url.Action("Bitacora", "Bitacora")" class="module-link">Bitacora</a>
        <a href="@Url.Action("Clientes", "Clientes")" class="module-link">Clientes</a>
        <a href="@Url.Action("Usuarios", "Usuarios")" class="module-link">Usuarios</a>
        <a href="@Url.Action("IA", "IA")" class="module-link">IA</a>
    </nav>

    <!-- Contenido Principal -->
    <div class="main-content-area">
        <div class="module-header">
            <h1>Gestion de Pedidos</h1>
            <div style="display: flex; gap: 0.8rem;">
                <a href="@Url.Action("Mesas", "Mesas")" class="btn-secondary">Ver Salon</a>
                <a href="@Url.Action("Crear", "Pedidos")" class="btn-primary">Nuevo Pedido</a>
            </div>
        </div>

        <!-- Filtros -->
        <div class="form-container">
            <h3>Filtros de Busqueda</h3>
            <form class="module-form">
                <div class="form-row">
                    <div class="form-group">
                        <label for="filtroEstadoPedido">Estado del Pedido</label>
                        <select id="filtroEstadoPedido">
                            <option value="">Todos</option>
                            <option value="Abierto">Abierto</option>
                            <option value="EnPreparacion">En Preparacion</option>
                            <option value="Servido">Servido</option>
                            <option value="Pagado">Pagado</option>
                            <option value="Cancelado">Cancelado</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="filtroOrigen">Origen</label>
                        <select id="filtroOrigen">
                            <option value="">Todos</option>
                            <option value="Restaurante">Restaurante</option>
                            <option value="RoomService">Room Service</option>
                            <option value="Bar">Bar</option>
                            <option value="Evento">Evento</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="filtroFechaPedido">Fecha</label>
                        <input type="date" id="filtroFechaPedido" />
                    </div>

                    <div class="form-group">
                        <label for="filtroMesero">Mesero</label>
                        <input type="text" id="filtroMesero" placeholder="Buscar por mesero..." />
                    </div>
                </div>
            </form>
        </div>

        <!-- Tabla de Pedidos -->
        <div class="table-container">
            <h3>Pedidos Registrados</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Mesa / Habitacion</th>
                        <th>Origen</th>
                        <th>Mesero</th>
                        <th>Hora</th>
                        <th>Articulos</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1001</td>
                        <td>Mesa 2</td>
                        <td>Restaurante</td>
                        <td>Carlos Ramirez</td>
                        <td>19:05</td>
                        <td>5</td>
                        <td>$284.00</td>
                        <td><span class="badge badge-servido">Servido</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetallePedido", "Pedidos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Pedidos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de cancelar este pedido?')) { alert('Pedido cancelado (Prototipo)'); window.location.reload(); }">Cancelar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>1002</td>
