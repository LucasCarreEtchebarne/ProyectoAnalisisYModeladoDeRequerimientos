                        <td>Restaurante</td>
                        <td>Carlos Ramirez</td>
                        <td>19:15</td>
                        <td>9</td>
                        <td>$688.62</td>
                        <td><span class="badge badge-abierto">Abierto</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetallePedido", "Pedidos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Pedidos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de cancelar este pedido?')) { alert('Pedido cancelado (Prototipo)'); window.location.reload(); }">Cancelar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>1003</td>
                        <td>Habitacion 204</td>
                        <td>Room Service</td>
                        <td>Ana Solis</td>
                        <td>19:32</td>
                        <td>3</td>
                        <td>$156.00</td>
                        <td><span class="badge badge-enpreparacion">En Preparacion</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetallePedido", "Pedidos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Pedidos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de cancelar este pedido?')) { alert('Pedido cancelado (Prototipo)'); window.location.reload(); }">Cancelar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>1004</td>
                        <td>Mesa 6</td>
                        <td>Bar</td>
                        <td>Luis Mora</td>
                        <td>19:48</td>
                        <td>4</td>
                        <td>$96.50</td>
                        <td><span class="badge badge-abierto">Abierto</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetallePedido", "Pedidos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Pedidos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de cancelar este pedido?')) { alert('Pedido cancelado (Prototipo)'); window.location.reload(); }">Cancelar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>1005</td>
                        <td>Mesa 8</td>
                        <td>Restaurante</td>
                        <td>Ana Solis</td>
                        <td>20:02</td>
                        <td>7</td>
                        <td>$430.25</td>
                        <td><span class="badge badge-enpreparacion">En Preparacion</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetallePedido", "Pedidos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Pedidos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de cancelar este pedido?')) { alert('Pedido cancelado (Prototipo)'); window.location.reload(); }">Cancelar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>1006</td>
                        <td>Mesa 1</td>
                        <td>Restaurante</td>
                        <td>Luis Mora</td>
                        <td>18:20</td>
                        <td>6</td>
                        <td>$318.00</td>
                        <td><span class="badge badge-pagado">Pagado</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetallePedido", "Pedidos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Pedidos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de cancelar este pedido?')) { alert('Pedido cancelado (Prototipo)'); window.location.reload(); }">Cancelar</button>
                        </td>
                    </tr>
                    <tr>
                        <td>1007</td>
                        <td>Salon Privado</td>
                        <td>Evento</td>
                        <td>Carlos Ramirez</td>
                        <td>17:45</td>
                        <td>24</td>
                        <td>$1,280.00</td>
                        <td><span class="badge badge-pagado">Pagado</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetallePedido", "Pedidos")" class="btn-view">Consultar</a>
                            <a href="@Url.Action("Editar", "Pedidos")" class="btn-edit">Editar</a>
                            <button class="btn-delete" onclick="if(confirm('Esta seguro de cancelar este pedido?')) { alert('Pedido cancelado (Prototipo)'); window.location.reload(); }">Cancelar</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
