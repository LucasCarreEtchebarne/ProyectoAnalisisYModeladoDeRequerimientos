@using Prototipo.Common
@model Prototipo.Models.Pedido
@{
    ViewBag.Title = "Detalle de Pedido";
    ViewBag.Modulo = "Pedidos";
}

<div class="module-header">
    <h1>Pedido #@Model.IdPedido</h1>
    <a href="@Url.Action("Pedidos", "Pedidos")" class="btn-secondary">Volver</a>
</div>

<div class="detail-container">
    <div class="detail-section">
        <h3>Datos del pedido</h3>
        <div class="detail-grid">
            <div class="detail-item"><label>Fecha y hora</label><span>@Formato.FechaHora(Model.FechaHoraPedido)</span></div>
            <div class="detail-item"><label>Tipo</label><span>@Model.TipoPedido</span></div>
            <div class="detail-item">
                <label>Origen</label>
                <span>
                    @if (Model.Mesa != null)
                    {
                        <text>Mesa @Model.Mesa.NumeroMesa</text>
                    }
                    else if (Model.Habitacion != null)
                    {
                        <text>Habitacion @Model.Habitacion.NumeroHabitacion</text>
                    }
                    else
                    {
                        <text>Para llevar</text>
                    }
                </span>
            </div>
            <div class="detail-item"><label>Cliente</label><span>@(Model.Cliente != null ? Model.Cliente.NombreMostrar : "-")</span></div>
            <div class="detail-item"><label>Atendido por</label><span>@(Model.Usuario != null ? Model.Usuario.NombreCompleto : "-")</span></div>
            <div class="detail-item"><label>Estado</label><span class="@Formato.BadgeEstado(Model.EstadoPedido)">@Model.EstadoPedido</span></div>
            <div class="detail-item-full"><label>Observaciones</label><span>@(string.IsNullOrEmpty(Model.Observaciones) ? "-" : Model.Observaciones)</span></div>
        </div>
    </div>

    <div class="detail-section">
        <h3>Detalle</h3>
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio unitario</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var linea in Model.Detalles)
                    {
                        <tr>
                            <td>@linea.ProductoMenu.NombreProducto</td>
                            <td>@linea.Cantidad</td>
                            <td>@Formato.Colones(linea.PrecioUnitario)</td>
                            <td>@Formato.Colones(linea.Subtotal)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="totales-box">
            <div class="totales-row"><strong>Total:</strong> <strong>@Formato.Colones(Model.Total)</strong></div>
        </div>
    </div>

    <div class="form-actions">
        @if (Model.EstadoPedido == Estados.Pedido.Pendiente)
        {
            using (Html.BeginForm("Confirmar", "Pedidos", new { id = Model.IdPedido }, FormMethod.Post, new { style = "display:inline" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-primary"
                        onclick="return confirm('Al confirmar se descuenta el stock de los insumos. Continuar?');">
                    Confirmar y descontar stock
                </button>
            }

            <a href="@Url.Action("Editar", "Pedidos", new { id = Model.IdPedido })" class="btn-edit">Editar</a>
        }

        @if (Model.EstadoPedido == Estados.Pedido.Confirmado)
        {
            using (Html.BeginForm("Entregar", "Pedidos", new { id = Model.IdPedido }, FormMethod.Post, new { style = "display:inline" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-primary">Marcar como entregado</button>
            }
        }

        @if (Model.EstadoPedido != Estados.Pedido.Cancelado)
        {
            using (Html.BeginForm("Cancelar", "Pedidos", new { id = Model.IdPedido }, FormMethod.Post, new { style = "display:inline" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-delete"
                        onclick="return confirm('Cancelar el pedido? Si ya estaba confirmado se devuelven los insumos al inventario.');">
                    Cancelar pedido
                </button>
            }

            <a href="@Url.Action("Crear", "Facturacion")" class="btn-secondary">Facturar</a>
        }
    </div>
</div>
