@{
    ViewBag.Title = "Nuevo Pedido";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - El Colibri Hotel & Steak House</title>

    <!-- Custom CSS -->
    <link href="~/Content/Site.css?v=2" rel="stylesheet" type="text/css" />
</head>
<body>
    <!-- Navbar Principal -->
    <nav class="navbar-main">
        <div class="navbar-main-brand">
            <h2>El Colibri Hotel & Steak House</h2>
            <span class="navbar-subtitle">Sistema de Gestion</span>
        </div>
        <div class="navbar-main-user">
            <span>Admin</span>
            <a href="@Url.Action("Index", "Home")" class="btn-logout">Cerrar Sesion</a>
        </div>
    </nav>

    <!-- Menu de Modulos -->
    <nav class="modules-navbar">
        <a href="@Url.Action("Main", "Main")" class="module-link">Dashboard</a>
        <a href="@Url.Action("Habitaciones", "Habitaciones")" class="module-link">Habitaciones</a>
        <a href="@Url.Action("Reservas", "Reservas")" class="module-link">Reservas</a>
        <a href="@Url.Action("Eventos", "Eventos")" class="module-link">Eventos</a>
        <a href="@Url.Action("Inventario", "Inventario")" class="module-link">Inventario</a>
        <a href="@Url.Action("Mesas", "Mesas")" class="module-link active">Punto de Venta</a>
        <a href="@Url.Action("Reportes", "Reportes")" class="module-link">Reportes</a>
        <a href="@Url.Action("Housekeeping", "Housekeeping")" class="module-link">Housekeeping</a>
        <a href="@Url.Action("Facturacion", "Facturacion")" class="module-link">Facturacion</a>
        <a href="@Url.Action("Pagos", "Pagos")" class="module-link">Pagos</a>
        <a href="@Url.Action("Bitacora", "Bitacora")" class="module-link">Bitacora</a>
        <a href="@Url.Action("Clientes", "Clientes")" class="module-link">Clientes</a>
        <a href="@Url.Action("Usuarios", "Usuarios")" class="module-link">Usuarios</a>
        <a href="@Url.Action("IA", "IA")" class="module-link">IA</a>
    </nav>

    <!-- Contenido Principal -->
    <div class="main-content-area">
        <div class="module-header">
            <h1>Nuevo Pedido</h1>
        </div>

        <!-- Formulario de Creacion -->
        <div class="form-container">
            <form class="module-form" method="post" action="@Url.Action("Pedidos", "Pedidos")">
                <div class="form-row">
                    <div class="form-group">
                        <label for="origen">Origen del Pedido</label>
                        <select id="origen" name="origen" required>
                            <option value="">Seleccione un origen...</option>
                            <option value="Restaurante">Restaurante</option>
                            <option value="RoomService">Room Service</option>
                            <option value="Bar">Bar</option>
                            <option value="Evento">Evento</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="mesa">Mesa / Habitacion</label>
                        <select id="mesa" name="mesa" required>
                            <option value="">Seleccione una ubicacion...</option>
                            <option value="Mesa1">Mesa 1 - Terraza</option>
                            <option value="Mesa4">Mesa 4 - Salon Principal</option>
                            <option value="Mesa7">Mesa 7 - Bar</option>
                            <option value="Hab204">Habitacion 204</option>
                            <option value="SalonPrivado">Salon Privado</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="mesero">Mesero Asignado</label>
                        <select id="mesero" name="mesero" required>
                            <option value="">Seleccione un mesero...</option>
                            <option value="CarlosRamirez">Carlos Ramirez</option>
                            <option value="AnaSolis">Ana Solis</option>
                            <option value="LuisMora">Luis Mora</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="comensales">Numero de Comensales</label>
                        <input type="number" id="comensales" name="comensales" placeholder="Ej: 4" required />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="producto">Producto</label>
                        <select id="producto" name="producto">
                            <option value="">Seleccione un producto...</option>
                            <option value="Lomito">Lomito El Colibri - $145.00</option>
                            <option value="Costillas">Costillas BBQ - $128.00</option>
                            <option value="Pescado">Pescado a la Plancha - $118.00</option>
                            <option value="Ensalada">Ensalada Cesar - $62.00</option>
                            <option value="Cerveza">Cerveza Artesanal - $18.00</option>
                            <option value="Postre">Postre del Dia - $32.00</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="cantidad">Cantidad</label>
                        <input type="number" id="cantidad" name="cantidad" placeholder="Ej: 2" />
                    </div>
                </div>

                <div class="form-actions" style="justify-content: flex-start;">
                    <button type="button" class="btn-secondary" onclick="alert('Producto agregado al pedido (Prototipo)');">Agregar Producto</button>
                </div>

                <div class="form-group">
                    <label for="observaciones">Observaciones</label>
                    <textarea id="observaciones" name="observaciones" rows="4" placeholder="Alergias, preferencias de coccion, indicaciones especiales..."></textarea>
                </div>

                <div class="form-actions">
                    <a href="@Url.Action("Mesas", "Mesas")" class="btn-secondary">Cancelar</a>
                    <button type="button" class="btn-primary" onclick="alert('Pedido creado exitosamente (Prototipo)'); window.location.href='@Url.Action("Pedidos", "Pedidos")';">Guardar Pedido</button>
                </div>
            </form>
        </div>

        <!-- Info adicional -->
        <div class="info-box">
            <h3>Informacion</h3>
            <ul>
                <li><strong>Origen:</strong> Define desde donde se levanta el pedido y como se cobrara</li>
                <li><strong>Room Service:</strong> El consumo se carga automaticamente a la cuenta de la habitacion</li>
                <li><strong>Comensales:</strong> Se usa para calcular el cargo por servicio y estadisticas del salon</li>
                <li><strong>Observaciones:</strong> Notas visibles para cocina y para el mesero asignado</li>
            </ul>
        </div>
    </div>
</body>
</html>
