@using Prototipo.Common
@model Prototipo.ViewModels.PedidoFormViewModel
@{
    ViewBag.Title = "Crear Pedido";
    ViewBag.Modulo = "Pedidos";
}

<div class="module-header">
    <h1>Nuevo Pedido</h1>
    <a href="@Url.Action("Pedidos", "Pedidos")" class="btn-secondary">Volver</a>
</div>

<div class="form-container">
    @using (Html.BeginForm("Crear", "Pedidos", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, null, new { @class = "alert-box alert-warning" })

        <div class="form-group">
            @Html.LabelFor(m => m.TipoPedido)
            @Html.DropDownListFor(m => m.TipoPedido,
                new SelectList(Estados.TipoPedido.Todos, Model.TipoPedido), new { @class = "form-control" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.IdMesa)
            <select name="IdMesa" class="form-control">
                <option value="">Sin mesa</option>
                @foreach (var mesa in Model.Mesas)
                {
                    <option value="@mesa.IdMesa" selected="@(Model.IdMesa == mesa.IdMesa)">
                        Mesa @mesa.NumeroMesa (@mesa.Capacidad pax - @mesa.EstadoMesa)
                    </option>
                }
            </select>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.IdHabitacion)
            <select name="IdHabitacion" class="form-control">
                <option value="">Sin habitacion</option>
                @foreach (var habitacion in Model.HabitacionesOcupadas)
                {
                    <option value="@habitacion.IdHabitacion" selected="@(Model.IdHabitacion == habitacion.IdHabitacion)">
                        Habitacion @habitacion.NumeroHabitacion
                    </option>
                }
            </select>
            <small>Solo aparecen habitaciones con una reserva en check-in.</small>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.IdCliente)
            <select name="IdCliente" class="form-control">
                <option value="">Sin cliente asociado</option>
                @foreach (var cliente in Model.Clientes)
                {
                    <option value="@cliente.IdCliente" selected="@(Model.IdCliente == cliente.IdCliente)">
                        @cliente.NombreMostrar
                    </option>
                }
            </select>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Observaciones)
            @Html.TextBoxFor(m => m.Observaciones, new { @class = "form-control" })
        </div>

        <h3>Productos del menu</h3>
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoria</th>
                        <th>Precio</th>
                        <th>Cantidad</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Menu.Count; i++)
                    {
                        var producto = Model.Menu[i];
                        <tr>
                            <td>@producto.NombreProducto</td>
                            <td>@producto.CategoriaMenu</td>
                            <td>@Formato.Colones(producto.Precio)</td>
                            <td>
                                <input type="hidden" name="Lineas[@i].IdProductoMenu" value="@producto.IdProductoMenu" />
                                <input type="number" name="Lineas[@i].Cantidad" value="0" min="0" max="99" class="form-control" style="width:90px" />
                            </td>
                        </tr>
                    }
                    @if (Model.Menu.Count == 0)
                    {
                        <tr><td colspan="4">No hay productos disponibles en el menu.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">Guardar Pedido</button>
            <a href="@Url.Action("Pedidos", "Pedidos")" class="btn-secondary">Cancelar</a>
        </div>
    }
</div>

<div class="info-box">
    <h3>Como sigue el flujo</h3>
    <ul>
        <li>El pedido se guarda en estado <strong>Pendiente</strong>: todavia no toca el inventario</li>
        <li>Al <strong>confirmar</strong> se descuenta el stock segun la receta de cada producto</li>
        <li>Si falta algun insumo, el sistema bloquea la confirmacion completa</li>
        <li>El precio unitario se copia del menu y no cambia despues</li>
    </ul>
</div>
