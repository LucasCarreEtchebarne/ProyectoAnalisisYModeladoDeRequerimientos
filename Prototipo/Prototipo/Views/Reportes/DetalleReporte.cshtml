@using Prototipo.Common
@model Prototipo.ViewModels.ReporteViewModel
@{
    ViewBag.Title = "Detalle del Reporte";
    ViewBag.Modulo = "Reportes";
}

<div class="module-header">
    <h1>@Model.Titulo</h1>
    <a href="@Url.Action("Reportes", "Reportes")" class="btn-secondary">Volver</a>
</div>

<div class="detail-section">
    <p>Periodo: @Formato.Fecha(Model.Desde) al @Formato.Fecha(Model.Hasta)</p>

    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    @foreach (var encabezado in Model.Encabezados)
                    {
                        <th>@encabezado</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Filas.Count == 0)
                {
                    <tr><td colspan="@(Model.Encabezados.Count == 0 ? 1 : Model.Encabezados.Count)">No hay datos para el periodo seleccionado.</td></tr>
                }
                @foreach (var fila in Model.Filas)
                {
                    <tr>
                        @foreach (var celda in fila)
                        {
                            <td>@celda</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!string.IsNullOrEmpty(Model.Resumen))
    {
        <div class="totales-box">
            <div class="totales-row"><strong>@Model.Resumen</strong></div>
        </div>
    }
</div>
