@using Prototipo.Common
@model Prototipo.ViewModels.ReporteViewModel
@{
    ViewBag.Title = "Generar Reporte";
    ViewBag.Modulo = "Reportes";
    var tipos = ViewBag.Tipos as Dictionary<string, string> ?? Prototipo.ViewModels.ReporteViewModel.Tipos;
}

<div class="module-header">
    <h1>@(string.IsNullOrEmpty(Model.Tipo) ? "Generar Reporte" : Model.Titulo)</h1>
    <a href="@Url.Action("Reportes", "Reportes")" class="btn-secondary">Volver</a>
</div>

<div class="filter-container">
    @using (Html.BeginForm("Generar", "Reportes", FormMethod.Get))
    {
        <label for="tipo">Reporte:</label>
        <select id="tipo" name="tipo" class="filter-select" required>
            <option value="">Seleccione</option>
            @foreach (var tipo in tipos)
            {
                <option value="@tipo.Key" selected="@(Model.Tipo == tipo.Key)">@tipo.Value</option>
            }
        </select>

        <label for="desde">Desde:</label>
        <input type="date" id="desde" name="desde" class="filter-select" value="@Model.Desde.ToString("yyyy-MM-dd")" />

        <label for="hasta">Hasta:</label>
        <input type="date" id="hasta" name="hasta" class="filter-select" value="@Model.Hasta.ToString("yyyy-MM-dd")" />

        <button type="submit" class="btn-primary">Generar</button>
    }
</div>

@if (!string.IsNullOrEmpty(Model.Tipo) && Model.Encabezados.Count > 0)
{
    <div class="detail-section">
        <p>
            Periodo: @Formato.Fecha(Model.Desde) al @Formato.Fecha(Model.Hasta)
            &mdash; @Model.Filas.Count fila(s)
        </p>

        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        @foreach (var encabezado in Model.Encabezados)
                        {
                            <th>@encabezado</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Filas.Count == 0)
                    {
                        <tr><td colspan="@Model.Encabezados.Count">No hay datos para el periodo seleccionado.</td></tr>
                    }
                    @foreach (var fila in Model.Filas)
                    {
                        <tr>
                            @foreach (var celda in fila)
                            {
                                <td>@celda</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!string.IsNullOrEmpty(Model.Resumen))
        {
            <div class="totales-box">
                <div class="totales-row"><strong>@Model.Resumen</strong></div>
            </div>
        }
    </div>
}
else if (!string.IsNullOrEmpty(Model.Resumen))
{
    <div class="alert-box">@Model.Resumen</div>
}
