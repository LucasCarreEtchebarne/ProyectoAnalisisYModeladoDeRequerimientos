@using Prototipo.Common
@model Dictionary<string, string>
@{
    ViewBag.Title = "Reportes";
    ViewBag.Modulo = "Reportes";
    var dashboard = ViewBag.Dashboard as Prototipo.ViewModels.DashboardViewModel;
}

<div class="module-header">
    <h1>Reportes</h1>
    <a href="@Url.Action("Generar", "Reportes")" class="btn-primary">Generar reporte</a>
</div>

@if (dashboard != null)
{
    <div class="dashboard-grid">
        <div class="dashboard-card">
            <h3>@dashboard.PorcentajeOcupacion %</h3>
            <p>Ocupacion actual</p>
        </div>
        <div class="dashboard-card">
            <h3>@Formato.Colones(dashboard.IngresosMes)</h3>
            <p>Ingresos del mes</p>
        </div>
        <div class="dashboard-card">
            <h3>@Formato.Colones(dashboard.MontoPorCobrar)</h3>
            <p>Pendiente de cobro</p>
        </div>
        <div class="dashboard-card">
            <h3>@dashboard.AlertasStock.Count</h3>
            <p>Productos bajo minimo</p>
        </div>
    </div>
}

<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>Reporte</th>
                <th>Que muestra</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tipo in Model)
            {
                <tr>
                    <td>@tipo.Value</td>
                    <td>
                        @switch (tipo.Key)
                        {
                            case "ingresos":
                                <text>Pagos aprobados agrupados por dia y metodo de pago</text>
                                break;
                            case "ocupacion":
                                <text>Reservas, noches vendidas e ingreso de hospedaje por habitacion</text>
                                break;
                            case "consumo":
                                <text>Productos del menu mas vendidos y su venta total</text>
                                break;
                            case "inventario":
                                <text>Stock actual contra el minimo de cada producto</text>
                                break;
                            case "clientes":
                                <text>Clientes ordenados por monto facturado</text>
                                break;
                        }
                    </td>
                    <td class="table-actions">
                        <a href="@Url.Action("Generar", "Reportes", new { tipo = tipo.Key })" class="btn-view">Generar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
