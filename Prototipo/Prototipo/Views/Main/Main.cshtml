@using Prototipo.Common
@model Prototipo.ViewModels.DashboardViewModel
@{
    ViewBag.Title = "Dashboard";
    ViewBag.Modulo = "Dashboard";
}

<div class="content-header">
    <h1>Bienvenido al Sistema de Gestion</h1>
    <p>Indicadores en tiempo real sobre la base HotelColibri</p>
</div>

<div class="dashboard-grid">
    <div class="dashboard-card">
        <h3>@Model.HabitacionesDisponibles</h3>
        <p>Habitaciones disponibles</p>
    </div>
    <div class="dashboard-card">
        <h3>@Model.HabitacionesOcupadas</h3>
        <p>Habitaciones ocupadas (@Model.PorcentajeOcupacion %)</p>
    </div>
    <div class="dashboard-card">
        <h3>@Model.LlegadasHoy</h3>
        <p>Llegadas de hoy</p>
    </div>
    <div class="dashboard-card">
        <h3>@Model.SalidasHoy</h3>
        <p>Salidas de hoy</p>
    </div>
    <div class="dashboard-card">
        <h3>@Model.PedidosHoy</h3>
        <p>Pedidos de hoy</p>
    </div>
    <div class="dashboard-card">
        <h3>@Formato.Colones(Model.IngresosHoy)</h3>
        <p>Ingresos de hoy</p>
    </div>
    <div class="dashboard-card">
        <h3>@Formato.Colones(Model.IngresosMes)</h3>
        <p>Ingresos del mes</p>
    </div>
    <div class="dashboard-card">
        <h3>@Formato.Colones(Model.MontoPorCobrar)</h3>
        <p>@Model.FacturasPendientes factura(s) por cobrar</p>
    </div>
    <div class="dashboard-card">
        <h3>@Model.TareasPendientes</h3>
        <p>Tareas de housekeeping abiertas</p>
    </div>
    <div class="dashboard-card">
        <h3>@Model.EventosProximos</h3>
        <p>Eventos programados</p>
    </div>
</div>

@if (Model.AlertasStock.Count > 0)
{
    <div class="alert-box alert-warning">
        <strong>Inventario bajo minimo:</strong>
        @string.Join(", ", Model.AlertasStock.Select(p => p.NombreProducto + " (" + p.Stock + " " + p.UnidadMedida + ")"))
    </div>
}

<div class="detail-section">
    <h3>Proximas llegadas</h3>
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Habitacion</th>
                    <th>Entrada</th>
                    <th>Salida</th>
                    <th>Huespedes</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ProximasLlegadas.Count == 0)
                {
                    <tr><td colspan="7">No hay llegadas programadas.</td></tr>
                }
                @foreach (var reserva in Model.ProximasLlegadas)
                {
                    <tr>
                        <td>@reserva.Cliente.NombreMostrar</td>
                        <td>@reserva.Habitacion.NumeroHabitacion</td>
                        <td>@Formato.Fecha(reserva.FechaEntrada)</td>
                        <td>@Formato.Fecha(reserva.FechaSalida)</td>
                        <td>@reserva.CantidadHuespedes</td>
                        <td><span class="@Formato.BadgeEstado(reserva.EstadoReserva)">@reserva.EstadoReserva</span></td>
                        <td class="table-actions">
                            <a href="@Url.Action("DetalleReserva", "Reservas", new { id = reserva.IdReserva })" class="btn-view">Consultar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
